<UserControl x:Class="FleetMate.GUI.Views.Tickets.TicketTasksPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             Visibility="Collapsed">
    <!-- The ticket's tasks: a count in the header, every task with its type,
         progress and who it is with, and for the selected task its details,
         an update form (progress 0–100 and a comment, sent only on Save or
         Complete) and its activity. Standard tasks can also be edited and
         deleted; workflow tasks and maintenance activities only updated. -->
    <StackPanel Margin="0,12,0,0">
        <Separator Margin="0,0,0,8" />
        <Expander x:Name="TasksExpander" Expanded="OnExpanderToggled" Collapsed="OnExpanderToggled"
                  AutomationProperties.Name="Tasks">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TasksHeaderText" Text="Tasks" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    <ui:ProgressRing x:Name="LoadProgress" IsActive="False" Visibility="Collapsed" Width="14" Height="14"
                                     Margin="8,0,0,0" />
                </StackPanel>
            </Expander.Header>

            <StackPanel Margin="0,6,0,0">
                <WrapPanel Margin="0,0,0,6">
                    <Button x:Name="AddTaskButton" Click="OnAddTaskClicked" Padding="8,3" Margin="0,0,6,0"
                            ToolTip="Add a standard task to this ticket" AutomationProperties.Name="Add a task">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Add Task" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ApplyTemplateButton" Click="OnApplyTemplateClicked" Padding="8,3" Margin="0,0,6,0"
                            ToolTip="Add the tasks of a task template" AutomationProperties.Name="Apply a task template">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Apply Template" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshButton" Click="OnRefreshClicked" Padding="6,3"
                            ToolTip="Refresh the tasks" AutomationProperties.Name="Refresh the tasks">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </WrapPanel>

                <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,6"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                <ListBox x:Name="TasksList" SelectionChanged="OnTaskSelectionChanged" BorderThickness="0"
                         Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Tasks on this ticket">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontSize="12"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <Border DockPanel.Dock="Right" Padding="5,1" CornerRadius="4" Margin="8,0,0,0"
                                                VerticalAlignment="Center" Visibility="{Binding TypeBadgeVisibility}"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                ToolTip="{Binding TypeTooltip}">
                                            <TextBlock Text="{Binding TypeLabel}" FontSize="11" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Minimum="0" Maximum="100" Height="4"
                                                 Margin="0,4,0,4" IsTabStop="False" />
                                    <TextBlock FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                                        <Run Text="{Binding State, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Responsibility, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- The selected task -->
                <Border x:Name="DetailBorder" Visibility="Collapsed" Padding="10" Margin="0,4,0,6" CornerRadius="6"
                        BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundAccentBrush}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="EditTaskButton" Click="OnEditTaskClicked" Padding="6,2" Margin="4,0,0,0"
                                        ToolTip="Edit this task" AutomationProperties.Name="Edit this task">
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70F;" FontSize="12" />
                                </Button>
                                <Button x:Name="DeleteTaskButton" Click="OnDeleteTaskClicked" Padding="6,2" Margin="4,0,0,0"
                                        ToolTip="Delete this task" AutomationProperties.Name="Delete this task">
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="DetailTitleText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock x:Name="DetailTypeText" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock x:Name="DetailStateText" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="DetailResponsibleText" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock x:Name="DetailDatesText" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock x:Name="DetailEffortText" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock x:Name="DetailPredecessorText" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock x:Name="DetailDescriptionText" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="DetailRestrictionText" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                        <!-- Update: progress and/or a comment, through the task feed -->
                        <TextBlock Text="Update" FontWeight="SemiBold" FontSize="13" Margin="0,10,0,4" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <TextBox x:Name="PercentBox" DockPanel.Dock="Right" Width="56" TextAlignment="Right"
                                     TextChanged="OnPercentTextChanged" AutomationProperties.Name="Percent complete, 0 to 100" />
                            <Slider x:Name="PercentSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                    IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                    ValueChanged="OnPercentSliderChanged" AutomationProperties.Name="Percent complete" />
                        </DockPanel>
                        <TextBox x:Name="UpdateCommentBox" AcceptsReturn="True" Height="56" TextWrapping="Wrap" FontSize="13"
                                 Margin="0,6,0,0" ui:ControlHelper.PlaceholderText="Comment (optional)"
                                 PreviewKeyDown="OnUpdateCommentKeyDown"
                                 AutomationProperties.Name="Comment for the task update" />
                        <DockPanel Margin="0,6,0,0">
                            <CheckBox x:Name="UpdatePrivateBox" Content="Private" DockPanel.Dock="Left" FontSize="13" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:ProgressRing x:Name="SubmitProgress" IsActive="False" Visibility="Collapsed"
                                                 Width="16" Height="16" Margin="0,0,8,0" />
                                <Button x:Name="SaveProgressButton" Content="Save" Click="OnSaveProgressClicked" Margin="0,0,8,0"
                                        ToolTip="Save the progress and comment (Ctrl+Enter)" />
                                <Button x:Name="CompleteButton" Content="Complete" Click="OnCompleteClicked"
                                        Style="{DynamicResource AccentButtonStyle}" ToolTip="Set the task to 100% complete" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Activity -->
                        <DockPanel Margin="0,10,0,4">
                            <ui:ProgressRing x:Name="FeedProgress" DockPanel.Dock="Right" IsActive="False" Visibility="Collapsed"
                                             Width="14" Height="14" />
                            <TextBlock x:Name="FeedHeaderText" Text="Activity" FontWeight="SemiBold" FontSize="13" />
                        </DockPanel>
                        <TextBlock x:Name="FeedMessageText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <ItemsControl x:Name="FeedList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding Author}" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding When}" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                            <TextBlock Text="  · Private" FontSize="11" VerticalAlignment="Center"
                                                       Visibility="{Binding PrivateVisibility}"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Body}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <ItemsControl ItemsSource="{Binding Replies}" Margin="16,4,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,4">
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding Author}" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding When}" FontSize="11"
                                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Body}" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="ResultBorder" Visibility="Collapsed" Padding="8" Margin="0,0,0,6" CornerRadius="4">
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="13" Foreground="Black" />
                </Border>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
