<Window x:Class="FleetMate.GUI.Views.Tickets.ApplyTaskTemplateDialog"
        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Apply Task Template"
        SizeToContent="Height" Width="520" MinWidth="420"
        WindowStartupLocation="CenterOwner">

    <!-- The templates are the ones TeamDynamix's own Add Task Template page
         offers for this ticket, read again just before applying. -->
    <StackPanel Margin="24">
        <TextBlock x:Name="HeadingText" Text="Apply Task Template" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"
                   TextWrapping="Wrap" />

        <DockPanel Margin="0,0,0,4">
            <Button x:Name="ReloadButton" DockPanel.Dock="Right" Padding="6,2" Click="OnReload"
                    ToolTip="Read the template list again" AutomationProperties.Name="Read the template list again">
                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="12" />
            </Button>
            <ui:ProgressRing x:Name="LoadProgress" DockPanel.Dock="Right" IsActive="False" Visibility="Collapsed"
                             Width="16" Height="16" Margin="0,0,8,0" />
            <TextBlock Text="Template" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <ComboBox x:Name="TemplateCombo" HorizontalAlignment="Stretch" IsEnabled="False"
                  SelectionChanged="OnSelectionChanged" AutomationProperties.Name="Task template" />
        <TextBlock x:Name="CatalogText" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

        <TextBlock Text="Schedule the tasks from" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ComboBox x:Name="StartDateCombo" HorizontalAlignment="Stretch" Margin="0,0,0,12"
                  DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="Schedule the tasks from" />

        <CheckBox x:Name="RemoveExistingBox" Content="Remove the ticket's existing tasks first" IsChecked="False"
                  Checked="OnRemoveChanged" Unchecked="OnRemoveChanged" />
        <TextBlock x:Name="RemoveWarning" FontSize="12" TextWrapping="Wrap" Margin="24,4,0,0" Visibility="Collapsed"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   Text="Removed tasks cannot be restored. TeamDynamix only removes them if you are allowed to delete tasks; otherwise they are kept." />

        <DockPanel Margin="0,20,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" Margin="0,0,8,0" MinWidth="80" IsCancel="True" />
                <Button x:Name="ApplyButton" Content="Apply" Click="OnApply" IsEnabled="False"
                        Style="{DynamicResource AccentButtonStyle}" MinWidth="100" />
            </StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </DockPanel>
    </StackPanel>
</Window>
