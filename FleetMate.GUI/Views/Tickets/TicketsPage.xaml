<Page x:Class="FleetMate.GUI.Views.Tickets.TicketsPage"
      Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:shared="clr-namespace:FleetMate.GUI.Views.Shared"
      xmlns:tickets="clr-namespace:FleetMate.GUI.Views.Tickets"
      xmlns:widgets="clr-namespace:FleetMate.GUI.Views.Shared.Widgets">

    <!-- Widgets sit above the page; the DockPanel keeps the page's own grid untouched. -->
    <DockPanel>
    <!-- Sign-in needs attention: silent renewal keeps failing and no usable
         token is left. Shown over the page even while tickets are listed
         from the cache, so it is clear they are not current. -->
    <Border x:Name="SignInBanner" DockPanel.Dock="Top" Visibility="Collapsed" Margin="16,14,16,0"
            Padding="12,8" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            AutomationProperties.Name="TeamDynamix sign-in needs attention">
        <DockPanel>
            <Button x:Name="SignInBannerButton" DockPanel.Dock="Right" Content="Sign In" Margin="12,0,0,0"
                    VerticalAlignment="Center" Style="{DynamicResource AccentButtonStyle}" Click="OnSsoLoginClicked"
                    ToolTip="Sign in again. A sign-in window opens only if the automatic sign-in cannot finish." />
            <ui:FontIcon DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons" Glyph="&#xE7BA;" FontSize="18"
                         Margin="0,0,10,0" VerticalAlignment="Center" Foreground="Orange" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="TeamDynamix sign-in needs attention" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="SignInBannerDetail" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Text="Your TeamDynamix session has expired and signing in again in the background did not work. Tickets will not update until you sign in." />
            </StackPanel>
        </DockPanel>
    </Border>
    <widgets:WidgetsSection x:Name="TicketWidgetsSection" DockPanel.Dock="Top" Tab="Tickets" Margin="16,14,16,0" />
    <Grid Margin="16,14,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- One toolbar row, in the Mac's order: the view's own controls
             (board grouping, sort), then what narrows the list (Clear
             Filters, Assigned to Me, and one Filters button whose popover
             holds every category, the created-date window and Show Closed),
             then the actions, with the count at the right edge. Inbox | List |
             Board are lifted into the title bar. When the window narrows the
             button labels drop to icons, as the Mac's do. -->
        <Grid x:Name="TicketsToolbar" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10"
              SizeChanged="OnToolbarSizeChanged">
            <Grid.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Inbox, then List | Board, as on Mac (ViewModePill): lifted together
                     into the window's title bar after Back and Forward (IChromeToolbar). -->
                <StackPanel x:Name="ViewModeChrome" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The envelope opens the cached inbox without changing List or Board. -->
                    <Grid x:Name="InboxButtonHost" Margin="0,0,10,0" VerticalAlignment="Center">
                        <ToggleButton x:Name="InboxButton" Width="32" Height="32"
                                     MinWidth="0" MinHeight="0" Padding="0"
                                     Click="OnInboxButtonClicked" Cursor="Hand"
                                     ToolTip="Inbox: comments from the last 90 days that notified you (Ctrl+Alt+3)"
                                     AutomationProperties.Name="Inbox">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome" CornerRadius="8" BorderThickness="1" Background="Transparent"
                                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                        <ui:FontIcon x:Name="Icon" FontFamily="Segoe Fluent Icons" Glyph="&#xE715;" FontSize="15"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
                                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <!-- The standard red count badge, hidden at zero. -->
                        <Border x:Name="InboxBadge" Visibility="Collapsed" IsHitTestVisible="False"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0"
                                MinWidth="17" Height="17" Padding="4,0" CornerRadius="8.5" Background="#FFC42B1C">
                            <TextBlock x:Name="InboxBadgeText" Foreground="White" FontSize="10.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <Border Height="32" Margin="0,0,12,0" CornerRadius="8" Padding="2" VerticalAlignment="Center"
                            BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ListViewRadio" Content="List" GroupName="ViewMode" Padding="11,0"
                                         Checked="OnViewModeChanged" Style="{StaticResource NavigationTabStyle}" />
                            <RadioButton x:Name="BoardViewRadio" Content="Board" IsChecked="True" GroupName="ViewMode" Padding="11,0"
                                         Checked="OnViewModeChanged" Style="{StaticResource NavigationTabStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Board column dimension, mirroring the macOS BoardGroupBy
                     options; shown only on the board, as on Mac. -->
                <ComboBox x:Name="BoardGroupComboBox" Width="130" Margin="0,0,8,0" ToolTip="Group board columns by"
                          AutomationProperties.Name="Group board columns by"
                          SelectionChanged="OnBoardGroupChanged">
                    <ComboBoxItem Content="Status" />
                    <ComboBoxItem Content="Responsible" IsSelected="True" />
                    <ComboBoxItem Content="Priority" />
                    <ComboBoxItem Content="Group" />
                </ComboBox>

                <!-- Sort field and direction: shown on the board only. In List
                     view the column headers sort, as on Mac, and they read and
                     write the same _sortField / _sortAscending through SetTicketSort. -->
                <StackPanel x:Name="SortControls" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="SortComboBox" Width="120" Margin="0,0,4,0" ToolTip="Sort by"
                              AutomationProperties.Name="Sort by" SelectionChanged="OnSortChanged">
                        <ComboBoxItem Content="Modified" IsSelected="True" />
                        <ComboBoxItem Content="Created" />
                        <ComboBoxItem Content="ID" />
                        <ComboBoxItem Content="Age" />
                        <ComboBoxItem Content="Title" />
                        <ComboBoxItem Content="Status" />
                        <ComboBoxItem Content="Priority" />
                        <ComboBoxItem Content="Requestor" />
                        <ComboBoxItem Content="Responsible" />
                    </ComboBox>
                    <!-- An arrow beside three bars that grow or shrink with it:
                         the usual sort-ascending / sort-descending picture. -->
                    <Button x:Name="SortDirectionButton" Width="32" Padding="0" Margin="0,0,8,0" Click="OnSortDirectionClicked"
                            ToolTip="Sorted descending. Click to sort ascending."
                            AutomationProperties.Name="Sort direction" AutomationProperties.ItemStatus="Descending">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:FontIcon x:Name="SortDirectionIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE74B;" FontSize="12"
                                         VerticalAlignment="Center" />
                            <StackPanel Margin="2,0,0,0" VerticalAlignment="Center">
                                <Rectangle x:Name="SortBarTop" Height="1.5" Width="9" Margin="0,1" HorizontalAlignment="Left"
                                           Fill="{Binding Foreground, ElementName=SortDirectionIcon}" />
                                <Rectangle x:Name="SortBarMiddle" Height="1.5" Width="6.5" Margin="0,1" HorizontalAlignment="Left"
                                           Fill="{Binding Foreground, ElementName=SortDirectionIcon}" />
                                <Rectangle x:Name="SortBarBottom" Height="1.5" Width="4" Margin="0,1" HorizontalAlignment="Left"
                                           Fill="{Binding Foreground, ElementName=SortDirectionIcon}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Clear Filters shows while any filter is on, as on Mac. -->
                <Button x:Name="ClearFiltersButton" Width="32" Padding="0" Margin="0,0,8,0" Visibility="Collapsed"
                        Click="OnClearFiltersClicked" ToolTip="Clear every filter"
                        AutomationProperties.Name="Clear Filters">
                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="12" VerticalAlignment="Center" />
                </Button>
                <!-- Assigned to Me narrows the list to tickets the signed-in TDX
                     person is responsible for; the choice is remembered. As on
                     Mac, on reads as a filled person in the accent colour over a
                     faint accent tint, never an accent fill that hides the label. -->
                <ToggleButton x:Name="AssignedToMeToggle" Margin="0,0,8,0" IsEnabled="False"
                              ToolTip="Waiting to identify you in TeamDynamix"
                              AutomationProperties.Name="Assigned to Me"
                              Checked="OnAssignedToMeChanged" Unchecked="OnAssignedToMeChanged">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Chrome" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1"
                                    Background="{DynamicResource ButtonBackground}" BorderBrush="{DynamicResource ButtonBorderBrush}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="Presenter" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{DynamicResource ButtonForeground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonBackgroundPressed}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
                                    <Setter TargetName="Presenter" Property="TextElement.Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="True" />
                                        <Condition Property="IsMouseOver" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SystemControlHighlightListAccentMediumBrush}" />
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center">
                            <ui:FontIcon.Style>
                                <Style TargetType="ui:FontIcon">
                                    <Setter Property="Glyph" Value="&#xE77B;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=AssignedToMeToggle}" Value="True">
                                            <Setter Property="Glyph" Value="&#xEA8C;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:FontIcon.Style>
                        </ui:FontIcon>
                        <TextBlock x:Name="AssignedToMeLabel" Text="Assigned to Me" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <!-- The Filters button and the actions after it, packed left. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <!-- One Filters button opens every filter in a popover, as on
                     Mac (FilterPanelView). The badge counts what is on: each
                     picked value, Show Closed, and a date window other than
                     the current term. -->
                <Button x:Name="FiltersButton" Margin="0,0,8,0" Click="OnFiltersButtonClicked"
                        ToolTip="Filter the tickets" AutomationProperties.Name="Filters">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71C;" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock x:Name="FiltersLabel" Text="Filters" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <Border x:Name="FiltersBadge" Visibility="Collapsed" Margin="6,0,0,0" MinWidth="18" Height="18" Padding="5,0"
                                CornerRadius="9" VerticalAlignment="Center" Background="{DynamicResource SystemControlHighlightAccentBrush}">
                            <TextBlock x:Name="FiltersBadgeText" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Button>

                <!-- The Filters popover. Focus moves in when it opens, Tab
                     stays inside it, and Esc or a click outside closes it. -->
                <Popup x:Name="FiltersPopup" PlacementTarget="{Binding ElementName=FiltersButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       Opened="OnFiltersPopupOpened" Closed="OnFiltersPopupClosed">
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Width="480" Height="360" Margin="0,4,8,8"
                            TextElement.Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                            KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                            AutomationProperties.Name="Filters" PreviewKeyDown="OnFiltersPopoverKeyDown">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                        </Border.Effect>
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="14,8,10,8">
                                <Button x:Name="FiltersClearAllButton" DockPanel.Dock="Right" Content="Clear All" Visibility="Collapsed"
                                        FontWeight="SemiBold" Click="OnFiltersClearAllClicked"
                                        ToolTip="Clear every filter and go back to the current term"
                                        AutomationProperties.Name="Clear all filters" />
                                <TextBlock Text="Filters" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <Rectangle DockPanel.Dock="Top" Height="1" Fill="{DynamicResource CardBorderBrush}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Categories, each with a count of what is picked in it. -->
                                <ListBox x:Name="FilterSectionsList" Grid.Column="0" Padding="4,6" BorderThickness="0"
                                         Background="Transparent" AutomationProperties.Name="Filter categories"
                                         SelectionChanged="OnFilterSectionChanged" />
                                <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource CardBorderBrush}" />

                                <!-- The chosen category's values, searchable, each a checkbox. -->
                                <DockPanel x:Name="FilterValuesPanel" Grid.Column="2">
                                    <TextBox x:Name="FilterValueSearchBox" DockPanel.Dock="Top" Margin="8"
                                             ui:ControlHelper.PlaceholderText="Search..."
                                             AutomationProperties.Name="Search values"
                                             TextChanged="OnFilterValueSearchChanged" />
                                    <TextBlock x:Name="FilterNoValuesText" DockPanel.Dock="Top" Text="No matching values" Margin="12,4"
                                               Visibility="Collapsed" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <StackPanel x:Name="FilterValuesList" Margin="12,0,8,8" />
                                    </ScrollViewer>
                                </DockPanel>

                                <!-- Time Period: the created-date window, same presets
                                     as macOS, and Show Closed. Up to 5000 tickets load
                                     per window, so there is no separate limit. -->
                                <StackPanel x:Name="FilterTimePeriodPanel" Grid.Column="2" Margin="12" Visibility="Collapsed">
                                    <TextBlock Text="Tickets created in" Margin="0,0,0,6"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <ComboBox x:Name="DateRangeComboBox" HorizontalAlignment="Stretch"
                                              ToolTip="Tickets created in" AutomationProperties.Name="Tickets created in"
                                              DisplayMemberPath="Label" SelectionChanged="OnDateRangeChanged" />
                                    <CheckBox x:Name="ShowClosedCheckBox" Content="Show Closed" IsChecked="False" Margin="0,12,0,0"
                                              MinWidth="0" AutomationProperties.Name="Show Closed"
                                              Checked="OnShowClosedChanged" Unchecked="OnShowClosedChanged" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Popup>

                <TextBox x:Name="SearchBox" Visibility="Collapsed" Width="160" ui:ControlHelper.PlaceholderText="Search..." TextChanged="OnSearchChanged" />

                <Button x:Name="DetailPanelButton" Margin="0,0,8,0" Click="OnToggleDetailPanel"
                        ToolTip="Show or hide the ticket details" AutomationProperties.Name="Details">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE89F;" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock x:Name="DetailPanelLabel" Text="Details" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="NewTicketButton" Margin="0,0,8,0" Click="OnNewTicketClicked"
                        ToolTip="Create a ticket" AutomationProperties.Name="New Ticket">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock x:Name="NewTicketLabel" Text="New Ticket" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="RefreshButton" Click="OnRefreshClicked"
                        ToolTip="Reload the tickets" AutomationProperties.Name="Refresh">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock x:Name="RefreshLabel" Text="Refresh" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Sign In appears only when silent sign-in failed; a signed-in
                 user needs no indicator, since the tickets loading says it. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TicketCountText" Text="0 of 0" VerticalAlignment="Center" Margin="4,0,0,0"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <Button x:Name="SsoLoginButton" Content="Sign In" Margin="8,0,0,0"
                        ToolTip="Sign in to TeamDynamix. A sign-in window opens if the automatic sign-in cannot finish." Click="OnSsoLoginClicked" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!-- Row 1 held a second filter row; everything now sits on the one
             toolbar row above, so this row is empty and takes no height. -->

        <!-- Main Content -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListPanelColumn" Width="*" MinWidth="480" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="DetailPanelColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Drag handle between the ticket list and the detail panel. Only
                 shown while the panel is open. The panel opens at half the
                 width and keeps whatever share the operator drags it to. -->
            <GridSplitter x:Name="DetailPanelSplitter" Grid.Column="1" Width="6" Margin="5,0"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Visibility="Collapsed" />

            <!-- Ticket List View -->
            <Border x:Name="ListViewPanel" Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <!-- Loading indicator -->
                    <!-- Over an empty list only. During the launch sign-in, a
                         determinate bar with the current step; otherwise a ring.
                         Nothing here is clickable: sign-in is automatic. -->
                    <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing x:Name="LoadingRing" IsActive="True" Width="40" Height="40" />
                        <ProgressBar x:Name="SignInProgressBar" Width="280" Height="4" Minimum="0" Maximum="1"
                                     IsIndeterminate="False" Visibility="Collapsed" />
                        <TextBlock x:Name="LoadingText" Text="Loading tickets..." Margin="0,8,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>

                    <!-- Not configured message -->
                    <TextBlock x:Name="NotConfiguredText" Visibility="Collapsed"
                               Text="Add the TeamDynamix endpoint in Settings. FleetMate signs in silently as your Windows user."
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" />

                    <!-- Tickets table: the macOS app's columns, widths and
                         order. Headers sort (the toolbar's sort state is the
                         one source of truth), columns resize and reorder, and
                         the layout is kept between launches; see
                         TicketsPage.ListTable.cs. Rows stay virtualized so a
                         queue of thousands scrolls freely. -->
                    <ListView x:Name="TicketsListView"
                              AlternationCount="2"
                              BorderThickness="0"
                              SelectionMode="Single"
                              AutomationProperties.Name="Tickets"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              SelectionChanged="OnTicketSelectionChanged">
                        <!-- Rows, stripes and selection are the shared ones in
                             Views/Shared/ListRows.xaml. The padding is the row
                             chrome TicketsPage.ListTable.cs allows for when it
                             fits the columns to the pane. -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource FleetListViewItemStyle}">
                                <Setter Property="MinHeight" Value="28" />
                                <Setter Property="Padding" Value="2,0" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding SpokenName}" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView AllowsColumnReorder="True">
                                <!-- Header content is a TicketColumnHeader: its title
                                     and, on the sorted column, a chevron. -->
                                <GridView.ColumnHeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SortGlyph}" Margin="4,0,0,0" VerticalAlignment="Center"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridView.ColumnHeaderTemplate>

                                <GridViewColumn Header="ID" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Children indent under their parent; leaves keep
                                                 the triangle's space so the numbers line up. -->
                                            <StackPanel Orientation="Horizontal" Margin="{Binding TableIndent}">
                                                <Button Content="{Binding TriangleGlyph}"
                                                        Visibility="{Binding TriangleVisibility}"
                                                        ToolTip="{Binding DisclosureName}"
                                                        AutomationProperties.Name="{Binding DisclosureName}"
                                                        Tag="{Binding}" Click="OnToggleTicketFold"
                                                        Focusable="False"
                                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                        Width="14" Height="16" MinWidth="0" MinHeight="0" Padding="0" Margin="0,0,2,0"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent" BorderThickness="0" />
                                                <TextBlock Text="{Binding IdLabel}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Title" Width="500">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Title, TargetNullValue=-}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <!-- Child-count badge on a parent, as on Mac. -->
                                                <Border DockPanel.Dock="Left" Visibility="{Binding ChildBadgeVisibility}"
                                                        Margin="6,0,0,0" Padding="5,0" CornerRadius="7" MinWidth="16" Height="15"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                        ToolTip="{Binding ChildCountTooltip}">
                                                    <TextBlock Text="{Binding ChildCountLabel}" FontSize="10" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                </Border>
                                            </DockPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Status" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,5,0" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StatusName, TargetNullValue=-}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Priority" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PriorityName, TargetNullValue=-}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Requestor" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RequestorName, TargetNullValue=-}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Responsible" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ResponsibleFullName, TargetNullValue=-}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Age" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AgeLabel}" FontFamily="Cascadia Mono, Consolas" ToolTip="Days since opened">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                        <Style.Triggers>
                                                            <!-- Two weeks or older reads as waiting, as on Mac. -->
                                                            <DataTrigger Binding="{Binding IsAgeHighlighted}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFA040" />
                                                            </DataTrigger>
                                                            <!-- On the accent fill of a focused selection the
                                                                 age reads in the row's white, as on Mac. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True" />
                                                                    <Condition Binding="{Binding (Selector.IsSelectionActive), RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Foreground" Value="{DynamicResource FleetRowSelectedForegroundBrush}" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Modified" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ModifiedLabel}" FontSize="11" TextTrimming="CharacterEllipsis" Opacity="0.72" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Created" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CreatedLabel}" FontSize="11" TextTrimming="CharacterEllipsis" Opacity="0.72" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
            
            <Popup x:Name="InboxPopup" Placement="Bottom" HorizontalOffset="-2" VerticalOffset="6"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                   Opened="OnInboxPopupOpened" Closed="OnInboxPopupClosed">
                <Border x:Name="InboxPopover" Width="560" Height="620" Padding="14" CornerRadius="12"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                        KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="OnInboxPopupKeyDown">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="InboxMarkAllReadButton" Content="Mark all read" Margin="0,0,8,0" Click="OnInboxMarkAllReadClicked" />
                            <Button x:Name="InboxRefreshButton" Click="OnInboxRefreshClicked" ToolTip="Scan for new comments now">
                                <StackPanel Orientation="Horizontal"><ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="Refresh" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button Margin="6,0,0,0" Width="28" MinWidth="0" Padding="0" Click="OnInboxCloseClicked"
                                    ToolTip="Close inbox" AutomationProperties.Name="Close inbox">
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="Inbox" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ui:ProgressRing x:Name="InboxProgressRing" IsActive="False" Width="14" Height="14" Margin="0,0,8,0" Visibility="Collapsed" />
                            <TextBlock Grid.Column="1" x:Name="InboxStatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </Grid>
                    <Grid>
                        <TextBlock x:Name="InboxEmptyText" Visibility="Collapsed" Margin="24" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <ListView x:Name="InboxListView" SelectionMode="Single"
                                  ItemContainerStyle="{StaticResource FleetListViewItemStyle}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  PreviewMouseLeftButtonUp="OnInboxItemClicked" KeyDown="OnInboxItemsKeyDown">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4,6">
                                        <Grid DockPanel.Dock="Left" Width="8" Margin="0,6,10,0" VerticalAlignment="Top">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SystemControlHighlightAccentBrush}"
                                                     Visibility="{Binding UnreadVisibility}" />
                                        </Grid>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding FormattedDate}" FontSize="11" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                <TextBlock Text="{Binding Heading}" FontWeight="{Binding HeadingWeight}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Byline}" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                            <TextBlock Text="{Binding Preview}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap" MaxHeight="34" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </DockPanel>
                </Border>
            </Popup>

            <!-- Kanban Board View -->
            <ScrollViewer x:Name="BoardViewPanel" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <!-- Blocks of columns. Responsible mode draws one block per
                     responsible group (groupless tickets in a trailing "No Group"
                     block, as on macOS); other modes are one headerless block. -->
                <ItemsControl x:Name="BoardColumnsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{Binding BlockMargin}">
                                <Rectangle Visibility="{Binding HeaderVisibility}" RadiusX="12" RadiusY="12"
                                           Stroke="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                           StrokeThickness="1.5" StrokeDashArray="4 3" />
                                <DockPanel Margin="{Binding BlockPadding}">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,8"
                                                Visibility="{Binding HeaderVisibility}">
                                        <TextBlock Text="{Binding Header}" FontWeight="Bold" FontSize="13" />
                                        <TextBlock Text="{Binding Count}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Bottom"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Columns}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                            <Border Background="{DynamicResource SubtleFillBrush}"
                                    CornerRadius="12" Width="280" Margin="0,0,16,0" VerticalAlignment="Top"
                                    AllowDrop="True" Drop="OnBoardColumnDrop" DragOver="OnBoardColumnDragOver"
                                    Tag="{Binding StatusName}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Column Header -->
                                    <!-- Neutral, as on Mac: a small dot (the status colour when
                                         grouping by status, grey otherwise), the name and a count. -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10,12,4">
                                        <Ellipse Width="10" Height="10" Fill="{Binding HeaderColor}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding StatusName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                        <TextBlock Text="{Binding Count, StringFormat='({0})'}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </StackPanel>
                                    
                                    <!-- Cards -->
                                    <!-- No fixed cap: the column fills the board's height and scrolls internally. -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                                            Padding="10" CornerRadius="6" Margin="{Binding CardIndentMargin}"
                                                            MouseLeftButtonUp="OnBoardCardClick" Cursor="Hand"
                                                            PreviewMouseLeftButtonDown="OnBoardCardPreviewMouseDown"
                                                            MouseMove="OnBoardCardMouseMove"
                                                            Focusable="True" KeyboardNavigation.IsTabStop="True"
                                                            KeyDown="OnBoardCardKeyDown"
                                                            AutomationProperties.Name="{Binding Title}"
                                                            Tag="{Binding Id}">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.2" />
                                                        </Border.Effect>
                                                        <StackPanel>
                                                            <!-- ID, fold control and Priority -->
                                                            <DockPanel Margin="0,0,0,4">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding PriorityName}" FontSize="10"
                                                                           Padding="6,2" Background="#20808080" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                                <Button DockPanel.Dock="Left" Content="{Binding TriangleGlyph}"
                                                                        Visibility="{Binding TriangleVisibility}"
                                                                        ToolTip="{Binding ChildCountTooltip}"
                                                                        Tag="{Binding}" Click="OnToggleTicketFold"
                                                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                                        Width="14" Height="14" Padding="0" Margin="0,0,4,0"
                                                                        VerticalAlignment="Center"
                                                                        Background="Transparent" BorderThickness="0" />
                                                                <TextBlock Text="{Binding Id, StringFormat='#{0}'}" FontSize="11"
                                                                           Foreground="{DynamicResource SystemControlForegroundAccentBrush}" FontWeight="Medium" />
                                                            </DockPanel>
                                                            
                                                            <!-- Title -->
                                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium" 
                                                                       TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                                                            
                                                            <!-- Requestor and Group -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE77B;" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding RequestorName}" FontSize="10" 
                                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                                            </StackPanel>
                                                            
                                                            <!-- Responsible -->
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="→" FontSize="10" Margin="0,0,4,0" Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                                                                <TextBlock Text="{Binding ResponsibleFullName}" FontSize="10" 
                                                                           Foreground="{DynamicResource SystemControlForegroundAccentBrush}" 
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Why the list or board is empty: not signed in, a failed load,
                 the search, Assigned to Me or the filters. Each offers the way
                 back, rather than a bare empty list. -->
            <Border x:Name="EmptyStatePanel" Grid.Column="0" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <ui:FontIcon x:Name="EmptyStateIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE721;" FontSize="32"
                                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <TextBlock x:Name="EmptyStateTitle" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="EmptyStateDescription" Margin="0,6,0,0" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button x:Name="EmptyStateSignInButton" Content="Sign In" Margin="4,0" Click="OnSsoLoginClicked"
                                Style="{DynamicResource AccentButtonStyle}" />
                        <Button x:Name="EmptyStateRetryButton" Content="Try Again" Margin="4,0" Click="OnEmptyStateRetryClicked" />
                        <Button x:Name="EmptyStateShowAllButton" Content="Show All Tickets" Margin="4,0" Click="OnEmptyStateShowAllClicked" />
                        <Button x:Name="EmptyStateClearFiltersButton" Content="Clear Filters" Margin="4,0" Click="OnEmptyStateClearFiltersClicked" />
                        <Button x:Name="EmptyStateShowClosedButton" Content="Show Closed" Margin="4,0" Click="OnEmptyStateShowClosedClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Detail Panel -->
            <Border x:Name="DetailPanel" Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Panel Header, laid out like the macOS detail header: on the
                         left a chevron that closes the pane, the ticket number (click
                         to copy), copy-link and open-in-browser; on the right Discard
                         and Save while fields hold unsaved picks, then the ticket
                         actions. The actions keep their labels: when the number row
                         is too narrow for them they move to their own row under it,
                         and drop to icons only when even that row is too narrow.
                         The title sits on the line below, then a divider. -->
                    <StackPanel Grid.Row="0" Margin="12,12,12,0">
                        <Grid x:Name="DetailHeaderRow" SizeChanged="OnDetailHeaderSizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="DetailIdentityPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                                        SizeChanged="OnDetailHeaderSizeChanged">
                                <Button x:Name="CloseDetailButton" Click="OnCloseDetailPanel" ToolTip="Close the ticket (Esc)"
                                        AutomationProperties.Name="Close the ticket"
                                        Style="{StaticResource ChromeIconButtonStyle}" MinWidth="0" Padding="2,5,6,5">
                                    <ui:FontIcon Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </Button>
                                <Button x:Name="CopyTicketIdButton" Click="OnCopyTicketIdClicked"
                                        ToolTip="Copy ticket number" AutomationProperties.Name="Copy ticket number"
                                        Style="{StaticResource ChromeIconButtonStyle}" Padding="0,2,6,2">
                                    <TextBlock x:Name="DetailTicketIdText" FontWeight="Bold" FontSize="18"
                                               Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                                </Button>
                                <Button x:Name="CopyTicketLinkButton" Click="OnCopyTicketLinkClicked"
                                        ToolTip="Copy ticket link" AutomationProperties.Name="Copy ticket link"
                                        Style="{StaticResource ChromeIconButtonStyle}">
                                    <ui:FontIcon Glyph="&#xE71B;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                                </Button>
                                <Button x:Name="OpenInWebButton" Click="OnOpenInWebClicked"
                                        ToolTip="Open ticket in web browser" AutomationProperties.Name="Open ticket in web browser"
                                        Style="{StaticResource ChromeIconButtonStyle}">
                                    <ui:FontIcon Glyph="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                                </Button>
                                <shared:AgentContextButton x:Name="AgentButton" Style="{StaticResource ChromeIconButtonStyle}" />
                            </StackPanel>

                            <!-- Unsaved field picks: Discard and Save, as on the Mac. -->
                            <StackPanel x:Name="DetailEditButtonsPanel" Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,4,0"
                                        AutomationProperties.Name="Unsaved changes">
                                <ui:ProgressRing x:Name="DetailSaveProgress" IsActive="False" Visibility="Collapsed"
                                                 Width="14" Height="14" Margin="0,0,6,0" />
                                <Button x:Name="DiscardEditsButton" Click="OnDiscardEditsClicked" Content="Discard"
                                        Height="30" MinHeight="0" MinWidth="0" Padding="10,0" Margin="6,2,0,2" FontSize="12"
                                        ToolTip="Discard changes" AutomationProperties.Name="Discard changes" />
                                <Button x:Name="SaveEditsButton" Click="OnSaveEditsClicked"
                                        Style="{DynamicResource AccentButtonStyle}"
                                        Height="30" MinHeight="0" MinWidth="0" Padding="10,0" Margin="6,2,0,2" FontSize="12"
                                        ToolTip="Save changes (Ctrl+Enter)" AutomationProperties.Name="Save changes">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:FontIcon Glyph="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Save" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="DetailActionsPanel" Grid.Column="3" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" ClipToBounds="True"
                                        AutomationProperties.Name="Ticket actions">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Padding" Value="10,0" />
                                        <Setter Property="Height" Value="30" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="Margin" Value="6,2,0,2" />
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </StackPanel.Resources>
                                <Button x:Name="AssignToMeButton" Click="OnAssignToMeClicked" ToolTip="Make me the responsible"
                                        AutomationProperties.Name="Assign to me">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:FontIcon Glyph="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Assign to me" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ReassignButton" Click="OnReassignClicked" ToolTip="Reassign to someone else"
                                        AutomationProperties.Name="Reassign">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:FontIcon Glyph="&#xE716;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Reassign" VerticalAlignment="Center" />
                                        <ui:FontIcon Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="9" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="UnassignButton" Click="OnUnassignClicked" ToolTip="Clear the responsible person"
                                        AutomationProperties.Name="Unassign">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:FontIcon Glyph="&#xE8F8;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Unassign" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SetParentButton" Click="OnSetParentClicked" ToolTip="Set or clear this ticket's parent"
                                        AutomationProperties.Name="Set Parent">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:FontIcon Glyph="&#xE74A;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Set Parent" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CreateParentButton" Click="OnCreateParentClicked" ToolTip="Create a new ticket and make it this ticket's parent"
                                        AutomationProperties.Name="Create Parent">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Create Parent" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnRefreshDetailClicked" ToolTip="Refresh this ticket" AutomationProperties.Name="Refresh">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="DetailTitleText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Separator Margin="0,8,0,0" />

                        <!-- Reassign popover, anchored to its button. The candidates
                             are TDX's eligible assignments for the ticketing
                             application, people and groups, the same list its web
                             Responsible picker offers. Up/Down move, Enter picks,
                             Esc or a click outside closes. -->
                        <Popup x:Name="ReassignPopup" PlacementTarget="{Binding ElementName=ReassignButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               Opened="OnReassignPopupOpened">
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Width="340" Margin="0,4,8,8"
                                    TextElement.Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Reassign Ticket" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                                    <DockPanel>
                                        <ui:ProgressRing x:Name="ReassignProgress" DockPanel.Dock="Right" IsActive="False" Visibility="Collapsed"
                                                         Width="14" Height="14" Margin="6,0,0,0" />
                                        <TextBox x:Name="ReassignSearchBox" ui:ControlHelper.PlaceholderText="Search people and groups"
                                                 AutomationProperties.Name="Search people and groups who can own this ticket"
                                                 TextChanged="OnReassignSearchChanged" PreviewKeyDown="OnReassignSearchKeyDown" />
                                    </DockPanel>
                                    <TextBlock x:Name="ReassignStatusText" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               Text="Type at least 2 letters of a name, email or group." />
                                    <ListBox x:Name="ReassignResultsList" MaxHeight="240" Margin="0,6,0,0"
                                             BorderThickness="0" Background="Transparent"
                                             AutomationProperties.Name="Candidates"
                                             MouseLeftButtonUp="OnReassignResultPicked" KeyDown="OnReassignResultsKeyDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2" AutomationProperties.Name="{Binding SpokenName}">
                                                    <ui:FontIcon DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons" Glyph="{Binding Glyph}" FontSize="14"
                                                                 Width="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <ui:FontIcon DockPanel.Dock="Right" FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" FontSize="12"
                                                                 Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding CurrentVisibility}"
                                                                 ToolTip="Current responsible" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Separator Margin="0,8,0,6" />
                                    <CheckBox x:Name="ReassignNotifyCheckBox" Content="Notify new responsible" IsChecked="True" FontSize="13"
                                              Checked="OnReassignNotifyChanged" Unchecked="OnReassignNotifyChanged"
                                              ToolTip="Email the new responsible when the change is saved" />
                                    <TextBlock FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               Text="Lists the people and groups that can be responsible for tickets in this application. TeamDynamix returns up to five matches per search." />
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Create Parent popover: a title; the new ticket copies this one's queue fields. -->
                        <Popup x:Name="CreateParentPopup" PlacementTarget="{Binding ElementName=CreateParentButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               Opened="OnCreateParentPopupOpened">
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Width="320" Margin="0,4,8,8"
                                    TextElement.Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Create Parent Ticket" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                                    <TextBlock Text="A new ticket with this one's type, account, requestor and owners, set as its parent."
                                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <TextBox x:Name="ParentTitleBox" ui:ControlHelper.PlaceholderText="Parent title"
                                             PreviewKeyDown="OnParentTitleKeyDown" />
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Content="Create Parent" Click="OnCreateParentConfirmed"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        <TextBlock x:Name="CreateParentHintText" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Set Parent popover: a ticket number, or empty to clear. -->
                        <Popup x:Name="SetParentPopup" PlacementTarget="{Binding ElementName=SetParentButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               Opened="OnSetParentPopupOpened">
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Width="260" Margin="0,4,8,8"
                                    TextElement.Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Parent ticket" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                                    <TextBox x:Name="ParentIdBox" ui:ControlHelper.PlaceholderText="Ticket number, or empty to clear"
                                             PreviewKeyDown="OnParentIdKeyDown" />
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Content="Set Parent" Click="OnSetParentConfirmed"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        <TextBlock x:Name="SetParentHintText" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <!-- Detail Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel x:Name="DetailContent" Margin="12,0,12,12" Visibility="Collapsed" Grid.IsSharedSizeScope="True">
                            <!-- Fields, as on the Mac: two equal columns filling the width.
                                 Left, the ticket's own fields, each a picker that changes the
                                 ticket as soon as a new value is chosen; right, the people on it
                                 and its timestamps. Labels carry no colons. -->
                            <Grid Margin="0,8,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Setter Property="Height" Value="30" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="DisplayMemberPath" Value="Value" />
                                        <Setter Property="SelectedValuePath" Value="Key" />
                                    </Style>
                                    <Style x:Key="DetailLabel" TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="0,0,12,0" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </Style>
                                    <Style x:Key="DetailValue" TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </Grid.Resources>

                                <Grid Grid.Column="0" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" MinHeight="36" />
                                        <RowDefinition Height="Auto" MinHeight="36" />
                                        <RowDefinition Height="Auto" MinHeight="36" />
                                        <RowDefinition Height="Auto" MinHeight="36" />
                                        <RowDefinition Height="Auto" MinHeight="36" />
                                        <RowDefinition Height="Auto" MinHeight="36" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Status" Style="{StaticResource DetailLabel}" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="DetailStatusCombo" AutomationProperties.Name="Status"
                                              SelectionChanged="OnDetailFieldChanged" Tag="StatusID" />
                                    <TextBlock Grid.Row="1" Text="Priority" Style="{StaticResource DetailLabel}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DetailPriorityCombo" AutomationProperties.Name="Priority"
                                              SelectionChanged="OnDetailFieldChanged" Tag="PriorityID" />
                                    <TextBlock Grid.Row="2" Text="Classification" Style="{StaticResource DetailLabel}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DetailClassificationCombo" AutomationProperties.Name="Classification"
                                              SelectionChanged="OnDetailFieldChanged" Tag="Classification" />
                                    <TextBlock Grid.Row="3" Text="Form" Style="{StaticResource DetailLabel}" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="DetailFormCombo" AutomationProperties.Name="Form"
                                              SelectionChanged="OnDetailFieldChanged" Tag="FormID" />
                                    <TextBlock Grid.Row="4" Text="Service" Style="{StaticResource DetailLabel}" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="DetailServiceCombo" AutomationProperties.Name="Service"
                                              SelectionChanged="OnDetailFieldChanged" Tag="ServiceID" />
                                    <TextBlock Grid.Row="5" Text="Type" Style="{StaticResource DetailLabel}" />
                                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="DetailTypeCombo" AutomationProperties.Name="Type"
                                              SelectionChanged="OnDetailFieldChanged" Tag="TypeID" />
                                </Grid>

                                <Grid Grid.Column="2" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" MinHeight="36" />
                                        <RowDefinition Height="Auto" MinHeight="36" />
                                        <RowDefinition Height="Auto" MinHeight="36" />
                                        <RowDefinition Height="Auto" MinHeight="36" />
                                        <RowDefinition Height="Auto" MinHeight="36" />
                                        <RowDefinition Height="Auto" MinHeight="36" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Requestor" Style="{StaticResource DetailLabel}" />
                                    <DockPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                        <Button x:Name="ChangeRequestorButton" DockPanel.Dock="Left" Click="OnChangeRequestorClicked"
                                                Padding="6,3" MinHeight="0" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                                ToolTip="Change the requestor" AutomationProperties.Name="Change the requestor">
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70F;" FontSize="12" />
                                        </Button>
                                        <TextBlock x:Name="DetailRequestorText" Style="{StaticResource DetailValue}" />
                                    </DockPanel>
                                    <!-- Change requestor: an anchored people search. Up/Down move,
                                         Enter picks, Esc or a click outside closes. -->
                                    <Popup x:Name="RequestorPopup" PlacementTarget="{Binding ElementName=ChangeRequestorButton}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                           Opened="OnRequestorPopupOpened">
                                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="12" Width="320" Margin="0,4,8,8"
                                                TextElement.Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock Text="Change Requestor" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                                                <DockPanel>
                                                    <ui:ProgressRing x:Name="RequestorProgress" DockPanel.Dock="Right" IsActive="False" Visibility="Collapsed"
                                                                     Width="14" Height="14" Margin="6,0,0,0" />
                                                    <TextBox x:Name="RequestorSearchBox" ui:ControlHelper.PlaceholderText="Search people"
                                                             AutomationProperties.Name="Search people for the new requestor"
                                                             TextChanged="OnRequestorSearchChanged" PreviewKeyDown="OnRequestorSearchKeyDown" />
                                                </DockPanel>
                                                <TextBlock x:Name="RequestorStatusText" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                <ListBox x:Name="RequestorResultsList" MaxHeight="240" Margin="0,6,0,0"
                                                         BorderThickness="0" Background="Transparent"
                                                         AutomationProperties.Name="People"
                                                         MouseLeftButtonUp="OnRequestorResultPicked" KeyDown="OnRequestorResultsKeyDown">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,2" AutomationProperties.Name="{Binding DisplayName}">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" />
                                                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Border>
                                    </Popup>

                                    <TextBlock Grid.Row="1" Text="Email" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailEmailText" Style="{StaticResource DetailValue}" />

                                    <TextBlock Grid.Row="2" Text="Group" Style="{StaticResource DetailLabel}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DetailGroupCombo" AutomationProperties.Name="Group"
                                              SelectionChanged="OnDetailFieldChanged" Tag="ResponsibleGroupID" />

                                    <TextBlock Grid.Row="3" Text="Responsible" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DetailResponsibleText" Style="{StaticResource DetailValue}" />

                                    <TextBlock Grid.Row="4" Text="Created" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DetailCreatedText" Style="{StaticResource DetailValue}" />

                                    <TextBlock Grid.Row="5" Text="Modified" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DetailModifiedText" Style="{StaticResource DetailValue}" />
                                </Grid>
                            </Grid>

                            <!-- Description, with edit and copy on the right as on the Mac.
                                 Edit opens the text in place; the check mark or Ctrl+Enter
                                 saves it, Esc cancels. -->
                            <StackPanel x:Name="DescriptionSection" Margin="0,12,0,0">
                                <Separator Margin="0,0,0,8" />
                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Resources>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Padding" Value="6,3" />
                                                <Setter Property="MinHeight" Value="0" />
                                                <Setter Property="MinWidth" Value="0" />
                                                <Setter Property="Margin" Value="6,0,0,0" />
                                            </Style>
                                        </StackPanel.Resources>
                                        <ui:ProgressRing x:Name="DescriptionProgress" IsActive="False" Visibility="Collapsed"
                                                         Width="14" Height="14" VerticalAlignment="Center" />
                                        <Button x:Name="EditDescriptionButton" Click="OnEditDescriptionClicked"
                                                ToolTip="Edit description" AutomationProperties.Name="Edit description">
                                            <ui:FontIcon x:Name="EditDescriptionIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE70F;" FontSize="12" />
                                        </Button>
                                        <Button x:Name="CancelDescriptionButton" Click="OnCancelDescriptionClicked" Visibility="Collapsed"
                                                ToolTip="Cancel editing (Esc)" AutomationProperties.Name="Cancel editing the description">
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                        <Button x:Name="CopyDescriptionButton" Click="OnCopyDescriptionClicked"
                                                ToolTip="Copy description" AutomationProperties.Name="Copy description">
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="Description" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock x:Name="DetailDescriptionText" FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="NoDescriptionText" Text="No description" FontSize="13" FontStyle="Italic" Visibility="Collapsed"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBox x:Name="DescriptionEditor" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="Wrap" FontSize="13"
                                         MinHeight="80" MaxHeight="300" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True"
                                         AutomationProperties.Name="Description" PreviewKeyDown="OnDescriptionEditorKeyDown" />
                            </StackPanel>

                            <!-- Attachments: open the viewable ones, save any. The first accordion, as
                                 on the Mac: Attachments, People, Workflow, Tasks, then Activity. -->
                            <StackPanel x:Name="AttachmentsSection" Visibility="Collapsed" Margin="0,12,0,0">
                                <Separator Margin="0,0,0,8" />
                                <Expander x:Name="AttachmentsExpander" IsExpanded="False" AutomationProperties.Name="Attachments">
                                    <Expander.Header>
                                        <TextBlock x:Name="AttachmentsHeaderText" Text="Attachments" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                    </Expander.Header>
                                    <StackPanel Margin="0,6,0,0">
                                    <ItemsControl x:Name="AttachmentsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8" Margin="0,0,0,6" CornerRadius="6" BorderThickness="1"
                                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Tag="{Binding}" Click="OnOpenAttachmentClicked" Padding="6,2" Margin="4,0,0,0"
                                                                    Visibility="{Binding OpenVisibility}"
                                                                    ToolTip="{Binding OpenTooltip}"
                                                                    AutomationProperties.Name="{Binding OpenTooltip}">
                                                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A7;" FontSize="12" />
                                                            </Button>
                                                            <Button Tag="{Binding}" Click="OnSaveAttachmentClicked" Padding="6,2" Margin="4,0,0,0"
                                                                    ToolTip="{Binding SaveTooltip}"
                                                                    AutomationProperties.Name="{Binding SaveTooltip}">
                                                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;" FontSize="12" />
                                                            </Button>
                                                        </StackPanel>
                                                        <ui:FontIcon DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons" Glyph="&#xE723;" FontSize="14"
                                                                     Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <!-- People: contacts with add and remove, and the responsible
                                 group. Folded by default, with the same header as Tasks and
                                 Workflow; contacts added here are offered as notify
                                 recipients straight away. -->
                            <StackPanel x:Name="PeopleSection" Margin="0,12,0,0">
                                <Separator Margin="0,0,0,8" />
                                <Expander x:Name="PeopleExpander" IsExpanded="False" AutomationProperties.Name="People">
                                    <Expander.Header>
                                        <TextBlock Text="People" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                    </Expander.Header>
                                    <StackPanel x:Name="PeopleBody" Margin="0,6,0,0">
                                        <TextBlock x:Name="PeopleErrorText" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                                                   Foreground="DarkOrange" />
                                        <TextBlock Text="Contacts" FontSize="12" Margin="0,0,0,4"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                        <DockPanel MaxWidth="360" HorizontalAlignment="Left">
                                            <ui:ProgressRing x:Name="ContactAddProgress" DockPanel.Dock="Right" IsActive="False" Width="14" Height="14"
                                                             Margin="6,0,0,0" Visibility="Collapsed" />
                                            <TextBox x:Name="ContactSearchBox" MinWidth="240" ui:ControlHelper.PlaceholderText="Add a contact: search people" AutomationProperties.Name="Add a contact"
                                                     TextChanged="OnContactSearchChanged" PreviewKeyDown="OnContactSearchKeyDown" />
                                        </DockPanel>
                                        <Popup x:Name="ContactSearchPopup" PlacementTarget="{Binding ElementName=ContactSearchBox}" Placement="Bottom"
                                               StaysOpen="False" AllowsTransparency="True">
                                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderThickness="1"
                                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" CornerRadius="6" Padding="4" Width="320">
                                                <StackPanel>
                                                    <TextBlock x:Name="ContactSearchStatusText" FontSize="11" Margin="4,2" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                    <ListBox x:Name="ContactResultsList" MaxHeight="240" BorderThickness="0" Background="Transparent"
                                                             MouseUp="OnContactResultPicked" KeyDown="OnContactResultsKeyDown">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="2">
                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" />
                                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                        <TextBlock x:Name="NoContactsText" Text="No contacts" FontSize="12" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                        <ItemsControl x:Name="ContactsList" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,6">
                                                        <Button DockPanel.Dock="Right" Tag="{Binding}" Click="OnRemoveContactClicked" Padding="6,2"
                                                                VerticalAlignment="Center" ToolTip="Remove from the ticket's contacts"
                                                                AutomationProperties.Name="Remove contact">
                                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="12" />
                                                        </Button>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" />
                                                            <TextBox Text="{Binding Subtitle, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                                     Padding="0" MinHeight="0" FontSize="11"
                                                                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel x:Name="ResourcesSection" Visibility="Collapsed" Margin="0,6,0,0">
                                            <TextBlock Text="Resources" FontSize="12" Margin="0,0,0,4"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                            <StackPanel x:Name="ResourcesGroupRow" Orientation="Horizontal" Background="Transparent">
                                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE902;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ResourcesGroupText" FontSize="13" VerticalAlignment="Center" />
                                                <TextBlock Text="Group" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <!-- Workflow: active steps and the actions the signed-in user may take -->
                            <tickets:TicketWorkflowPanel x:Name="WorkflowPanel" />

                            <!-- Tasks: progress, updates and standard-task management -->
                            <tickets:TicketTasksPanel x:Name="TasksPanel" />

                            <!-- Action Message -->
                            <Border x:Name="ActionMessageBorder" Visibility="Collapsed" Padding="8" Margin="0,8,0,0" CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:ProgressRing x:Name="ActionProgressRing" IsActive="False" Width="16" Height="16" Margin="0,0,8,0" />
                                    <TextBlock x:Name="ActionMessageText" TextWrapping="Wrap" FontSize="13" />
                                </StackPanel>
                            </Border>

                            <!-- Feed (moved AFTER Add Comment) -->
                            <StackPanel x:Name="FeedSection" Visibility="Collapsed" Margin="0,12,0,0">
                                <Separator Margin="0,0,0,8" />
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock x:Name="FeedHeaderText" DockPanel.Dock="Left" Text="Activity" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                    <!-- Opens the compose space below; "(Draft)" when closed over unsent text. -->
                                    <Button x:Name="AddCommentButton" DockPanel.Dock="Left" Margin="10,0,0,0" Padding="8,3"
                                            Click="OnAddCommentToggleClicked" ToolTip="Write a comment" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70F;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="AddCommentButtonText" Text="Add Comment" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <RadioButton x:Name="FeedFilterComments" Content="Comments" IsChecked="True" GroupName="FeedFilter" Checked="OnFeedFilterChanged" Margin="0,0,4,0" />
                                        <RadioButton x:Name="FeedFilterActivity" Content="Activity" GroupName="FeedFilter" Checked="OnFeedFilterChanged" Margin="0,0,4,0" />
                                        <RadioButton x:Name="FeedFilterAll" Content="All" GroupName="FeedFilter" Checked="OnFeedFilterChanged" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Compose space: under the Activity bar, above the feed it adds to.
                                     Files dropped anywhere on it, or pasted into the text, are
                                     attached. They go to the ticket's Attachments, since TDX
                                     cannot attach a file to one comment. -->
                                <StackPanel x:Name="ComposePanel" Visibility="Collapsed" Margin="0,0,0,10" Background="Transparent"
                                            AllowDrop="True" DragOver="OnComposeDragOver" Drop="OnComposeDrop">
                                    <TextBox x:Name="CommentTextBox" AcceptsReturn="True" Height="90" TextWrapping="Wrap" FontSize="13"
                                             VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True" AllowDrop="True"
                                             PreviewDragOver="OnComposeDragOver" PreviewDragEnter="OnComposeDragOver" PreviewDrop="OnComposeDrop"
                                             CommandManager.PreviewExecuted="OnCommentPreviewExecuted" CommandManager.PreviewCanExecute="OnCommentPreviewCanExecute"
                                             TextChanged="OnCommentTextChanged" PreviewKeyDown="OnCommentKeyDown" />
                                    <!-- Files waiting to go up with the comment. -->
                                    <ItemsControl x:Name="CommentAttachmentsList" Margin="0,6,0,0" Visibility="Collapsed"
                                                  AutomationProperties.Name="Files to attach">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,3,4,3" Margin="0,0,6,6" CornerRadius="12" BorderThickness="1"
                                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                        ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Name}">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Show in File Explorer" Tag="{Binding}" Click="OnShowPendingAttachmentClicked" />
                                                            <MenuItem Header="Remove" Tag="{Binding}" Click="OnRemovePendingAttachmentClicked" />
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE723;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding SizeLabel}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                        <Button Tag="{Binding}" Click="OnRemovePendingAttachmentClicked" Padding="4,1" Margin="4,0,0,0"
                                                                MinHeight="0" MinWidth="0" Background="Transparent" BorderThickness="0"
                                                                ToolTip="Remove" AutomationProperties.Name="Remove attachment">
                                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="10" />
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="PostCommentButton" Content="Post Comment" IsEnabled="False"
                                                Click="OnPostCommentClicked" ToolTip="Post comment (Ctrl+Enter)" />
                                        <Button x:Name="CancelCommentButton" Content="Cancel" Margin="8,0,0,0" Click="OnCancelCommentClicked"
                                                ToolTip="Close the comment editor; the draft is kept" />
                                        <Button x:Name="AttachFilesButton" Margin="8,0,0,0" Click="OnAttachFilesClicked"
                                                ToolTip="Attach files to the ticket with this comment. You can also drop files here or paste them."
                                                AutomationProperties.Name="Attach files">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE723;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Attach…" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <CheckBox x:Name="PrivateCheckBox" Content="Private" Margin="14,0,0,0" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel x:Name="NotifyOptionsPanel" Margin="0,8,0,0">
                                        <TextBlock Text="Notify:" FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,4" />
                                        <StackPanel x:Name="NotifyCheckboxesPanel" />
                                    </StackPanel>
                                    <Separator Margin="0,10,0,0" />
                                </StackPanel>

                                <!-- Each comment, then its thread: the replies, and the reply
                                     composer when it is open, indented on a rail, as on the Mac.
                                     The arrow on any card replies in the thread; the card's
                                     menu (right-click or the Menu key) adds Quote in New Comment
                                     and Copy. -->
                                <ItemsControl x:Name="FeedItemsControl" AutomationProperties.Name="Activity">
                                    <ItemsControl.Resources>
                                        <DataTemplate x:Key="FeedCardTemplate">
                                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" Padding="10" CornerRadius="6" Margin="0,0,0,8"
                                                    AutomationProperties.Name="{Binding AccessibleName}">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Reply in Thread" Tag="{Binding}" Click="OnReplyInThreadClicked" />
                                                        <MenuItem Header="Quote in New Comment" Tag="{Binding}" Click="OnQuoteFeedEntry" />
                                                        <Separator />
                                                        <MenuItem Header="Copy" Tag="{Binding}" Click="OnCopyFeedEntryClicked" />
                                                        <!-- Only on the signed-in person's own replies, as on the Mac. -->
                                                        <Separator Visibility="{Binding DeleteReplyVisibility}" />
                                                        <MenuItem Header="Delete Reply…" Tag="{Binding}" Click="OnDeleteReplyClicked"
                                                                  Visibility="{Binding DeleteReplyVisibility}"
                                                                  AutomationProperties.Name="Delete Reply" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <StackPanel>
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Private: a lock and the word in the secondary text
                                                                 colour on a faint pill, as on the Mac. Theme brushes
                                                                 only, so it reads in light, dark and high contrast. -->
                                                            <Border Visibility="{Binding PrivateVisibility}" Padding="6,1,7,1" CornerRadius="8" Margin="0,0,8,0"
                                                                    VerticalAlignment="Center" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                                    ToolTip="Private: not shown to the requestor" AutomationProperties.Name="Private">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72E;" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                                    <TextBlock Text="Private" FontSize="11" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBlock Text="{Binding FormattedDate}" FontSize="11" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                            <Button Tag="{Binding}" Click="OnReplyInThreadClicked" Margin="6,0,0,0" Padding="4,2"
                                                                    Style="{StaticResource ChromeIconButtonStyle}"
                                                                    ToolTip="Reply in this thread" AutomationProperties.Name="Reply in thread">
                                                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE97A;" FontSize="12"
                                                                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                            </Button>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding CreatedFullName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <!-- Uncapped: a clipped comment reads as a rendering fault,
                                                         and the detail you need is often at the bottom. -->
                                                    <TextBlock Text="{Binding NotificationRecipients}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Visibility="{Binding NotificationVisibility}"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                    <TextBlock Text="{Binding StrippedBody}" FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.Resources>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FeedCardTemplate}" />
                                                <Border Visibility="{Binding ThreadVisibility}" Margin="12,-2,0,8" Padding="12,0,0,0"
                                                        BorderThickness="2,0,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                                    <StackPanel>
                                                        <ItemsControl ItemsSource="{Binding Replies}" ItemTemplate="{StaticResource FeedCardTemplate}"
                                                                      Focusable="False" AutomationProperties.Name="Replies" />
                                                        <!-- The reply composer, where the next reply will land.
                                                             The API takes only a body, so no Private or Notify.
                                                             Files dropped on it, pasted into it or picked with
                                                             Attach… go to the ticket's Attachments first, as a
                                                             comment's do and as on the Mac. -->
                                                        <Border Visibility="{Binding ComposerVisibility}" Padding="10" CornerRadius="6" BorderThickness="1"
                                                                BorderBrush="{DynamicResource SystemControlForegroundAccentBrush}"
                                                                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                                                AutomationProperties.Name="{Binding ReplyLabel}"
                                                                Tag="{Binding}" AllowDrop="True" DragOver="OnReplyDragOver" Drop="OnReplyDrop">
                                                            <StackPanel>
                                                                <TextBox Tag="{Binding}" Text="{Binding ReplyDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         AcceptsReturn="True" TextWrapping="Wrap" Height="64" FontSize="13"
                                                                         VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True"
                                                                         ui:ControlHelper.PlaceholderText="{Binding ReplyLabel}"
                                                                         AutomationProperties.Name="{Binding ReplyLabel}"
                                                                         AllowDrop="True" PreviewDragOver="OnReplyDragOver" PreviewDragEnter="OnReplyDragOver" PreviewDrop="OnReplyDrop"
                                                                         CommandManager.PreviewExecuted="OnReplyPreviewExecuted" CommandManager.PreviewCanExecute="OnReplyPreviewCanExecute"
                                                                         PreviewKeyDown="OnReplyKeyDown" />
                                                                <!-- Files waiting to go up with the reply. -->
                                                                <ItemsControl ItemsSource="{Binding ReplyAttachments}" Visibility="{Binding ReplyAttachmentsVisibility}"
                                                                              Margin="0,6,0,0" Focusable="False" AutomationProperties.Name="Files to attach to the reply">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Padding="8,3,4,3" Margin="0,0,6,6" CornerRadius="12" BorderThickness="1"
                                                                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                                                    ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Name}">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE723;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                                    <TextBlock Text="{Binding Name}" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                                    <TextBlock Text="{Binding SizeLabel}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                                                    <Button Tag="{Binding}" Click="OnRemoveReplyAttachmentClicked" Padding="4,1" Margin="4,0,0,0"
                                                                                            MinHeight="0" MinWidth="0" Background="Transparent" BorderThickness="0"
                                                                                            ToolTip="Remove" AutomationProperties.Name="{Binding Name, StringFormat='Remove {0}'}">
                                                                                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="10" />
                                                                                    </Button>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                                    <Button Content="{Binding PostReplyLabel}" Tag="{Binding}" Click="OnPostReplyClicked"
                                                                            IsEnabled="{Binding CanPostReply}" Style="{DynamicResource AccentButtonStyle}"
                                                                            ToolTip="{Binding PostReplyToolTip}" />
                                                                    <Button Content="Cancel" Tag="{Binding}" Click="OnCancelReplyClicked" Margin="8,0,0,0"
                                                                            ToolTip="Close the reply; the draft is kept (Esc)" />
                                                                    <Button Tag="{Binding}" Click="OnAttachReplyFilesClicked" Margin="8,0,0,0"
                                                                            IsEnabled="{Binding CanAttachReply}"
                                                                            ToolTip="Attach files to the ticket with this reply. You can also drop files here or paste them."
                                                                            AutomationProperties.Name="Attach files to the reply">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE723;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                            <TextBlock Text="Attach…" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <ui:ProgressRing IsActive="{Binding IsPostingReply}" Visibility="{Binding PostingVisibility}"
                                                                                     Width="14" Height="14" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding ReplyHint}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <!-- No Selection -->
                        <StackPanel x:Name="NoSelectionPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8EC;" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Select a Ticket" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Select a ticket from the list to view details" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </DockPanel>
</Page>
