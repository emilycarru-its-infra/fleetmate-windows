<Page x:Class="FleetMate.GUI.Views.Tickets.TicketsPage"
      Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:widgets="clr-namespace:FleetMate.GUI.Views.Shared.Widgets">

    <!-- Widgets sit above the page; the DockPanel keeps the page's own grid untouched. -->
    <DockPanel>
    <widgets:WidgetsSection x:Name="TicketWidgetsSection" DockPanel.Dock="Top" Tab="Tickets" Margin="16,14,16,0" />
    <Grid Margin="16,14,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Toolbar, left-aligned as on Mac: List|Board first, then the board's
             column picker, sort, Assigned to Me and the actions. Every control
             is the same height so the row reads as one strip. The count sits at
             the right edge. -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" LastChildFill="True">
            <DockPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </DockPanel.Resources>

            <!-- Sign In appears only when silent sign-in failed; a signed-in
                 user needs no indicator, since the tickets loading says it. -->
            <Button x:Name="SsoLoginButton" DockPanel.Dock="Right" Content="Sign In" Margin="8,0,0,0"
                    ToolTip="Sign-in to TeamDynamix failed. Try the silent sign-in again." Click="OnSsoLoginClicked" Visibility="Collapsed"/>
            <TextBlock x:Name="TicketCountText" DockPanel.Dock="Right" Text="0 of 0" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <!-- View Mode Toggle -->
                <Border Height="32" Margin="0,0,12,0" CornerRadius="8" Padding="2" VerticalAlignment="Center"
                        BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ListViewRadio" Content="List" GroupName="ViewMode" Padding="11,0"
                                     Checked="OnViewModeChanged" Style="{StaticResource NavigationTabStyle}" />
                        <RadioButton x:Name="BoardViewRadio" Content="Board" IsChecked="True" GroupName="ViewMode" Padding="11,0"
                                     Checked="OnViewModeChanged" Style="{StaticResource NavigationTabStyle}" />
                    </StackPanel>
                </Border>

                <!-- Board column dimension, mirroring the macOS BoardGroupBy
                     options; shown only on the board, as on Mac. -->
                <ComboBox x:Name="BoardGroupComboBox" Width="150" Margin="0,0,8,0" ToolTip="Group board columns by"
                          SelectionChanged="OnBoardGroupChanged">
                    <ComboBoxItem Content="Status" />
                    <ComboBoxItem Content="Responsible" IsSelected="True" />
                    <ComboBoxItem Content="Priority" />
                    <ComboBoxItem Content="Group" />
                </ComboBox>

                <ComboBox x:Name="SortComboBox" Width="130" Margin="0,0,4,0" ToolTip="Sort by" SelectionChanged="OnSortChanged">
                    <ComboBoxItem Content="Modified" IsSelected="True" />
                    <ComboBoxItem Content="Created" />
                    <ComboBoxItem Content="ID" />
                    <ComboBoxItem Content="Age" />
                    <ComboBoxItem Content="Title" />
                    <ComboBoxItem Content="Status" />
                    <ComboBoxItem Content="Priority" />
                    <ComboBoxItem Content="Requestor" />
                    <ComboBoxItem Content="Responsible" />
                </ComboBox>
                <Button x:Name="SortDirectionButton" Content="↓" Width="32" Padding="0" Margin="0,0,8,0" Click="OnSortDirectionClicked" ToolTip="Toggle sort direction" />

                <!-- Fold controls change how rows are drawn, not which rows are there. -->
                <Button x:Name="CollapseAllButton" Content="▸" FontFamily="Segoe UI Symbol" FontSize="10" Width="32" Padding="0"
                        ToolTip="Collapse all" Click="OnCollapseAllClicked" Margin="0,0,4,0" />
                <Button x:Name="ExpandAllButton" Content="▾" FontFamily="Segoe UI Symbol" FontSize="10" Width="32" Padding="0"
                        ToolTip="Expand all" Click="OnExpandAllClicked" Margin="0,0,12,0" />

                <!-- Assigned to Me narrows the list to tickets the signed-in TDX
                     person is responsible for; the choice is remembered. -->
                <ToggleButton x:Name="AssignedToMeToggle" Margin="0,0,8,0" IsEnabled="False"
                              ToolTip="Waiting to identify you in TeamDynamix"
                              Checked="OnAssignedToMeChanged" Unchecked="OnAssignedToMeChanged">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE77B;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Assigned to Me" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="DetailPanelButton" Margin="0,0,8,0" Click="OnToggleDetailPanel"><StackPanel Orientation="Horizontal"><ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE89F;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="Details" VerticalAlignment="Center" /></StackPanel></Button>
                <Button x:Name="NewTicketButton" Margin="0,0,8,0" Click="OnNewTicketClicked" ToolTip="Create a ticket"><StackPanel Orientation="Horizontal"><ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="New Ticket" VerticalAlignment="Center" /></StackPanel></Button>
                <Button x:Name="RefreshButton" Click="OnRefreshClicked"><StackPanel Orientation="Horizontal"><ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="Refresh" VerticalAlignment="Center" /></StackPanel></Button>
            </WrapPanel>
        </DockPanel>

        <!-- Filters, left-aligned under the toolbar: the created-date window,
             one dropdown per category, then Show Closed. -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,8" LastChildFill="True">
            <!-- Created-date window, same presets as macOS. Up to 5000
                 tickets load per window, so there is no separate limit. -->
            <ComboBox x:Name="DateRangeComboBox" DockPanel.Dock="Left" Width="170" Height="32" MinHeight="0" Margin="0,0,8,4"
                      VerticalAlignment="Top" VerticalContentAlignment="Center" ToolTip="Tickets created in"
                      DisplayMemberPath="Label" SelectionChanged="OnDateRangeChanged" />
            <TextBox x:Name="SearchBox" DockPanel.Dock="Left" Visibility="Collapsed" Width="160" ui:ControlHelper.PlaceholderText="Search..." TextChanged="OnSearchChanged" />
            <!-- One dropdown per filter category. Each holds any number of
                 values, which the widgets above also toggle. Show Closed rides
                 at the end of the same wrap so it stays with the filters. -->
            <WrapPanel x:Name="FilterRowPanel" HorizontalAlignment="Left" VerticalAlignment="Top">
                <WrapPanel x:Name="FilterButtonsPanel" VerticalAlignment="Center" />
                <CheckBox x:Name="ShowClosedCheckBox" Content="Show Closed" IsChecked="False" VerticalAlignment="Center" Margin="4,0,0,4"
                          Checked="OnShowClosedChanged" Unchecked="OnShowClosedChanged" />
            </WrapPanel>
        </DockPanel>

        <!-- Main Content -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListPanelColumn" Width="*" MinWidth="480" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="DetailPanelColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Drag handle between the ticket list and the detail panel. Only
                 shown while the panel is open. The panel opens at half the
                 width and keeps whatever share the operator drags it to. -->
            <GridSplitter x:Name="DetailPanelSplitter" Grid.Column="1" Width="6" Margin="5,0"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Visibility="Collapsed" />

            <!-- Ticket List View -->
            <Border x:Name="ListViewPanel" Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <!-- Loading indicator -->
                    <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing IsActive="True" Width="40" Height="40" />
                        <TextBlock Text="Loading tickets..." Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Not configured message -->
                    <TextBlock x:Name="NotConfiguredText" Visibility="Collapsed"
                               Text="Add the TeamDynamix endpoint in Settings. FleetMate signs in silently as your Windows user."
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" />

                    <!-- Tickets ListView -->
                    <ListView x:Name="TicketsListView"
                              AlternationCount="2"
                              ItemContainerStyle="{StaticResource FleetListViewItemStyle}"
                              SelectionMode="Single"
                              SelectionChanged="OnTicketSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <!-- Indent the content, not the row: an indented
                                     selection highlight reads as a rendering bug. -->
                                <Grid Margin="{Binding IndentMargin}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Title and Status -->
                                    <DockPanel Grid.Row="0">
                                        <!-- Disclosure triangle. Hidden rather than
                                             collapsed on leaves so titles stay in
                                             one visual column. -->
                                        <Button DockPanel.Dock="Left" Content="{Binding TriangleGlyph}"
                                                Visibility="{Binding TriangleVisibility}"
                                                ToolTip="{Binding ChildCountTooltip}"
                                                Tag="{Binding}" Click="OnToggleTicketFold"
                                                FontFamily="Segoe UI Symbol" FontSize="9"
                                                Width="16" Height="16" Padding="0" Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="Gray" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusName}" Value="New">
                                                                <Setter Property="Fill" Value="Blue" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusName}" Value="Open">
                                                                <Setter Property="Fill" Value="Blue" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusName}" Value="In Progress">
                                                                <Setter Property="Fill" Value="Orange" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusName}" Value="In Process">
                                                                <Setter Property="Fill" Value="Orange" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusName}" Value="Resolved">
                                                                <Setter Property="Fill" Value="Green" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusName}" Value="Closed">
                                                                <Setter Property="Fill" Value="Green" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusName}" Value="On Hold">
                                                                <Setter Property="Fill" Value="Gray" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusName}" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>

                                    <!-- Secondary Info -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE77B;" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RequestorName}" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,12,0" />
                                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE716;" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ResponsibleGroupName}" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,12,0" />
                                        <TextBlock Text="→" FontSize="11" Margin="0,0,2,0" />
                                        <TextBlock Text="{Binding ResponsibleFullName}" FontSize="11" Foreground="{DynamicResource SystemControlForegroundAccentBrush}" Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding PriorityName}" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,12,0" />
                                        <!-- Age and idle time answer different
                                             questions, so both are shown. -->
                                        <TextBlock Text="{Binding AgeLabel}" FontSize="11" ToolTip="Days since opened"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding LastActivityLabel}" FontSize="11" ToolTip="Days since last activity"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            
            <!-- Kanban Board View -->
            <ScrollViewer x:Name="BoardViewPanel" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <!-- Blocks of columns. Responsible mode draws one block per
                     responsible group (groupless tickets in a trailing "No Group"
                     block, as on macOS); other modes are one headerless block. -->
                <ItemsControl x:Name="BoardColumnsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{Binding BlockMargin}">
                                <Rectangle Visibility="{Binding HeaderVisibility}" RadiusX="12" RadiusY="12"
                                           Stroke="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                           StrokeThickness="1.5" StrokeDashArray="4 3" />
                                <DockPanel Margin="{Binding BlockPadding}">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,8"
                                                Visibility="{Binding HeaderVisibility}">
                                        <TextBlock Text="{Binding Header}" FontWeight="Bold" FontSize="13" />
                                        <TextBlock Text="{Binding Count}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Bottom"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Columns}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                            <Border Background="{DynamicResource SubtleFillBrush}"
                                    CornerRadius="12" Width="280" Margin="0,0,16,0" VerticalAlignment="Top"
                                    AllowDrop="True" Drop="OnBoardColumnDrop" DragOver="OnBoardColumnDragOver"
                                    Tag="{Binding StatusName}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Column Header -->
                                    <!-- Neutral, as on Mac: a small dot (the status colour when
                                         grouping by status, grey otherwise), the name and a count. -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10,12,4">
                                        <Ellipse Width="10" Height="10" Fill="{Binding HeaderColor}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding StatusName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                        <TextBlock Text="{Binding Count, StringFormat='({0})'}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </StackPanel>
                                    
                                    <!-- Cards -->
                                    <!-- No fixed cap: the column fills the board's height and scrolls internally. -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                                            Padding="10" CornerRadius="6" Margin="{Binding CardIndentMargin}"
                                                            MouseLeftButtonUp="OnBoardCardClick" Cursor="Hand"
                                                            PreviewMouseLeftButtonDown="OnBoardCardPreviewMouseDown"
                                                            MouseMove="OnBoardCardMouseMove"
                                                            Tag="{Binding Id}">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.2" />
                                                        </Border.Effect>
                                                        <StackPanel>
                                                            <!-- ID, fold control and Priority -->
                                                            <DockPanel Margin="0,0,0,4">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding PriorityName}" FontSize="10"
                                                                           Padding="6,2" Background="#20808080" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                                <Button DockPanel.Dock="Left" Content="{Binding TriangleGlyph}"
                                                                        Visibility="{Binding TriangleVisibility}"
                                                                        ToolTip="{Binding ChildCountTooltip}"
                                                                        Tag="{Binding}" Click="OnToggleTicketFold"
                                                                        FontFamily="Segoe UI Symbol" FontSize="9"
                                                                        Width="14" Height="14" Padding="0" Margin="0,0,4,0"
                                                                        VerticalAlignment="Center"
                                                                        Background="Transparent" BorderThickness="0" />
                                                                <TextBlock Text="{Binding Id, StringFormat='#{0}'}" FontSize="11"
                                                                           Foreground="{DynamicResource SystemControlForegroundAccentBrush}" FontWeight="Medium" />
                                                            </DockPanel>
                                                            
                                                            <!-- Title -->
                                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium" 
                                                                       TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                                                            
                                                            <!-- Requestor and Group -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE77B;" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding RequestorName}" FontSize="10" 
                                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                                            </StackPanel>
                                                            
                                                            <!-- Responsible -->
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="→" FontSize="10" Margin="0,0,4,0" Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                                                                <TextBlock Text="{Binding ResponsibleFullName}" FontSize="10" 
                                                                           Foreground="{DynamicResource SystemControlForegroundAccentBrush}" 
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Detail Panel -->
            <Border x:Name="DetailPanel" Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Panel Header, laid out like the macOS detail header: a
                         chevron that closes the pane, pointing the way it goes; the
                         ticket number (click to copy), copy-link and open-in-TDX,
                         then the actions on the same row. The actions wrap under
                         themselves in a narrow pane instead of clipping. -->
                    <StackPanel Grid.Row="0" Margin="12,12,12,8">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,8,0">
                                <Button x:Name="CloseDetailButton" Click="OnCloseDetailPanel" ToolTip="Close the ticket (Esc)"
                                        AutomationProperties.Name="Close the ticket"
                                        Style="{StaticResource ChromeIconButtonStyle}" MinWidth="0" Padding="2,5,6,5">
                                    <ui:FontIcon Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </Button>
                                <Button x:Name="CopyTicketIdButton" Click="OnCopyTicketIdClicked"
                                        ToolTip="Copy ticket number" Style="{StaticResource ChromeIconButtonStyle}" Padding="0,2,6,2">
                                    <TextBlock x:Name="DetailTicketIdText" FontWeight="Bold" FontSize="18"
                                               Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                                </Button>
                                <Button x:Name="CopyTicketLinkButton" Click="OnCopyTicketLinkClicked"
                                        ToolTip="Copy ticket link" Style="{StaticResource ChromeIconButtonStyle}">
                                    <ui:FontIcon Glyph="&#xE71B;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                                </Button>
                                <Button x:Name="OpenInWebButton" Click="OnOpenInWebClicked"
                                        ToolTip="Open in TDX" Style="{StaticResource ChromeIconButtonStyle}">
                                    <ui:FontIcon Glyph="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                                </Button>
                            </StackPanel>

                        <WrapPanel x:Name="DetailActionsPanel" VerticalAlignment="Center">
                            <WrapPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Padding" Value="10,0" />
                                    <Setter Property="Height" Value="30" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Margin" Value="0,2,6,2" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                            </WrapPanel.Resources>
                            <Button x:Name="AssignToMeButton" Click="OnAssignToMeClicked" ToolTip="Make me the responsible">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="Assign to me" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ReassignButton" Click="OnReassignClicked" ToolTip="Reassign to someone else">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE716;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="Reassign" VerticalAlignment="Center" />
                                    <ui:FontIcon Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="9" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="UnassignButton" Click="OnUnassignClicked" ToolTip="Clear the responsible person">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE8F8;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="Unassign" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SetParentButton" Click="OnSetParentClicked" ToolTip="Set or clear this ticket's parent">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE74A;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="Set Parent" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CreateParentButton" Click="OnCreateParentClicked" ToolTip="Create a new ticket and make it this ticket's parent">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="Create Parent" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnRefreshDetailClicked" ToolTip="Refresh this ticket">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="Refresh" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        </DockPanel>

                        <!-- Reassign popover, anchored to its button: search people,
                             pick one, and the ticket's responsible changes. -->
                        <Popup x:Name="ReassignPopup" PlacementTarget="{Binding ElementName=ReassignButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               Opened="OnReassignPopupOpened">
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Width="320" Margin="0,4,8,8"
                                    TextElement.Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Reassign to" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                                    <TextBox x:Name="ReassignSearchBox" ui:ControlHelper.PlaceholderText="Search people by name or email"
                                             TextChanged="OnReassignSearchChanged" PreviewKeyDown="OnReassignSearchKeyDown" />
                                    <TextBlock x:Name="ReassignStatusText" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               Text="Type at least two characters." />
                                    <ListBox x:Name="ReassignResultsList" MaxHeight="240" Margin="0,6,0,0"
                                             BorderThickness="0" Background="Transparent"
                                             MouseLeftButtonUp="OnReassignResultPicked" KeyDown="OnReassignResultsKeyDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" />
                                                    <TextBlock Text="{Binding PrimaryEmail}" FontSize="11"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Create Parent popover: a title; the new ticket copies this one's queue fields. -->
                        <Popup x:Name="CreateParentPopup" PlacementTarget="{Binding ElementName=CreateParentButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               Opened="OnCreateParentPopupOpened">
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Width="320" Margin="0,4,8,8"
                                    TextElement.Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Create Parent Ticket" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                                    <TextBlock Text="A new ticket with this one's type, account, requestor and owners, set as its parent."
                                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <TextBox x:Name="ParentTitleBox" ui:ControlHelper.PlaceholderText="Parent title"
                                             PreviewKeyDown="OnParentTitleKeyDown" />
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Content="Create Parent" Click="OnCreateParentConfirmed"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        <TextBlock x:Name="CreateParentHintText" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Set Parent popover: a ticket number, or empty to clear. -->
                        <Popup x:Name="SetParentPopup" PlacementTarget="{Binding ElementName=SetParentButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               Opened="OnSetParentPopupOpened">
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Width="260" Margin="0,4,8,8"
                                    TextElement.Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Parent ticket" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                                    <TextBox x:Name="ParentIdBox" ui:ControlHelper.PlaceholderText="Ticket number, or empty to clear"
                                             PreviewKeyDown="OnParentIdKeyDown" />
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Content="Set Parent" Click="OnSetParentConfirmed"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        <TextBlock x:Name="SetParentHintText" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <!-- Detail Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel x:Name="DetailContent" Margin="12,0,12,12" Visibility="Collapsed">
                            <!-- Title -->
                            <TextBlock x:Name="DetailTitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <!-- Status and Priority -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border x:Name="DetailStatusBadge" Padding="8,4" CornerRadius="4" Margin="0,0,8,0">
                                    <TextBlock x:Name="DetailStatusText" FontSize="12" />
                                </Border>
                                <Border Background="#FFF0D080" Padding="8,4" CornerRadius="4">
                                    <TextBlock x:Name="DetailPriorityText" FontSize="12" />
                                </Border>
                            </StackPanel>

                            <!-- Two columns to save height: the editable fields on the
                                 left, the read-only facts on the right. Status, Priority
                                 and Classification change the ticket as soon as a new
                                 value is picked, like Reassign. -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Setter Property="Width" Value="190" />
                                            <Setter Property="Height" Value="30" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Setter Property="FontSize" Value="13" />
                                        </Style>
                                    </Grid.Resources>
                                    <TextBlock Grid.Row="0" Text="Status:" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="DetailStatusCombo"
                                              DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="OnDetailFieldChanged" Tag="StatusID" />
                                    <TextBlock Grid.Row="1" Text="Priority:" FontSize="13" VerticalAlignment="Center" Margin="0,4,10,0"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DetailPriorityCombo" Margin="0,4,0,0"
                                              DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="OnDetailFieldChanged" Tag="PriorityID" />
                                    <TextBlock Grid.Row="2" Text="Class:" FontSize="13" VerticalAlignment="Center" Margin="0,4,10,0"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DetailClassificationCombo" Margin="0,4,0,0"
                                              DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="OnDetailFieldChanged" Tag="Classification" />
                                </Grid>

                                <Grid Grid.Column="2" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style x:Key="DetailLabel" TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="Margin" Value="0,2,10,0" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                        </Style>
                                        <Style x:Key="DetailValue" TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="Margin" Value="0,2,0,0" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </Grid.Resources>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Requestor:" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailRequestorText" Style="{StaticResource DetailValue}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailEmailText" Style="{StaticResource DetailValue}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Group:" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetailGroupText" Style="{StaticResource DetailValue}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Responsible:" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DetailResponsibleText" Style="{StaticResource DetailValue}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Created:" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DetailCreatedText" Style="{StaticResource DetailValue}" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Modified:" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DetailModifiedText" Style="{StaticResource DetailValue}" />
                                </Grid>
                            </Grid>

                            <!-- Description -->
                            <StackPanel x:Name="DescriptionSection" Visibility="Collapsed" Margin="0,12,0,0">
                                <Separator Margin="0,0,0,8" />
                                <TextBlock Text="Description" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
                                <TextBlock x:Name="DetailDescriptionText" FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Attachments: open the viewable ones, save any -->
                            <StackPanel x:Name="AttachmentsSection" Visibility="Collapsed" Margin="0,12,0,0">
                                <Separator Margin="0,0,0,8" />
                                <TextBlock x:Name="AttachmentsHeaderText" Text="Attachments" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
                                <ItemsControl x:Name="AttachmentsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8" Margin="0,0,0,6" CornerRadius="6" BorderThickness="1"
                                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Tag="{Binding}" Click="OnOpenAttachmentClicked" Padding="6,2" Margin="4,0,0,0"
                                                                Visibility="{Binding OpenVisibility}"
                                                                ToolTip="{Binding OpenTooltip}"
                                                                AutomationProperties.Name="{Binding OpenTooltip}">
                                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A7;" FontSize="12" />
                                                        </Button>
                                                        <Button Tag="{Binding}" Click="OnSaveAttachmentClicked" Padding="6,2" Margin="4,0,0,0"
                                                                ToolTip="{Binding SaveTooltip}"
                                                                AutomationProperties.Name="{Binding SaveTooltip}">
                                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;" FontSize="12" />
                                                        </Button>
                                                    </StackPanel>
                                                    <ui:FontIcon DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons" Glyph="&#xE723;" FontSize="14"
                                                                 Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Add Comment (moved BEFORE Activity) -->
                            <Separator Margin="0,12,0,8" />
                            <TextBlock Text="Add Comment" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <TextBox x:Name="CommentTextBox" AcceptsReturn="True" Height="70" TextWrapping="Wrap" FontSize="13" />
                            
                            <!-- Notify Options -->
                            <StackPanel x:Name="NotifyOptionsPanel" Margin="0,8,0,0">
                                <TextBlock Text="Notify:" FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,4" />
                                <StackPanel x:Name="NotifyCheckboxesPanel" />
                            </StackPanel>
                            
                            <DockPanel Margin="0,8,0,0">
                                <CheckBox x:Name="PrivateCheckBox" Content="Private" DockPanel.Dock="Left" FontSize="13" />
                                <Button x:Name="PostCommentButton" Content="Post Comment" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="OnPostCommentClicked" />
                            </DockPanel>

                            <!-- Action Message -->
                            <Border x:Name="ActionMessageBorder" Visibility="Collapsed" Padding="8" Margin="0,8,0,0" CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:ProgressRing x:Name="ActionProgressRing" IsActive="False" Width="16" Height="16" Margin="0,0,8,0" />
                                    <TextBlock x:Name="ActionMessageText" TextWrapping="Wrap" FontSize="13" />
                                </StackPanel>
                            </Border>

                            <!-- Feed (moved AFTER Add Comment) -->
                            <StackPanel x:Name="FeedSection" Visibility="Collapsed" Margin="0,12,0,0">
                                <Separator Margin="0,0,0,8" />
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock x:Name="FeedHeaderText" Text="Activity" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <RadioButton x:Name="FeedFilterComments" Content="Comments" IsChecked="True" GroupName="FeedFilter" Checked="OnFeedFilterChanged" Margin="0,0,4,0" />
                                        <RadioButton x:Name="FeedFilterActivity" Content="Activity" GroupName="FeedFilter" Checked="OnFeedFilterChanged" Margin="0,0,4,0" />
                                        <RadioButton x:Name="FeedFilterAll" Content="All" GroupName="FeedFilter" Checked="OnFeedFilterChanged" />
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl x:Name="FeedItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" Padding="10" CornerRadius="6" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <!-- Quote, not Reply: the TDX Web API has no route
                                                                 for a threaded reply, so quoting into a new
                                                                 comment is the closest thing it supports. -->
                                                            <Button Content="Quote" FontSize="10" Padding="6,1" Margin="0,0,6,0"
                                                                    Click="OnQuoteFeedEntry" Tag="{Binding}"
                                                                    ToolTip="Quote this comment into a new one" />
                                                            <Border x:Name="PrivateBadge" Background="#FFFFD080" Padding="6,2" CornerRadius="4" Margin="0,0,4,0" Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="Private" FontSize="10" />
                                                            </Border>
                                                            <TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding CreatedFullName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <!-- Uncapped: a clipped comment reads as a rendering fault,
                                                         and the detail you need is often at the bottom. -->
                                                    <TextBlock Text="{Binding StrippedBody}" FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <!-- No Selection -->
                        <StackPanel x:Name="NoSelectionPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8EC;" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Select a Ticket" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Select a ticket from the list to view details" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </DockPanel>
</Page>
