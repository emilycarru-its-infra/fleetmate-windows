<Window x:Class="FleetMate.GUI.Views.Tickets.CreateTicketDialog"
      Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="New Ticket"
        Height="720" Width="560" MinHeight="560" MinWidth="460"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="New Ticket" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Title" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="TitleBox" Margin="0,0,0,12" />

                <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Classification" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox Grid.Row="1" Grid.Column="0" x:Name="ClassificationCombo" HorizontalAlignment="Stretch"
                              DisplayMemberPath="Value" SelectedValuePath="Key" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Type" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox Grid.Row="1" Grid.Column="2" x:Name="TypeCombo" HorizontalAlignment="Stretch"
                              DisplayMemberPath="Value" SelectedValuePath="Key" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Status" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <ComboBox Grid.Row="3" Grid.Column="0" x:Name="StatusCombo" HorizontalAlignment="Stretch"
                              DisplayMemberPath="Value" SelectedValuePath="Key" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Priority" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <ComboBox Grid.Row="3" Grid.Column="2" x:Name="PriorityCombo" HorizontalAlignment="Stretch"
                              DisplayMemberPath="Value" SelectedValuePath="Key" />
                </Grid>

                <TextBlock Text="Requestor" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="RequestorBox" ui:ControlHelper.PlaceholderText="Search people by name or email"
                         TextChanged="OnPersonSearchChanged" Tag="Requestor" />
                <ListBox x:Name="RequestorResults" MaxHeight="120" Visibility="Collapsed" Tag="Requestor"
                         SelectionChanged="OnPersonPicked" DisplayMemberPath="DisplayName" />
                <TextBlock x:Name="RequestorPicked" FontSize="12" Margin="0,4,0,12"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                <TextBlock Text="Responsible" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="ResponsibleBox" ui:ControlHelper.PlaceholderText="Search people by name or email"
                         TextChanged="OnPersonSearchChanged" Tag="Responsible" />
                <ListBox x:Name="ResponsibleResults" MaxHeight="120" Visibility="Collapsed" Tag="Responsible"
                         SelectionChanged="OnPersonPicked" DisplayMemberPath="DisplayName" />
                <TextBlock x:Name="ResponsiblePicked" FontSize="12" Margin="0,4,0,12"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <CheckBox x:Name="NotifyRequestorBox" Content="Notify requestor" IsChecked="True" Margin="0,0,16,0" />
                    <CheckBox x:Name="NotifyResponsibleBox" Content="Notify responsible" IsChecked="True" />
                </StackPanel>

                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Add Files…" Click="OnAddFiles" />
                    <TextBlock Text="Attachments" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="AttachmentList" MaxHeight="110" KeyDown="OnAttachmentKeyDown"
                         ToolTip="Select a file and press Delete to remove it" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" Click="OnCancel" Margin="0,0,8,0" MinWidth="80" IsCancel="True" />
                <Button x:Name="CreateButton" Content="Create Ticket" Click="OnCreate"
                        Style="{StaticResource AccentButtonStyle}" MinWidth="110" />
            </StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </DockPanel>
    </Grid>
</Window>
