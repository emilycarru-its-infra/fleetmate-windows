<UserControl x:Class="FleetMate.GUI.Views.Tickets.TicketWorkflowPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             Visibility="Collapsed">
    <!-- The ticket's workflow: its name and state, every active step (all of
         them when branches run in parallel) and, per step, only the actions
         TeamDynamix offers the signed-in user. Pressing an action asks for
         confirmation, with optional comments, before anything is sent.
         Collapsed until opened; the header says which workflow it is and
         where it stands. Restart and Change sit beside Refresh, and in the
         section's right-click menu. -->
    <StackPanel Margin="0,12,0,0">
        <Separator Margin="0,0,0,8" />
        <Expander x:Name="WorkflowExpander" IsExpanded="False" AutomationProperties.AutomationId="TicketWorkflowExpander"
                  ContextMenuOpening="OnSectionContextMenuOpening">
            <Expander.ContextMenu>
                <ContextMenu x:Name="SectionMenu" AutomationProperties.AutomationId="TicketWorkflowMenu">
                    <MenuItem x:Name="MenuRefreshWorkflow" Header="Refresh Workflow" Click="OnRefreshClicked"
                              AutomationProperties.AutomationId="TicketWorkflowMenuRefresh" />
                    <Separator />
                    <MenuItem x:Name="MenuRestartWorkflow" Header="Restart Workflow…" Click="OnRestartClicked"
                              AutomationProperties.AutomationId="TicketWorkflowMenuRestart" />
                    <MenuItem x:Name="MenuChangeWorkflow" Header="Change Workflow…" Click="OnChangeClicked"
                              AutomationProperties.AutomationId="TicketWorkflowMenuChange" />
                </ContextMenu>
            </Expander.ContextMenu>
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Workflow" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock x:Name="WorkflowSummaryText" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <ui:ProgressRing x:Name="WorkflowProgress" IsActive="False" Visibility="Collapsed"
                                     Width="14" Height="14" Margin="8,0,0,0" />
                </StackPanel>
            </Expander.Header>
            <StackPanel Margin="0,6,0,0">
                <WrapPanel Margin="0,0,0,6">
                    <Button x:Name="RefreshWorkflowButton" Padding="6,2" Margin="0,0,6,0" Click="OnRefreshClicked"
                            ToolTip="Refresh the workflow" AutomationProperties.Name="Refresh Workflow"
                            AutomationProperties.AutomationId="TicketWorkflowRefresh">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                    <Button x:Name="RestartWorkflowButton" Content="Restart Workflow…" Padding="8,2" Margin="0,0,6,0"
                            Click="OnRestartClicked" AutomationProperties.AutomationId="TicketWorkflowRestart"
                            ToolTip="Start the ticket's workflow over from its first step" />
                    <Button x:Name="ChangeWorkflowButton" Content="Change Workflow…" Padding="8,2"
                            Click="OnChangeClicked" AutomationProperties.AutomationId="TicketWorkflowChange"
                            ToolTip="Put a different workflow on the ticket" />
                </WrapPanel>

                <WrapPanel x:Name="WorkflowHeader" Margin="0,0,0,4" Visibility="Collapsed">
                    <TextBlock x:Name="WorkflowNameText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,8,0" />
                    <Border x:Name="WorkflowStatusBadge" Padding="6,2" CornerRadius="4"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                        <TextBlock x:Name="WorkflowStatusText" FontSize="11" />
                    </Border>
                </WrapPanel>
                <TextBlock x:Name="WorkflowDescriptionText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,6" />
                <TextBlock x:Name="WorkflowMessageText" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,6" />

                <ItemsControl x:Name="StepsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" Margin="0,0,0,6" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="#FFFFE0B2" Padding="6,2" CornerRadius="4"
                                                VerticalAlignment="Top" Visibility="{Binding InErrorVisibility}"
                                                ToolTip="This step is in error and needs someone to skip or retry it.">
                                            <TextBlock Text="In error" FontSize="11" Foreground="Black" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding TypeName}" FontSize="11" Visibility="{Binding TypeVisibility}"
                                                       ToolTip="{Binding TypeDescription}"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding DescriptionVisibility}" />
                                    <TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Visibility="{Binding NoteVisibility}"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <ItemsControl ItemsSource="{Binding Actions}" Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Name}" Tag="{Binding}" Click="OnActionClicked"
                                                        Margin="0,4,6,0" Padding="10,4"
                                                        ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Name}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Confirmation: names the action, the step and the ticket, and takes
                     optional comments that TeamDynamix adds to the ticket's feed. -->
                <Border x:Name="ConfirmPanel" Visibility="Collapsed" Padding="10" Margin="0,2,0,6" CornerRadius="6"
                        BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundAccentBrush}">
                    <StackPanel>
                        <TextBlock x:Name="ConfirmPromptText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="ConfirmTooltipText" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBox x:Name="ConfirmCommentsBox" AcceptsReturn="True" Height="60" TextWrapping="Wrap" FontSize="13"
                                 Margin="0,8,0,0" ui:ControlHelper.PlaceholderText="Comments (optional)"
                                 AutomationProperties.Name="Comments for the workflow action" />
                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="ConfirmCancelButton" Content="Cancel" Margin="0,0,8,0" Click="OnCancelClicked" />
                                <Button x:Name="ConfirmButton" Style="{DynamicResource AccentButtonStyle}" Click="OnConfirmClicked" />
                            </StackPanel>
                            <ui:ProgressRing x:Name="SubmitProgress" IsActive="False" Visibility="Collapsed" Width="16" Height="16"
                                             HorizontalAlignment="Left" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Change Workflow: the workflows TeamDynamix offers for this ticket,
                     read fresh each time. Continue only opens the confirmation. -->
                <Border x:Name="ChangePanel" Visibility="Collapsed" Padding="10" Margin="0,2,0,6" CornerRadius="6"
                        BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundAccentBrush}">
                    <StackPanel>
                        <TextBlock x:Name="ChangePromptText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="ChangeNoteText" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <ComboBox x:Name="ChangeChoiceBox" Margin="0,8,0,0" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName"
                                  SelectionChanged="OnChangeChoiceChanged" AutomationProperties.Name="New workflow"
                                  AutomationProperties.AutomationId="TicketWorkflowChangeChoice" />
                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="ChangeCancelButton" Content="Cancel" Margin="0,0,8,0" Click="OnChangeCancelClicked"
                                        AutomationProperties.AutomationId="TicketWorkflowChangeCancel" />
                                <Button x:Name="ChangeContinueButton" Content="Continue…" Click="OnChangeContinueClicked"
                                        AutomationProperties.AutomationId="TicketWorkflowChangeContinue" />
                            </StackPanel>
                            <ui:ProgressRing x:Name="ChangeProgress" IsActive="False" Visibility="Collapsed" Width="16" Height="16"
                                             HorizontalAlignment="Left" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ResultBorder" Visibility="Collapsed" Padding="8" Margin="0,0,0,6" CornerRadius="4">
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="13" Foreground="Black" />
                </Border>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
