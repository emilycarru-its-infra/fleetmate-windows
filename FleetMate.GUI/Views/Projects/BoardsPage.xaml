<Page x:Class="FleetMate.GUI.Views.Projects.BoardsPage"
      Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:local="clr-namespace:FleetMate.GUI.Views.Projects"
      Loaded="Page_Loaded">

    <Grid Margin="16,14,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Projects" Style="{StaticResource TitleTextStyle}" />
                <TextBlock Text="Unified task management across all providers" Style="{StaticResource SubtitleTextStyle}" />
            </StackPanel>

            <ui:SimpleStackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="ProviderFilter" 
                          Width="120" 
                          SelectedIndex="0"
                          SelectionChanged="ProviderFilter_SelectionChanged">
                    <ComboBoxItem Content="All Providers" Tag="" />
                    <ComboBoxItem Content="Azure DevOps" Tag="azdo" />
                    <ComboBoxItem Content="GitHub" Tag="github" />
                    <ComboBoxItem Content="Gitea" Tag="gitea" />
                </ComboBox>

                <Button x:Name="RefreshButton" Click="RefreshButton_Click" ToolTip="Refresh">
                    <ui:SymbolIcon Symbol="Refresh" />
                </Button>

                <Button x:Name="SyncButton" Click="SyncButton_Click" ToolTip="Sync to Planner/Markdown (Planner deprecated — use Projects mode)">
                    <ui:SymbolIcon Symbol="Sync" />
                </Button>

                <!-- AzDO SSO Status -->
                <Button x:Name="SsoButton" Click="OnSsoButtonClicked" ToolTip="Azure DevOps SSO"
                        Visibility="Collapsed" Margin="8,0,0,0">
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock x:Name="SsoIcon" Text="🔒" />
                        <TextBlock x:Name="SsoLabel" Text="Sign In" />
                    </ui:SimpleStackPanel>
                </Button>
            </ui:SimpleStackPanel>
        </Grid>

        <!-- Board / List / Projects toggle (separate row, left-aligned) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <RadioButton x:Name="BoardModeRadio" Content="Board" IsChecked="True" 
                         GroupName="ViewMode" Checked="OnViewModeChanged" Style="{StaticResource NavigationTabStyle}" />
            <RadioButton x:Name="ListModeRadio" Content="List" 
                         GroupName="ViewMode" Checked="OnViewModeChanged" Style="{StaticResource NavigationTabStyle}" />
            <RadioButton x:Name="ProjectsModeRadio" Content="Projects" 
                         GroupName="ViewMode" Checked="OnViewModeChanged" Style="{StaticResource NavigationTabStyle}" />
        </StackPanel>

        <!-- Search and filters (Board mode) -->
        <Border x:Name="BoardFilters" Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" 
                         ui:ControlHelper.PlaceholderText="Search tasks..." 
                         Grid.Column="0"
                         TextChanged="SearchBox_TextChanged" />

                <ComboBox x:Name="BucketFilter" 
                          Grid.Column="1" 
                          Width="150" 
                          Margin="8,0,0,0"
                          ui:ControlHelper.PlaceholderText="Bucket"
                          SelectionChanged="BucketFilter_SelectionChanged" />

                <ComboBox x:Name="GroupByCombo"
                          Grid.Column="2"
                          Width="130"
                          Margin="8,0,0,0"
                          SelectionChanged="GroupByCombo_SelectionChanged">
                    <ComboBoxItem Content="State" IsSelected="True" />
                    <ComboBoxItem Content="Area Path" />
                    <ComboBoxItem Content="Iteration" />
                    <ComboBoxItem Content="Type" />
                    <ComboBoxItem Content="Priority" />
                    <ComboBoxItem Content="Assigned To" />
                </ComboBox>

                <CheckBox x:Name="ShowClosedCheckbox" 
                          Grid.Column="3" 
                          Content="Show Closed" 
                          Margin="8,0,0,0"
                          Checked="ShowClosedCheckbox_Changed"
                          Unchecked="ShowClosedCheckbox_Changed" />

                <TextBlock x:Name="TaskCountLabel" 
                           Grid.Column="4" 
                           Margin="16,0,0,0"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Search and filters (List mode) -->
        <Border x:Name="ListFilters" Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="ListSearchBox" 
                         ui:ControlHelper.PlaceholderText="Search work items..." 
                         Grid.Column="0"
                         TextChanged="ListSearchBox_TextChanged" />

                <ComboBox x:Name="ListStateFilter" 
                          Grid.Column="1" 
                          Width="120" 
                          Margin="8,0,0,0"
                          SelectedIndex="0"
                          SelectionChanged="ListStateFilter_SelectionChanged">
                    <ComboBoxItem Content="All States" Tag="" />
                    <ComboBoxItem Content="Active" Tag="Active" />
                    <ComboBoxItem Content="New" Tag="New" />
                    <ComboBoxItem Content="Closed" Tag="Closed" />
                    <ComboBoxItem Content="Resolved" Tag="Resolved" />
                </ComboBox>

                <TextBlock x:Name="ListCountLabel" 
                           Grid.Column="2" 
                           Margin="16,0,0,0"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Kanban Board (Board mode) - columns are computed from the group-by
             dimension, macOS parity, and cards drag between columns to update
             the grouped field. -->
        <ScrollViewer x:Name="KanbanBoard" Grid.Row="3" Margin="0,16,0,0"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="TaskBoardColumnsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="8" Width="270"
                                Margin="0,0,14,0" VerticalAlignment="Top"
                                AllowDrop="True" Drop="OnTaskColumnDrop" DragOver="OnTaskColumnDragOver"
                                Tag="{Binding Title}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="12,10">
                                    <Ellipse Width="10" Height="10" Fill="{Binding Color}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding CountLabel}" Margin="6,0,0,0"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="700">
                                    <ItemsControl ItemsSource="{Binding Tasks}" Margin="8,0,8,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                                                        Padding="10" Margin="0,0,0,8" Cursor="Hand"
                                                        MouseLeftButtonUp="OnTaskCardClick"
                                                        PreviewMouseLeftButtonDown="OnTaskCardPreviewMouseDown"
                                                        MouseMove="OnTaskCardMouseMove"
                                                        Tag="{Binding}">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Open in Browser" Click="OnTaskOpenInBrowser" />
                                                            <MenuItem Header="Copy Link" Click="OnTaskCopyLink" />
                                                            <Separator />
                                                            <MenuItem Header="Set State">
                                                                <MenuItem Header="New" Click="OnTaskSetState" />
                                                                <MenuItem Header="Active" Click="OnTaskSetState" />
                                                                <MenuItem Header="Resolved" Click="OnTaskSetState" />
                                                                <MenuItem Header="Closed" Click="OnTaskSetState" />
                                                            </MenuItem>
                                                            <MenuItem Header="Set Priority">
                                                                <MenuItem Header="Critical" Click="OnTaskSetPriority" />
                                                                <MenuItem Header="High" Click="OnTaskSetPriority" />
                                                                <MenuItem Header="Medium" Click="OnTaskSetPriority" />
                                                                <MenuItem Header="Low" Click="OnTaskSetPriority" />
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap" MaxHeight="56" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Border Background="#203182CE" CornerRadius="3" Padding="5,1" Margin="0,0,6,0"
                                                                    Visibility="{Binding TypeVisibility}">
                                                                <TextBlock Text="{Binding TypeName}" FontSize="10" />
                                                            </Border>
                                                            <TextBlock Text="{Binding ProviderName}" FontSize="10" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding AreaPath}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                                   Visibility="{Binding AreaVisibility}" />
                                                        <TextBlock Text="{Binding Iteration}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                                   Visibility="{Binding IterationVisibility}" />
                                                        <TextBlock Text="{Binding AssigneesLabel}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                                   Visibility="{Binding AssigneesVisibility}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <!-- Work Items List (List mode) -->
        <Border x:Name="WorkItemsList" Grid.Row="3" Margin="0,16,0,0" Visibility="Collapsed">
            <ListView x:Name="WorkItemsListView" 
                      BorderThickness="0"
                      SelectionMode="Single"
                      SelectionChanged="WorkItemsListView_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" Width="70"
                                        DisplayMemberBinding="{Binding Id}" />
                        <GridViewColumn Header="Type" Width="100"
                                        DisplayMemberBinding="{Binding WorkItemType}" />
                        <GridViewColumn Header="Title" Width="350"
                                        DisplayMemberBinding="{Binding Title}" />
                        <GridViewColumn Header="State" Width="100"
                                        DisplayMemberBinding="{Binding State}" />
                        <GridViewColumn Header="Priority" Width="70"
                                        DisplayMemberBinding="{Binding Priority}" />
                        <GridViewColumn Header="Assigned To" Width="180"
                                        DisplayMemberBinding="{Binding AssignedTo}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- GitHub Projects v2 Dynamic Board (Projects mode) -->
        <Border x:Name="ProjectsFilters" Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="ProjectsSearchBox" 
                         ui:ControlHelper.PlaceholderText="Search project items..." 
                         Grid.Column="0"
                         TextChanged="ProjectsSearchBox_TextChanged" />

                <TextBlock x:Name="ProjectsCountLabel" 
                           Grid.Column="1" 
                           Margin="16,0,0,0"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer x:Name="ProjectsBoard" Grid.Row="3" Margin="0,16,0,0" Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ProjectsColumnsPanel" Orientation="Horizontal" />
        </ScrollViewer>

        <!-- Task Detail Sidebar -->
        <local:TaskDetailPanel x:Name="DetailPanel" Grid.Row="3" HorizontalAlignment="Right"
                               Visibility="Collapsed" Margin="16,16,0,0" />

        <!-- Loading Overlay -->
        <Border x:Name="LoadingOverlay" 
                Grid.RowSpan="3" 
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
                Opacity="0.8"
                Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:ProgressRing IsActive="True" Width="40" Height="40" />
                <TextBlock Text="Loading..." Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
