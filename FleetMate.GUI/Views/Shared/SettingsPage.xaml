<Page x:Class="FleetMate.GUI.Views.Shared.SettingsPage"
      Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:terminal="clr-namespace:FleetMate.GUI.Views.Terminal">

    <Grid Margin="24,18,24,24" MaxWidth="980" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextStyle}" />
            <TextBlock x:Name="SettingsSubtitleText" Text="Configure FleetMate" Style="{StaticResource SubtitleTextStyle}" Margin="0,3,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1" x:Name="SettingsTabs" Background="Transparent">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,0,0">
                    <StackPanel Margin="2" MaxWidth="860">
                        <TextBlock Text="General" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
                        <TextBlock x:Name="GeneralSubtitleText" Text="The modules FleetMate shows, setup and configuration storage."
                                   Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,14" />

                        <Border x:Name="ModulesCard" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Enabled Modules" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="Switched-off modules are hidden from the tab bar and stop loading. Their settings are kept, so switching one back on picks up where it left off."
                                           TextWrapping="Wrap" Margin="0,3,0,10"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <StackPanel x:Name="ModulesPanel" AutomationProperties.AutomationId="SettingsModulesPanel" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <DockPanel>
                                <Button Content="Run Setup Wizard…" DockPanel.Dock="Right" VerticalAlignment="Center"
                                        Padding="16,6" Click="OnSetupWizardClicked"
                                        AutomationProperties.AutomationId="SettingsSetupWizardButton" />
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="Setup Wizard" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="Walks through choosing modules and connecting each one."
                                               TextWrapping="Wrap" Margin="0,3,0,0"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Configuration" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                                <TextBlock Text="Desktop configuration store" FontSize="12"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBox x:Name="ConfigPathTextBox" IsReadOnly="True" Margin="0,5,0,0"
                                         Text="HKCU\SOFTWARE\FleetMate" />
                                <TextBlock Text="Only non-secret endpoints and identifiers are read here. Tokens are acquired from the signed-in Windows user."
                                           TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Authentication">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,0,0">
                    <StackPanel Margin="2" MaxWidth="860">
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Content="Refresh All" Padding="12,5"
                                    Click="OnRefreshAuthClicked" />
                            <StackPanel>
                                <TextBlock Text="Authentication" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
                                <TextBlock Text="Service endpoints, sign-in state, and credentials."
                                           Style="{StaticResource SubtitleTextStyle}" />
                            </StackPanel>
                        </DockPanel>

                        <Border x:Name="GraphCard" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Microsoft Graph" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Tenant ID" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                        <TextBox x:Name="TenantIdTextBox" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Client ID" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                        <TextBox x:Name="ClientIdTextBox" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Uses your Windows account broker session; no client secret is stored."
                                           TextWrapping="Wrap" Margin="0,9,0,0" FontSize="11"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="DevOpsCard" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Azure DevOps" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Organization" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                        <TextBox x:Name="AdoOrgTextBox" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Project" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                        <TextBox x:Name="AdoProjectTextBox" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="SnipeCard" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,5,10">
                                <StackPanel>
                                    <TextBlock Text="Snipe-IT" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                                    <TextBlock Text="Base URL" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <TextBox x:Name="SnipeUrlTextBox" Margin="0,4,0,0" />
                                    <TextBlock Text="Uses your Entra session; no API key required." TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="TdxCard" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="5,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="TeamDynamix" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                                    <TextBlock Text="Base URL" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <TextBox x:Name="TdxUrlTextBox" Margin="0,4,0,0" />
                                    <TextBlock Text="Ticketing App ID" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,8,0,0" />
                                    <TextBox x:Name="TdxAppIdTextBox" Margin="0,4,0,0" />
                                    <TextBlock Text="Signs in with your Entra account." TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="ReportMateCard" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="ReportMate" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                                <TextBlock Text="API URL" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBox x:Name="ReportMateUrlTextBox" Margin="0,4,0,0" />
                                <TextBlock Text="Uses a brokered Entra bearer; no passphrase is stored."
                                           TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="HandbookCard" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Handbook and Skills" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                                <TextBlock Text="Handbook repository" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBox x:Name="HandbookRepoUrlTextBox" Margin="0,4,0,0"
                                         ui:ControlHelper.PlaceholderText="Git clone URL of the Handbook repository"
                                         AutomationProperties.Name="Handbook repository" />
                                <TextBlock Text="Handbook site" Margin="0,8,0,0" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBox x:Name="HandbookSiteUrlTextBox" Margin="0,4,0,0"
                                         ui:ControlHelper.PlaceholderText="Address of the published Handbook, for its links and images"
                                         AutomationProperties.Name="Handbook site" />
                                <TextBlock Text="Skills repository" Margin="0,8,0,0" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBox x:Name="AgentsHubRepoUrlTextBox" Margin="0,4,0,0"
                                         ui:ControlHelper.PlaceholderText="Git clone URL of the shared agent skills"
                                         AutomationProperties.Name="Skills repository" />
                                <TextBlock Text="The Handbook reader, its search results and cards, and the shared skills appear once these are set. Leave one empty to use the managed value."
                                           TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>

                        <Button Content="Save Settings" HorizontalAlignment="Right" Margin="0,2,0,18"
                                Style="{StaticResource AccentButtonStyle}" Padding="22,7" Click="OnSaveClicked" />

                        <TextBlock Text="Authentication Status" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />
                        <StackPanel x:Name="AuthCardsPanel" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Manage" x:Name="ManageTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,0,0">
                    <StackPanel Margin="2" MaxWidth="860">
                        <TextBlock Text="Manage" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="Where the Manage tab finds the fleet, and how it opens sessions to machines."
                                   Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,14" />

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Fleet data" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                                <TextBlock Text="Roster (computers.csv)" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <DockPanel Margin="0,4,0,10">
                                    <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Click="OnBrowseRoster" />
                                    <TextBox x:Name="ManageRosterPathTextBox" ui:ControlHelper.PlaceholderText="Path to the enrollment roster CSV" />
                                </DockPanel>
                                <TextBlock Text="Command library (commands.yaml)" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <DockPanel Margin="0,4,0,10">
                                    <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Click="OnBrowseCommands" />
                                    <TextBox x:Name="ManageCommandsPathTextBox" ui:ControlHelper.PlaceholderText="Leave empty for the per-user library" />
                                </DockPanel>
                                <CheckBox x:Name="ManageIncludeRetiredCheckBox" Content="Show machines that have left service (returned, donated, recycled)" Margin="0,2,0,2" />
                                <CheckBox x:Name="ManageIncludeProvisioningCheckBox" Content="Show the Provisioning catalog as a lab section" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="SSH" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                                <TextBlock Text="Private key" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <DockPanel Margin="0,4,0,10">
                                    <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Click="OnBrowseSshKey" />
                                    <TextBox x:Name="SecureShellKeyPathTextBox" ui:ControlHelper.PlaceholderText="~\.ssh\id_rsa.fleetadmin" />
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="SSH user" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                        <TextBox x:Name="SecureShellUserTextBox" Margin="0,4,0,0" ui:ControlHelper.PlaceholderText="fleetadmin" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Windows Terminal profile" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                        <TextBox x:Name="ManageTerminalProfileTextBox" Margin="0,4,0,0" ui:ControlHelper.PlaceholderText="Default profile" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="SshKeyStatusText" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Remote Desktop" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                                <TextBlock Text="Username" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBox x:Name="ManageRdpUserTextBox" Margin="0,4,0,0" ui:ControlHelper.PlaceholderText="Leave empty to use the SSH user" />
                                <TextBlock Text="Stored password" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,10,0,0" />
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Content="Clear" Margin="8,0,0,0" Click="OnClearRdpPassword" x:Name="ClearRdpPasswordButton" />
                                    <Button DockPanel.Dock="Right" Content="Save password" Margin="8,0,0,0" Click="OnSaveRdpPassword" />
                                    <PasswordBox x:Name="RdpPasswordBox" ui:ControlHelper.PlaceholderText="Password for the Remote Desktop account" />
                                </DockPanel>
                                <TextBlock x:Name="RdpCredentialStatusText" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>

                        <Button Content="Save Settings" HorizontalAlignment="Right" Margin="0,2,0,18"
                                Style="{StaticResource AccentButtonStyle}" Padding="22,7" Click="OnSaveClicked" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Enrollment" x:Name="EnrollmentTab" Loaded="OnEnrollmentTabLoaded"
                     AutomationProperties.AutomationId="SettingsEnrollmentTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,0,0">
                    <StackPanel Margin="2" MaxWidth="860">
                        <TextBlock Text="Enrollment" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="Where the enrollment records joined into Devices come from, so devices that are registered but not yet enrolled show up too."
                                   Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Enrollment Records" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                                <StackPanel x:Name="EnrollmentSourcesPanel" />
                                <TextBlock Text="Enrollment records appear in Devices beside each device's management record. Switch Enrollment off in General to stop reading them."
                                           TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Apple School and Business Manager" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />
                                <TextBlock Text="Every organization is read. Each API profile is kept in Windows Credential Manager for your account, never in a file or policy."
                                           TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <ListBox x:Name="AppleProfilesList" MinHeight="60" MaxHeight="220" />
                                <TextBlock x:Name="AppleProfilesEmptyText" Text="No profiles yet."
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,4,0,0" />
                                <Button Content="Remove selected" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnRemoveAppleProfile" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Add a profile" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                                <TextBlock Text="Name" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBox x:Name="AppleProfileNameBox" Margin="0,4,0,10" ui:ControlHelper.PlaceholderText="A name for this organization" />
                                <TextBlock Text="Client ID" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBox x:Name="AppleClientIdBox" Margin="0,4,0,10" ui:ControlHelper.PlaceholderText="SCHOOLAPI.… or BUSINESSAPI.…" />
                                <TextBlock Text="Key ID" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBox x:Name="AppleKeyIdBox" Margin="0,4,0,10" />
                                <TextBlock Text="Private key (.p8 or .pem)" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <DockPanel Margin="0,4,0,10">
                                    <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Click="OnBrowseAppleKey" />
                                    <TextBox x:Name="AppleKeyPathBox" IsReadOnly="True" ui:ControlHelper.PlaceholderText="The key file Apple issued with the API account" />
                                </DockPanel>
                                <Button Content="Add Profile" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}" Click="OnAddAppleProfile" />
                                <TextBlock x:Name="AppleProfileStatusText" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Terminal" x:Name="TerminalTab" AutomationProperties.AutomationId="SettingsTerminalTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,0,0">
                    <StackPanel Margin="2" MaxWidth="860">
                        <TextBlock Text="Terminal" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="The terminal panel (Ctrl+`) runs a shell or a coding agent beside any tab. Every session gets FLEETMATE_CONTEXT, a JSON file describing what is selected in the app, FLEETMATE_AGENT_BRIEF, a guide to every fleetmate command with where the session opened at the top, and the fleetmate CLI on PATH. Codex and Claude sessions are given the guide at start, and open in the repository you are working in."
                                   Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Sessions" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                                <TextBlock Text="Runs" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <ComboBox x:Name="AgentCommandPicker" Margin="0,4,0,0" MinWidth="240" HorizontalAlignment="Left"
                                          DisplayMemberPath="Label" SelectedValuePath="Key"
                                          SelectionChanged="OnAgentCommandPickerChanged"
                                          AutomationProperties.AutomationId="AgentCommandPicker" />
                                <TextBox x:Name="AgentCustomCommandTextBox" Margin="0,6,0,0" MinWidth="360" HorizontalAlignment="Left"
                                         Visibility="Collapsed" FontFamily="Cascadia Mono, Consolas"
                                         ui:ControlHelper.PlaceholderText="Program and arguments, e.g. my-agent --model fast"
                                         AutomationProperties.AutomationId="AgentCustomCommandTextBox" />
                                <TextBlock x:Name="AgentCommandSourceText" FontSize="11" Margin="0,4,0,10" Visibility="Collapsed"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <CheckBox x:Name="AgentAutoStartCheckBox" AutomationProperties.AutomationId="AgentAutoStartCheckBox"
                                          Content="Open a session when FleetMate starts" Margin="0,6,0,0" />
                                <TextBlock x:Name="AgentAutoStartSourceText" FontSize="11" Margin="28,2,0,0" Visibility="Collapsed"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <terminal:AgentCliUpdatesPanel />
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Repos" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                                <TextBlock Text="One per line: a local folder, or a clone URL that is cloned under your FleetMate repos folder the first time you open it. The terminal's new-session menu offers a session in each."
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" />
                                <TextBox x:Name="ReposTextBox" AutomationProperties.AutomationId="ReposTextBox"
                                         AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="110" Margin="0,6,0,6"
                                         FontFamily="Cascadia Mono, Consolas" VerticalScrollBarVisibility="Auto" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Reset to defaults" Click="OnResetReposClicked"
                                            AutomationProperties.AutomationId="ResetReposButton" />
                                    <TextBlock x:Name="RepoDefaultsText" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Button Content="Save Settings" HorizontalAlignment="Right" Margin="0,2,0,18"
                                Style="{StaticResource AccentButtonStyle}" Padding="22,7" Click="OnSaveClicked" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,0,0">
                    <StackPanel Margin="2" MaxWidth="860">
                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
                        <TextBlock x:Name="AppearanceSubtitleText" Text="Choose how FleetMate looks on this PC."
                                   Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,14" />
                        <Border Style="{StaticResource CardStyle}">
                            <DockPanel>
                                <ComboBox x:Name="ThemeComboBox" DockPanel.Dock="Right" Width="180"
                                          SelectionChanged="OnThemeSelectionChanged">
                                    <ComboBoxItem Content="Use system setting" Tag="System" />
                                    <ComboBoxItem Content="Light" Tag="Light" />
                                    <ComboBoxItem Content="Dark" Tag="Dark" />
                                </ComboBox>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="Changes are applied immediately."
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="TextSizeResetButton" Content="Reset" DockPanel.Dock="Right"
                                            VerticalAlignment="Center" Click="OnTextSizeResetClicked" />
                                    <TextBlock x:Name="TextSizeLabel" DockPanel.Dock="Right" VerticalAlignment="Center"
                                               Margin="0,0,12,0" FontFamily="Consolas" Text="100%" />
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="Text size" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="Scales the text in every tab. The toolbar and terminal keep their size."
                                                   TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </StackPanel>
                                </DockPanel>
                                <Slider x:Name="TextSizeSlider" Margin="0,12,0,0" Minimum="0.9" Maximum="1.6"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                        ValueChanged="OnTextSizeChanged"
                                        AutomationProperties.AutomationId="SettingsTextSizeSlider" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,8,0,10">
                            <StackPanel>
                                <TextBlock Text="Preview" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                                <Separator />
                                <TextBlock Text="Add display reconciliation blueprint" FontWeight="SemiBold" Margin="0,10,0,2" />
                                <TextBlock Text="Ada Lovelace request !4821 into Platform/Inventory"
                                           FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <Separator Margin="0,10,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Primary action" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" />
                                    <Button Content="Secondary action" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

