<Window x:Class="FleetMate.GUI.Views.Shared.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:FleetMate.GUI.ViewModels"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        Title="FleetMate"
        Icon="/Assets/FleetMate.ico"
        Height="850"
        Width="1400"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- TextElement.Foreground: a bare WPF TextBlock defaults to black no matter
         the theme, so in dark mode every TextBlock without an explicit Foreground
         disappears. Setting the inherited foreground here fixes all of them. -->
    <Grid Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          TextElement.Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Centered, segmented top navigation. The equal outer columns keep it
             centered even when window actions are added on the right. -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1" Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1" CornerRadius="9"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1" Padding="2">
                    <StackPanel Orientation="Horizontal" x:Name="TabBar">
                        <RadioButton x:Name="TabDashboard" Tag="Dashboard" GroupName="MainTabs"
                                     IsChecked="True" Checked="OnTabChecked" Style="{StaticResource NavigationTabStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE80F;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabDevices" Tag="Devices" GroupName="MainTabs"
                                     Checked="OnTabChecked" Style="{StaticResource NavigationTabStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE7F8;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Devices" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabInventory" Tag="Inventory" GroupName="MainTabs"
                                     Checked="OnTabChecked" Style="{StaticResource NavigationTabStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE7B8;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Inventory" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabTickets" Tag="Tickets" GroupName="MainTabs"
                                     Checked="OnTabChecked" Style="{StaticResource NavigationTabStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE8EA;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Tickets" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabBoards" Tag="Projects" GroupName="MainTabs"
                                     Checked="OnTabChecked" Style="{StaticResource NavigationTabStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE762;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Projects" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabIdentity" Tag="Identity" GroupName="MainTabs"
                                     Checked="OnTabChecked" Style="{StaticResource NavigationTabStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE716;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Identity" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <RadioButton Grid.Column="2" x:Name="TabSettings" ToolTip="Settings"
                             shell:WindowChrome.IsHitTestVisibleInChrome="True"
                             Tag="Settings" GroupName="MainTabs" Checked="OnTabChecked"
                             Style="{StaticResource NavigationTabStyle}"
                             HorizontalAlignment="Right" Margin="0,0,116,0">
                    <ui:FontIcon Glyph="&#xE713;" FontSize="14" />
                </RadioButton>
            </Grid>
        </Border>

        <!-- Content Frame -->
        <Frame Grid.Row="1" x:Name="ContentFrame" NavigationUIVisibility="Hidden" Background="Transparent" />
    </Grid>
</Window>
