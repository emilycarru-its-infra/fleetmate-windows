<Window x:Class="FleetMate.GUI.Views.Shared.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:FleetMate.GUI.ViewModels"
        xmlns:term="clr-namespace:FleetMate.GUI.Views.Terminal"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        Title="FleetMate"
        Icon="/Assets/FleetMate.ico"
        Height="850"
        Width="1400"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- TextElement.Foreground: a bare WPF TextBlock defaults to black no matter
         the theme, so in dark mode every TextBlock without an explicit Foreground
         disappears. Setting the inherited foreground here fixes all of them. -->
    <Grid x:Name="RootGrid" Background="{DynamicResource AppBackgroundBrush}"
          TextElement.Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition x:Name="ContentRow" Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="TerminalRow" Height="0" />
        </Grid.RowDefinitions>

        <!-- Centered, segmented top navigation. The equal outer columns keep it
             centered even when window actions are added on the right. -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1" Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="TabBarBorder" Grid.Column="1" CornerRadius="9"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1" Padding="2">
                    <StackPanel Orientation="Horizontal" x:Name="TabBar">
                        <RadioButton x:Name="TabDevelopment" Tag="Development" GroupName="FleetMateTabs" IsChecked="True"
                                     Checked="OnTabChecked" Style="{StaticResource NavigationTabStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE943;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <!-- No count here: tabs and segments never carry a number. -->
                                <TextBlock Text="Development" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabBoards" Tag="Projects" GroupName="FleetMateTabs"
                                     Checked="OnTabChecked" Style="{StaticResource NavigationTabStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xF0E3;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="Projects" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabDevices" Tag="Devices" GroupName="FleetMateTabs"
                                     Checked="OnTabChecked" Style="{StaticResource NavigationTabStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE7F8;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="Devices" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabReporting" Tag="Reporting" GroupName="FleetMateTabs"
                                     Checked="OnTabChecked" Style="{StaticResource NavigationTabStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE9F9;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="Reporting" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabManage" Tag="Manage" GroupName="FleetMateTabs"
                                     Checked="OnTabChecked" Style="{StaticResource NavigationTabStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xEC7A;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="Manage" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabInventory" Tag="Inventory" GroupName="FleetMateTabs"
                                     Checked="OnTabChecked" Style="{StaticResource NavigationTabStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xF158;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="Inventory" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabIdentity" Tag="Identity" GroupName="FleetMateTabs"
                                     Checked="OnTabChecked" Style="{StaticResource NavigationTabStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE716;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="Identity" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabTickets" Tag="Tickets" GroupName="FleetMateTabs"
                                     Checked="OnTabChecked" Style="{StaticResource NavigationTabStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE8EC;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="Tickets" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Auth status + settings live in the chrome so they are reachable
                     from any tab, matching the macOS toolbar. -->
                <!-- The right margin clears the three 46-wide caption buttons (138)
                     less the bar's 12 padding, plus a 6 gap, so search ends
                     just before Minimize. -->
                <StackPanel x:Name="ToolbarRight" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,0,132,0">
                    <!-- Elevation session status. The per-user session container
                         takes a while to boot and lives for its TTL, so the chrome
                         says whether the next elevated action will wait on it.
                         Click to re-check; it starts sessions that are not running. -->
                    <Button x:Name="ElevationButton" Click="OnElevationClicked" Visibility="Collapsed"
                            AutomationProperties.AutomationId="ElevationButton" AutomationProperties.Name="Elevation"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource ChromeIconButtonStyle}" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ElevationDot" Width="8" Height="8" Fill="Gray"
                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="ElevationText" Text="Elevation" FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="TerminalToggleButton" ToolTip="Terminal (Ctrl+`)" Click="OnTerminalToggleClicked"
                                  AutomationProperties.AutomationId="TerminalToggleButton"
                                  AutomationProperties.Name="Terminal"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                  Background="Transparent" BorderThickness="0" Padding="8,5" Margin="0,0,4,0">
                        <ui:FontIcon Glyph="&#xE756;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                    </ToggleButton>
                    <!-- Graphs: shows or hides this tab's widget strip (Ctrl+Alt+G).
                         Accent while shown, secondary while hidden; absent on tabs
                         with no widgets. -->
                    <Button x:Name="GraphsButton" Click="OnGraphsClicked" Visibility="Collapsed"
                            AutomationProperties.AutomationId="GraphsButton" AutomationProperties.Name="Graphs"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource ChromeIconButtonStyle}" Margin="0,0,4,0">
                        <ui:FontIcon x:Name="GraphsIcon" Glyph="&#xE9D2;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                    </Button>
                    <!-- Recent Activity: what changed on this tab, from any tab. The
                         orange dot marks an app-level error, shown at the popover's top. -->
                    <Button x:Name="RecentActivityButton" ToolTip="Recent activity" Click="OnRecentActivityClicked"
                            AutomationProperties.AutomationId="RecentActivityButton"
                            AutomationProperties.Name="Recent Activity"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource ChromeIconButtonStyle}" Margin="0,0,4,0">
                        <Grid>
                            <ui:FontIcon Glyph="&#xE81C;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                            <Ellipse x:Name="AppErrorDot" Width="7" Height="7" Fill="#E07A1F" Visibility="Collapsed"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0" />
                        </Grid>
                    </Button>
                    <Button x:Name="AuthButton" ToolTip="Authentication status" Click="OnAuthClicked"
                            AutomationProperties.AutomationId="AuthButton" AutomationProperties.Name="Authentication"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource ChromeIconButtonStyle}">
                        <ui:FontIcon Glyph="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                    </Button>
                    <!-- Settings opens its own window, like the Mac app's, so the
                         tab underneath stays put and Close or Esc returns to it. -->
                    <Button x:Name="SettingsButton" ToolTip="Settings (Ctrl+,)" Click="OnSettingsClicked"
                            AutomationProperties.AutomationId="SettingsButton" AutomationProperties.Name="Settings"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource ChromeIconButtonStyle}" Margin="4,0,0,0">
                        <ui:FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                    </Button>
                    <!-- The one search field: last in the toolbar on every tab. The
                         chip inside it says what it searches: the tab's own list
                         (Ctrl+F) or everything (Ctrl+K); clicking the chip switches.
                         Enter opens the first hit, Esc clears. In a narrow window it
                         narrows before the tab bar gives up any room
                         (MainWindow.Toolbar.cs). -->
                    <Grid x:Name="SearchField" Width="320" Height="28" Margin="8,0,0,0" VerticalAlignment="Center"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBox x:Name="SearchBox" AutomationProperties.AutomationId="ToolbarSearchBox"
                                 AutomationProperties.Name="Search" MinHeight="28" Height="28" FontSize="12"
                                 Padding="28,4,60,0" VerticalContentAlignment="Center"
                                 BorderThickness="1"
                                 BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                 Background="{DynamicResource CardBackgroundBrush}"
                                 ui:ControlHelper.PlaceholderText="Search everything"
                                 ui:ControlHelper.PlaceholderForeground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                 TextChanged="OnSearchTextChanged" PreviewKeyDown="OnSearchKeyDown" />
                        <ui:FontIcon x:Name="SearchGlyph" Glyph="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0"
                                     IsHitTestVisible="False"
                                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <!-- Takes the magnifier's place while a search runs. -->
                        <ui:ProgressRing x:Name="SearchBusyRing" Width="13" Height="13" IsActive="False"
                                         Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Margin="9,0,0,0" IsHitTestVisible="False"
                                         AutomationProperties.AutomationId="ToolbarSearchBusy"
                                         AutomationProperties.Name="Searching" />
                        <Button x:Name="SearchScopeChip" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="28,0,0,0" Padding="7,0" Height="20" MinHeight="0" MinWidth="0" FontSize="11"
                                AutomationProperties.AutomationId="ToolbarSearchScopeChip"
                                AutomationProperties.Name="Search scope"
                                Click="OnSearchScopeChipClicked" SizeChanged="OnSearchScopeChipSizeChanged"
                                ToolTip="Switch between this tab's list and everything"
                                Background="{DynamicResource SubtleFillBrush}" BorderThickness="0" Content="All" />
                        <Border x:Name="SearchHint" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,6,0" Padding="5,0" CornerRadius="3" IsHitTestVisible="False"
                                BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                            <TextBlock x:Name="SearchHintText" Text="Ctrl+K" FontSize="10"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </Border>
                        <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}"
                               Placement="Bottom" HorizontalOffset="-300" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Width="560" MaxHeight="620"
                                    TextElement.Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
                                    <StackPanel x:Name="SearchResults" Margin="8" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <Popup x:Name="RecentActivityPopup" PlacementTarget="{Binding ElementName=RecentActivityButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Width="480" MaxHeight="600"
                                TextElement.Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
                            <DockPanel Margin="16">
                                <Border x:Name="AppErrorBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                                        Background="#33E07A1F" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Dismiss" FontSize="11" Padding="8,1"
                                                Click="OnDismissAppErrorClicked" VerticalAlignment="Top" />
                                        <TextBlock x:Name="AppErrorText" FontSize="12" TextWrapping="Wrap" Margin="0,0,8,0" />
                                    </DockPanel>
                                </Border>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <CheckBox x:Name="RecentActivityHideMine" DockPanel.Dock="Right" Content="Hide mine"
                                              FontSize="11" MinWidth="0" Visibility="Collapsed"
                                              Checked="OnRecentActivityHideMineChanged" Unchecked="OnRecentActivityHideMineChanged" />
                                    <TextBlock x:Name="RecentActivityHeader" FontWeight="SemiBold" FontSize="14"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <Button DockPanel.Dock="Bottom" Content="Activity Log" HorizontalAlignment="Left"
                                        Margin="0,10,0,0" Click="OnActivityLogClicked" ToolTip="Activity Log (Ctrl+Shift+L)"
                                        AutomationProperties.AutomationId="ActivityLogButton" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                                    <StackPanel x:Name="RecentActivityList" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                    <Popup x:Name="AuthPopup" PlacementTarget="{Binding ElementName=AuthButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Width="480" MaxHeight="600"
                                TextElement.Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="580">
                                <StackPanel x:Name="AuthSystemsPanel" Margin="16" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Frame -->
        <Frame Grid.Row="1" x:Name="ContentFrame" NavigationUIVisibility="Hidden" Background="Transparent" />

        <!-- Agent terminal: reachable from every tab, resized by dragging the splitter. -->
        <!-- The divider is a Thumb, not a GridSplitter: its height comes from
             the pointer's position in the window, so it tracks smoothly, and
             dragging it near the top switches to full-window mode. -->
        <Thumb x:Name="TerminalDivider" Grid.Row="2" Height="5" Cursor="SizeNS" Visibility="Collapsed"
               AutomationProperties.AutomationId="TerminalDivider"
               DragStarted="OnDividerDragStarted" DragDelta="OnDividerDragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        <term:TerminalPanel x:Name="Terminal" Grid.Row="3" Visibility="Collapsed" />
    </Grid>
</Window>
