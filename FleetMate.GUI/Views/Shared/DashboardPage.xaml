<Page x:Class="FleetMate.GUI.Views.Shared.DashboardPage"
      Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:local="clr-namespace:FleetMate.GUI.Views.Shared"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fixed page header -->
        <StackPanel Grid.Row="0" Margin="16,14,16,10">
            <!-- Header. The search sits over the header, centred on the page rather
                 than between the title and the buttons. -->
            <Grid x:Name="HeaderGrid" Margin="0,0,0,6" SizeChanged="OnHeaderSizeChanged">
                <DockPanel>
                    <StackPanel x:Name="HeaderActions" SizeChanged="OnHeaderSizeChanged" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <ui:ProgressRing x:Name="HeaderProgress" IsActive="True" Width="18" Height="18"
                                         Margin="0,0,8,0" Visibility="Collapsed" />
                        <Button Click="OnRefreshClicked" Margin="0,0,4,0"
                                Style="{StaticResource ChromeIconButtonStyle}" ToolTip="Refresh dashboard">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE72C;" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="HeaderTitle" HorizontalAlignment="Left" SizeChanged="OnHeaderSizeChanged">
                        <TextBlock Text="Dashboard" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,2" />
                        <TextBlock Text="Fleet overview across all connected systems" Style="{StaticResource SubtitleTextStyle}" />
                    </StackPanel>
                </DockPanel>

                <!-- Search everything: scans the loaded caches; results drop
                     below at the same width and close on a click outside. At
                     most 700 wide, narrower when the title or buttons need the
                     room (OnHeaderSizeChanged). -->
                <TextBox x:Name="GlobalSearchBox" Width="700" HorizontalAlignment="Center" Height="36" FontSize="14"
                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                         ui:ControlHelper.PlaceholderText="Search everything — serial, hostname, user, ticket…"
                         TextChanged="OnGlobalSearchChanged" GotKeyboardFocus="OnGlobalSearchFocused"
                         PreviewKeyDown="OnGlobalSearchKeyDown" />
                <Popup x:Name="GlobalSearchPopup" PlacementTarget="{Binding ElementName=GlobalSearchBox}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       VerticalOffset="4" Width="{Binding ActualWidth, ElementName=GlobalSearchBox}">
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="6">
                        <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="GlobalSearchResults" />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>

            <!-- Error Banner -->
            <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="#33FF6600" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dismiss" Click="OnDismissErrorClicked"
                            VerticalAlignment="Center" Margin="12,0,0,0" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:FontIcon Glyph="&#xE7BA;" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock x:Name="ErrorBannerText" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Alert Pills -->
            <WrapPanel x:Name="AlertPillsPanel" Margin="0,0,0,6" />

            <!-- Loading indicator -->
            <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Margin="0,0,0,6" Visibility="Collapsed">
                <ui:ProgressRing IsActive="True" Width="20" Height="20" />
                <TextBlock Text="Loading dashboard data..." Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>

        </StackPanel>

        <!-- A disconnected dashboard is one deliberate state, not several empty widgets. -->
        <Border Grid.Row="1" x:Name="ConnectServicesPrompt" Visibility="Collapsed"
                Style="{StaticResource CardStyle}" Margin="16,0,16,16"
                VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
                <Border Width="64" Height="64" CornerRadius="32" Margin="0,0,0,16"
                        Background="{DynamicResource SubtleFillBrush}">
                    <ui:FontIcon Glyph="&#xE968;" FontSize="30" HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </Border>
                <TextBlock Text="No services connected" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Connect your IT systems to see fleet health, pull requests, and recent activity."
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,16"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <Button Content="Open Settings" Padding="18,7" Click="OnOpenSettingsClicked" />
            </StackPanel>
        </Border>

        <!-- Mac-parity workspace: operational content on the left, activity rail on the right. -->
        <Grid Grid.Row="1" x:Name="DashboardContent" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" MinWidth="520" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Main operational canvas -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,12,0">
                    <!-- Pull requests and work items sit side by side, like the macOS dashboard. -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:PullRequestQueueView x:Name="PullRequestQueue" Grid.Column="0" Height="420" Margin="0,0,7,0" />
                        <local:DashboardTasksView x:Name="DashboardTasks" Grid.Column="1" Height="420" Margin="7,0,0,0" />
                    </Grid>
                    <WrapPanel x:Name="KpiStrip" Margin="0,0,0,4" />
                    <WrapPanel x:Name="ChartGrid" />
                </StackPanel>
            </ScrollViewer>

            <!-- Divider -->
            <Rectangle Grid.Column="1" Width="1" Margin="8,0"
                       Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />

            <!-- Recent activity rail -->
            <Grid Grid.Column="2" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Activity title -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Recent Activity" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Filter chips -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                    <StackPanel x:Name="ActivityFilterPanel" Orientation="Horizontal" />
                </ScrollViewer>

                <!-- Feed fills remaining height -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="ActivityScrollViewer">
                        <StackPanel>
                            <ItemsControl x:Name="ActivityFeed">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                BorderThickness="0,0,0,0.5" Padding="10,5" Cursor="Hand"
                                                MouseLeftButtonUp="OnActivityItemClicked" Tag="{Binding Tab}">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Time}" DockPanel.Dock="Right" FontSize="10"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                <!-- Item name trims; the pill and admin keep their room. -->
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" MaxWidth="140" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}" FontSize="12" Margin="0,0,6,0"
                                                                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <Border Grid.Column="2" CornerRadius="8" Padding="6,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Pill}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Pill}" FontSize="10" />
                                                    </Border>
                                                    <TextBlock Grid.Column="3" Text="{Binding Context}" FontSize="11" Margin="6,0,0,0"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate>
                                                            <TextBlock Text="Activity will appear once data loads." Padding="10,8"
                                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
