<Window x:Class="FleetMate.GUI.Views.Shared.ActivityLogWindow"
        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Activity Log"
        Width="1000" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Copy Masked" Click="OnCopyMasked" Margin="8,0,0,0"
                        ToolTip="Copy the shown entries with serials, UDIDs and hardware addresses replaced" />
                <Button Content="Export Masked…" Click="OnExportMasked" Margin="8,0,0,0"
                        ToolTip="Save the shown entries with serials, UDIDs and hardware addresses replaced" />
                <Button Content="Clear" Click="OnClear" Margin="8,0,0,0" ToolTip="Empty the activity log" />
            </StackPanel>
            <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged"
                     ui:ControlHelper.PlaceholderText="Search by serial, action or path"
                     AutomationProperties.Name="Search by serial, action or path" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                   Text="Kept in memory only and cleared when FleetMate quits. Headers, query strings and request bodies are never recorded." />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="160" />
                <RowDefinition Height="5" />
                <RowDefinition Height="2*" MinHeight="120" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="ActionsGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None"
                      SelectionChanged="OnActionSelected" AutomationProperties.AutomationId="ActivityActions">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80" />
                    <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="130" />
                    <DataGridTemplateColumn Header="Action" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Opacity="{Binding TitleOpacity}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Serials" Binding="{Binding Serials}" Width="*" />
                    <DataGridTextColumn Header="Requests" Binding="{Binding RequestCount}" Width="75" />
                    <DataGridTemplateColumn Header="Result" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Result}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                    <Setter Property="Foreground" Value="#E07A1F" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Height="5" Background="Transparent" />
            <Grid Grid.Row="2">
                <DataGrid x:Name="RequestsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          AutomationProperties.AutomationId="ActivityRequests">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="70" />
                        <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="*" />
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="3*" />
                        <DataGridTemplateColumn Header="Status" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                    <Setter Property="Foreground" Value="#E07A1F" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="RequestsPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.7" Text="Select an action to see its requests." />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
