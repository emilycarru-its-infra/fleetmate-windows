<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <!-- List and table rows, app-wide, in the Mac's look: flat fills, no
         gradients, no borders. A focused list's selection is an accent fill
         with white text, an unfocused one a subdued grey with normal text,
         hover a faint tint, and alternate rows a faint stripe.

         The row templates are replaced outright. A style that sets no
         template inherits the stock Windows one, whose glossy selection and
         white hover gradient this replaces.

         The Fleet*Row brushes are set in code by ListRowPalette for the
         current theme, accent and contrast setting; see App.ApplyPaletteBrushes. -->

    <Style x:Key="FleetListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FleetRowHoverBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="Selector.IsSelectionActive" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FleetRowSelectedInactiveBrush}" />
                            <Setter TargetName="Chrome" Property="TextElement.Foreground" Value="{DynamicResource FleetRowSelectedInactiveForegroundBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="Selector.IsSelectionActive" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FleetRowSelectedBrush}" />
                            <Setter TargetName="Chrome" Property="TextElement.Foreground" Value="{DynamicResource FleetRowSelectedForegroundBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource FleetRowStripeBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The same rows for ListView. One template serves both a plain list
         and a GridView table: a table's rows get the GridView's columns,
         and a plain list's rows show their content. -->
    <Style x:Key="FleetListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <Grid>
                            <GridViewRowPresenter x:Name="Cells"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}"
                                                  Content="{TemplateBinding Content}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <ContentPresenter x:Name="Content" Visibility="Collapsed"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="GridView.ColumnCollection" Value="{x:Null}">
                            <Setter TargetName="Cells" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Content" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FleetRowHoverBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="Selector.IsSelectionActive" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FleetRowSelectedInactiveBrush}" />
                            <Setter TargetName="Chrome" Property="TextElement.Foreground" Value="{DynamicResource FleetRowSelectedInactiveForegroundBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="Selector.IsSelectionActive" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FleetRowSelectedBrush}" />
                            <Setter TargetName="Chrome" Property="TextElement.Foreground" Value="{DynamicResource FleetRowSelectedForegroundBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource FleetRowStripeBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Every list and table in the app gets these rows, including lists
         whose markup names no item style, and item styles that build on
         {x:Type ListBoxItem} or {x:Type ListViewItem}. -->
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource FleetListBoxItemStyle}" />
    <Style TargetType="ListViewItem" BasedOn="{StaticResource FleetListViewItemStyle}" />

    <!-- The stock WPF DataGrid paints a white body, white headers, and
         black text regardless of the ModernWPF theme, so every surface
         it owns is restated in theme brushes here. -->
    <Style x:Key="FleetDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Cells stay transparent and take the row's text colour: the row,
         not each cell, shows hover and selection, so a selected row is one
         rounded fill rather than a run of boxes. The Foreground binding also
         overrides the stock theme's own selected-cell text colours. -->
    <Style x:Key="FleetDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="8,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FleetDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <p:SelectiveScrollingGrid>
                            <p:SelectiveScrollingGrid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </p:SelectiveScrollingGrid.ColumnDefinitions>
                            <p:SelectiveScrollingGrid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </p:SelectiveScrollingGrid.RowDefinitions>
                            <p:DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <p:DataGridDetailsPresenter Grid.Column="1" Grid.Row="1"
                                                        p:SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        Visibility="{TemplateBinding DetailsVisibility}" />
                            <p:DataGridRowHeader Grid.RowSpan="2"
                                                 p:SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                                 Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                        </p:SelectiveScrollingGrid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FleetRowHoverBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="Selector.IsSelectionActive" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FleetRowSelectedInactiveBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource FleetRowSelectedInactiveForegroundBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="Selector.IsSelectionActive" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FleetRowSelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource FleetRowSelectedForegroundBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FleetDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="27" />
        <Setter Property="ColumnHeaderHeight" Value="29" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <!-- No grid lines, no alternating stripes: rows read like the
             macOS list, not a spreadsheet. -->
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource FleetDataGridColumnHeaderStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource FleetDataGridCellStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource FleetDataGridRowStyle}" />
    </Style>
</ResourceDictionary>
