<!-- Red/green diff rendering shared by the pull request and commit viewers. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <!-- One diff row: gutter strip, both line numbers, marker, content. -->
        <DataTemplate x:Key="DiffLineTemplate">
            <Grid Background="{Binding RowBackground}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Rectangle Grid.Column="0" Fill="{Binding GutterStrip}" />

                <TextBlock Grid.Column="1" Text="{Binding OldLineLabel}" FontFamily="Consolas"
                           FontSize="11" TextAlignment="Right" Padding="0,0,6,0"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding NewLineLabel}" FontFamily="Consolas"
                           FontSize="11" TextAlignment="Right" Padding="0,0,6,0"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                <TextBlock Grid.Column="3" Text="{Binding Marker}" FontFamily="Consolas" FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                <TextBlock Grid.Column="4" Text="{Binding Content}" FontFamily="Consolas" FontSize="11"
                           Foreground="{Binding ContentBrush}" FontStyle="{Binding ContentStyle}"
                           TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>

        <!-- One half of a side-by-side row: line number, gutter strip, wrapped content. -->
        <DataTemplate x:Key="DiffSideCellTemplate">
            <Grid Background="{Binding CellBackground}"
                  AutomationProperties.Name="{Binding AccessibleText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding NumberLabel}" FontFamily="Consolas"
                           FontSize="11" TextAlignment="Right" Padding="0,0,6,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <Rectangle Grid.Column="1" Fill="{Binding GutterStrip}" />
                <TextBlock Grid.Column="2" Text="{Binding Content}" FontFamily="Consolas" FontSize="11"
                           Padding="4,0,6,0" TextWrapping="Wrap"
                           Foreground="{Binding ContentBrush}" FontStyle="{Binding ContentStyle}" />
            </Grid>
        </DataTemplate>

        <!-- Side by side: old on the left, new on the right, one row per pair. -->
        <DataTemplate x:Key="DiffSplitRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" Content="{Binding Left}"
                                  ContentTemplate="{StaticResource DiffSideCellTemplate}" />
                <Rectangle Grid.Column="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                <ContentPresenter Grid.Column="2" Content="{Binding Right}"
                                  ContentTemplate="{StaticResource DiffSideCellTemplate}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DiffHunkTemplate">
            <StackPanel>
                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="6,2">
                    <TextBlock Text="{Binding Header}" FontFamily="Consolas" FontSize="10"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </Border>
                <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource DiffLineTemplate}"
                              Visibility="{Binding InlineVisibility}" />
                <ItemsControl ItemsSource="{Binding SplitRows}" ItemTemplate="{StaticResource DiffSplitRowTemplate}"
                              Visibility="{Binding SplitVisibility}" />
            </StackPanel>
        </DataTemplate>

        <!-- One file card in Changes. -->
        <DataTemplate x:Key="DiffFileTemplate">
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1" CornerRadius="6" Margin="0,0,0,12">
                <StackPanel>
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            CornerRadius="6,6,0,0" Padding="10,6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatLabel}" FontSize="11"
                                       FontFamily="Consolas" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" FontSize="10"
                                       Visibility="{Binding StatusVisibility}" Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="12"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                        </DockPanel>
                    </Border>

                    <TextBlock Text="{Binding EmptyNotice}" Visibility="{Binding EmptyNoticeVisibility}"
                               Padding="10,8" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                    <!-- Inline: wide lines scroll within their own card rather than
                         forcing the whole sheet sideways. Side by side wraps instead. -->
                    <ScrollViewer HorizontalScrollBarVisibility="{Binding HorizontalScroll}" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Hunks}" ItemTemplate="{StaticResource DiffHunkTemplate}" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </DataTemplate>

</ResourceDictionary>
