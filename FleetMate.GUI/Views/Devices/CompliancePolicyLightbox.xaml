<Window x:Class="FleetMate.GUI.Views.Devices.CompliancePolicyLightbox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Compliance Policy"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TextElement.Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
        ShowInTaskbar="False">
    <!-- Scrim + centred card: clicking the scrim (or ESC) dismisses, like the
         work-item and PR lightboxes. -->
    <Grid Background="#99000000" MouseLeftButtonDown="OnScrimMouseDown">
        <Border x:Name="CardBorder" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header: policy identity left, actions right. -->
                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Click="OnCopyReport" Margin="0,0,8,0" ToolTip="Copy a plain-text report for a ticket">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Copy" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnSyncDevice" Margin="0,0,8,0" ToolTip="Sync this device now">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Sync" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="&#xE774;" FontFamily="Segoe Fluent Icons" Width="30" Height="30"
                                Click="OnOpenInIntune" ToolTip="Open the device's compliance page in Intune" Margin="0,0,8,0" />
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Width="30" Height="30"
                                Click="OnCloseClicked" ToolTip="Close" />
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PolicyNameText" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <Border x:Name="PlatformBadge" Background="{DynamicResource SubtleFillBrush}" CornerRadius="4"
                                    Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PlatformText" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                            <Border x:Name="StateBadge" CornerRadius="4" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="StateText" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                            <TextBlock x:Name="VersionText" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="DeviceLineText" FontSize="12" Margin="0,5,0,0"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock x:Name="SyncStatusText" FontSize="11" Margin="0,3,0,0" Visibility="Collapsed"
                                   Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                    </StackPanel>
                </DockPanel>

                <!-- Setting states left, policy definition right. -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                        <StackPanel x:Name="SettingsPanel" />
                    </ScrollViewer>

                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DefinitionPanel" Margin="14" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
