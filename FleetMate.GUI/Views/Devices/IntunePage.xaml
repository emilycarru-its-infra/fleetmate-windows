<Page x:Class="FleetMate.GUI.Views.Devices.IntunePage"
      Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:FleetMate.GUI.Views.Devices"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:widgets="clr-namespace:FleetMate.GUI.Views.Shared.Widgets">

    <!-- Widgets sit above the page; the DockPanel keeps the page's own grid untouched. -->
    <DockPanel>
    <widgets:WidgetsSection DockPanel.Dock="Top" Tab="Devices" Margin="16,14,16,0" />
    <Grid Margin="16,14,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock Text="Devices" Style="{StaticResource TitleTextStyle}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Device Management Service" Style="{StaticResource SubtitleTextStyle}" />
                <TextBlock x:Name="DeviceCountText" Margin="8,0,0,0" Style="{StaticResource SubtitleTextStyle}" />
                <TextBlock x:Name="AutopilotLoadingText" Margin="8,0,0,0" Style="{StaticResource SubtitleTextStyle}"
                           Text="· reading Autopilot…" Visibility="Collapsed" />
                <TextBlock x:Name="AppleLoadingText" Margin="8,0,0,0" Style="{StaticResource SubtitleTextStyle}"
                           Text="· reading Apple organizations…" Visibility="Collapsed" />
                <TextBlock x:Name="SelectionCountText" Margin="8,0,0,0" Foreground="{DynamicResource SystemControlForegroundAccentBrush}" FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>

        <!-- Toolbar. Platform is one of the filters, not a picker: every
             device is in one list. -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <Button x:Name="FiltersButton" Margin="0,0,8,0" Click="OnFiltersClicked">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71C;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="FiltersButtonText" Text="Filters" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Popup x:Name="FiltersPopup" PlacementTarget="{Binding ElementName=FiltersButton}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" VerticalOffset="4">
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10" Width="340">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Clear" Click="OnClearFiltersClicked" />
                            <TextBlock Text="Filters" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="FiltersHost" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Popup>
            <!-- Look up a list of serials: typed, pasted, or imported from a text or CSV file. -->
            <Button x:Name="SerialsButton" Margin="0,0,8,0" Click="OnSerialsClicked"
                    ToolTip="Show only the devices on a list of serial numbers">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA37;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="SerialsButtonText" Text="Serials" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Popup x:Name="SerialsPopup" PlacementTarget="{Binding ElementName=SerialsButton}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" VerticalOffset="4">
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10" Width="340">
                    <StackPanel>
                        <TextBlock Text="Look Up Serials" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Type or paste serial numbers, one per line or separated by commas, or import a text or CSV file."
                                   TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBox x:Name="SerialsInput" AcceptsReturn="True" TextWrapping="NoWrap" Height="160"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" TextChanged="OnSerialsInputChanged" />
                        <TextBlock x:Name="SerialsParsedText" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <DockPanel Margin="0,8,0,0" LastChildFill="False">
                            <Button DockPanel.Dock="Left" Content="Import File…" Click="OnImportSerialsClicked" />
                            <Button DockPanel.Dock="Right" x:Name="SerialsShowButton" Content="Show" Margin="8,0,0,0"
                                    Style="{DynamicResource AccentButtonStyle}" Click="OnShowSerialsClicked" IsEnabled="False" />
                            <Button DockPanel.Dock="Right" x:Name="SerialsClearButton" Content="Clear" Click="OnClearSerialsClicked" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Popup>
            <Button x:Name="ImportHashesButton" Margin="0,0,8,0" Click="OnImportHashesClicked"
                    ToolTip="Register devices with Windows Autopilot from a hardware hash CSV">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B5;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Import Hashes" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="ActionsButton" Content="Actions" Margin="0,0,8,0" Click="OnActionsClicked" IsEnabled="False" />
            <Button x:Name="RefreshButton" Click="OnRefreshClicked"><StackPanel Orientation="Horizontal"><ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="Refresh" VerticalAlignment="Center" /></StackPanel></Button>
        </StackPanel>

        <!-- Search and Select -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Visibility="Collapsed" ui:ControlHelper.PlaceholderText="Search name, serial, user or group tag..." TextChanged="OnSearchChanged" />
            <Button Grid.Column="1" Content="Select All" Margin="8,0,0,0" Click="OnSelectAllClicked" />
            <Button Grid.Column="2" x:Name="ClearSelectionButton" Content="Clear" Margin="8,0,0,0" Click="OnClearSelectionClicked" IsEnabled="False" />
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ActionsPanelColumn" Width="0" />
                <ColumnDefinition x:Name="DetailPanelColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Device List -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <!-- Loading indicator -->
                    <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing IsActive="True" Width="40" Height="40" />
                        <TextBlock Text="Loading devices..." Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Not configured message -->
                    <TextBlock x:Name="NotConfiguredText" Visibility="Collapsed"
                               Text="Add the Microsoft Graph tenant and client IDs in Settings. Authentication uses your signed-in Windows account."
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" />

                    <!-- Device DataGrid -->
                    <DataGrid x:Name="DevicesDataGrid"
                              Style="{StaticResource FleetDataGridStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionChanged="OnDeviceSelectionChanged"
                              CanUserSortColumns="True">
                        <!-- The same columns for every row, a dash where the row's sources
                             have no value. Right-click a header to show or hide the
                             optional ones; the choice is kept between launches. -->
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding NameText}" Width="170" />
                            <DataGridTextColumn Header="Serial" Binding="{Binding SerialText}" Width="120" />
                            <DataGridTextColumn Header="Platform" Binding="{Binding PlatformText}" Width="90" />
                            <DataGridTextColumn Header="OS" Binding="{Binding OsText}" Width="150" />
                            <DataGridTextColumn Header="User" Binding="{Binding UserText}" Width="150" />
                            <DataGridTemplateColumn Header="Compliance" Width="120" SortMemberPath="ComplianceText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="Gray" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ComplianceTone}" Value="good">
                                                                <Setter Property="Fill" Value="#2E9E4F" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ComplianceTone}" Value="attention">
                                                                <Setter Property="Fill" Value="#E8890C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ComplianceText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Last Sync" Binding="{Binding LastSyncText}" SortMemberPath="LastSyncSort" Width="130" />
                            <DataGridTextColumn Header="Management Service" Binding="{Binding ServiceText}" Width="150" />
                            <DataGridTextColumn Header="Org Status" Binding="{Binding OrgStatusText}" Width="190" />
                            <DataGridTextColumn Header="Group / Order" Binding="{Binding GroupOrOrderText}" Width="120" />
                            <DataGridTextColumn Header="Model" Binding="{Binding ModelText}" Width="160" Visibility="Collapsed" />
                            <DataGridTextColumn Header="Manufacturer" Binding="{Binding ManufacturerText}" Width="120" Visibility="Collapsed" />
                            <DataGridTextColumn Header="Ownership" Binding="{Binding OwnershipText}" Width="100" Visibility="Collapsed" />
                            <DataGridTextColumn Header="Migration" Binding="{Binding MigrationText}" Width="100" Visibility="Collapsed" />
                            <DataGridTextColumn Header="Purchase Source" Binding="{Binding PurchaseSourceText}" Width="120" Visibility="Collapsed" />
                            <DataGridTextColumn Header="Added" Binding="{Binding AddedText}" Width="100" Visibility="Collapsed" />
                            <!-- Read per device on selection, so most rows read "—": neither sortable nor a filter. -->
                            <DataGridTextColumn Header="Activation Lock" Binding="{Binding ActivationLockText}" Width="120"
                                                Visibility="Collapsed" CanUserSort="False">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActivationLockIsLocked}" Value="True">
                                                <Setter Property="Foreground" Value="#E8890C" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Actions Panel -->
            <Border x:Name="ActionsPanel" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="16,0,0,0" Visibility="Collapsed">
                <Grid Width="300">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Panel Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Device Actions" FontWeight="Bold" FontSize="16" />
                        <Button Content="" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Right" Width="28" Height="28" Click="OnCloseActionsPanel" />
                    </Grid>

                    <!-- Selection Summary -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock x:Name="SelectedDevicesText" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedDeviceNamesText" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Action Message -->
                    <Border x:Name="ActionMessageBorder" Grid.Row="2" Visibility="Collapsed" Padding="8" Margin="0,0,0,8" CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <ui:ProgressRing x:Name="ActionProgressRing" IsActive="False" Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock x:Name="ActionMessageText" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Actions ScrollViewer -->
                    <!-- Only the actions that apply to every selected device are shown. -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="NoActionsText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       Text="No actions apply to every selected device." />

                            <!-- Apple organization: offered when one organization holds every selected device.
                                 These actions only ever receive serial numbers. -->
                            <TextBlock x:Name="AppleActionsHeader" Text="Apple Organization" FontWeight="SemiBold"
                                       Margin="0,4,0,4" Visibility="Collapsed" />
                            <Expander x:Name="AppleAssignSection" Header="Assign Management Service" Visibility="Collapsed">
                                <StackPanel Margin="8">
                                    <ComboBox x:Name="AppleServerCombo" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                              DisplayMemberPath="Name" ui:ControlHelper.PlaceholderText="Device management service" />
                                    <Button Content="Assign" Click="OnAppleAssignClicked" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                    <Button x:Name="AppleUnassignButton" Content="Unassign" Click="OnAppleUnassignClicked" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="AppleMigrationSection" Header="Migrate Management Service" Visibility="Collapsed">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Move the devices to another service without erasing them, by a deadline at most 90 days out."
                                               TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                                    <ComboBox x:Name="AppleMigrationServerCombo" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                              DisplayMemberPath="Name" ui:ControlHelper.PlaceholderText="Destination service" />
                                    <DatePicker x:Name="AppleMigrationDeadline" Margin="0,0,0,8" HorizontalAlignment="Stretch" />
                                    <Button x:Name="AppleScheduleMigrationButton" Content="Schedule Migration" Click="OnAppleScheduleMigrationClicked"
                                            HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                    <Button x:Name="AppleUpdateDeadlineButton" Content="Change Deadline" Click="OnAppleUpdateDeadlineClicked"
                                            HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                    <Button x:Name="AppleCancelMigrationButton" Content="Cancel Migration" Click="OnAppleCancelMigrationClicked"
                                            HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="AppleReleaseSection" Header="Release from Organization" Visibility="Collapsed">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Remove the devices from Apple Business Manager. They lose their enrollment assignment. This cannot be undone."
                                               TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                                    <Button Content="Release" Click="OnAppleReleaseClicked" HorizontalAlignment="Stretch"
                                            Background="#E8890C" Foreground="White" />
                                </StackPanel>
                            </Expander>

                            <!-- Windows Autopilot: offered when every selected device has an identity. -->
                            <TextBlock x:Name="AutopilotActionsHeader" Text="Windows Autopilot" FontWeight="SemiBold"
                                       Margin="0,4,0,4" Visibility="Collapsed" />
                            <Expander x:Name="AutopilotGroupTagSection" Header="Set Group Tag" Visibility="Collapsed">
                                <StackPanel Margin="8">
                                    <TextBox x:Name="AutopilotGroupTagBox" ui:ControlHelper.PlaceholderText="Group tag (empty clears it)" Margin="0,0,0,8" />
                                    <Button Content="Set Group Tag" Click="OnAutopilotSetGroupTagClicked" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="AutopilotAssignUserSection" Header="Assign User" Visibility="Collapsed">
                                <StackPanel Margin="8">
                                    <TextBox x:Name="AutopilotUserBox" ui:ControlHelper.PlaceholderText="user@domain" Margin="0,0,0,8" />
                                    <Button Content="Assign User" Click="OnAutopilotAssignUserClicked" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="AutopilotUnassignUserSection" Header="Unassign User" Visibility="Collapsed">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Remove the assigned user from the selected Autopilot identities."
                                               TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                                    <Button Content="Unassign User" Click="OnAutopilotUnassignUserClicked" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="AutopilotSyncSection" Header="Sync Autopilot" Visibility="Collapsed">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Ask Intune to sync registrations with the Autopilot service. This applies to the whole tenant."
                                               TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                                    <Button Content="Sync Autopilot" Click="OnAutopilotSyncClicked" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="AutopilotDeleteSection" Header="Delete Autopilot Identity" Visibility="Collapsed">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Remove the selected devices from Autopilot. The devices are untouched; they stop receiving an Autopilot profile."
                                               TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                                    <Button Content="Delete Identity" Click="OnAutopilotDeleteClicked" HorizontalAlignment="Stretch"
                                            Background="#E8890C" Foreground="White" />
                                </StackPanel>
                            </Expander>
                            <TextBlock x:Name="IntuneActionsHeader" Text="Intune" FontWeight="SemiBold" Margin="0,10,0,4" Visibility="Collapsed" />
                            <!-- Sync Section -->
                            <Expander x:Name="SyncSection" Header="Sync Device" IsExpanded="True">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Force devices to check in with Intune and re-evaluate policies and app assignments." 
                                               TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                                    <Button Content="Sync Now" Click="OnSyncClicked" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Expander>

                            <!-- Restart Section -->
                            <Expander x:Name="RestartSection" Header="Restart Device">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Immediately restart the selected devices. Active user sessions will be terminated." 
                                               TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                                    <Button Content="Restart" Click="OnRestartClicked" HorizontalAlignment="Stretch" Background="Orange" />
                                </StackPanel>
                            </Expander>

                            <!-- Lock Section -->
                            <Expander x:Name="LockSection" Header="Lock Device">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Remotely lock devices. Enter a PIN for supported devices." 
                                               TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                                    <TextBox x:Name="LockPinTextBox" ui:ControlHelper.PlaceholderText="PIN (optional)" Margin="0,0,0,8" />
                                    <Button Content="Lock Device" Click="OnLockClicked" HorizontalAlignment="Stretch" Background="#E8890C" Foreground="White" />
                                </StackPanel>
                            </Expander>

                            <!-- Retire Section -->
                            <Expander x:Name="RetireSection" Header="Retire Device">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Remove company data and unenroll the selected devices. Personal data is left intact."
                                               TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                                    <Button Content="Retire Device" Click="OnRetireClicked" HorizontalAlignment="Stretch" Background="#E8890C" Foreground="White" />
                                </StackPanel>
                            </Expander>

                            <!-- Wipe Section -->
                            <Expander x:Name="WipeSection" Header="Wipe Device">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Factory-reset the selected devices. This cannot be undone."
                                               TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                                    <!-- Each device gets only the options its platform accepts. -->
                                    <TextBlock x:Name="WipeMixedPlatformText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               Text="Mixed selection: each device gets only the options its platform supports." />
                                    <CheckBox x:Name="WipeKeepEnrollmentCheckBox" Content="Leave the device enrolled" FontSize="12" Margin="0,0,0,4" />
                                    <CheckBox x:Name="WipeKeepUserDataCheckBox" Content="Keep user data (Windows)" FontSize="12" Margin="0,0,0,4" />
                                    <CheckBox x:Name="WipeProtectedCheckBox" Content="Protected wipe (Windows)" FontSize="12" Margin="0,0,0,4"
                                              ToolTip="Retries until it succeeds and cannot be circumvented by the user. A device interrupted mid-wipe may not boot." />
                                    <TextBox x:Name="WipeUnlockCodeTextBox" ui:ControlHelper.PlaceholderText="Recovery PIN (macOS/iOS)" Margin="0,4,0,4" />
                                    <ComboBox x:Name="WipeObliterationComboBox" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                              ui:ControlHelper.Header="Erase behaviour (macOS)"
                                              ToolTip="macOS 12 and later. Erase All Content and Settings is instant; the fallback full erase is not." />
                                    <Button Content="Wipe Device" Click="OnWipeClicked" HorizontalAlignment="Stretch" Background="#E8890C" Foreground="White" />
                                </StackPanel>
                            </Expander>

                            <!-- Fresh Start Section (Windows) -->
                            <Expander x:Name="FreshStartSection" Header="Fresh Start">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Reinstall Windows and remove preinstalled OEM apps. The device stays enrolled and Entra-joined."
                                               TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                                    <CheckBox x:Name="FreshStartKeepUserDataCheckBox" Content="Keep user data and account" IsChecked="True" FontSize="12" Margin="0,0,0,8" />
                                    <Button Content="Fresh Start" Click="OnFreshStartClicked" HorizontalAlignment="Stretch" Background="Orange" />
                                </StackPanel>
                            </Expander>

                            <!-- Autopilot Reset Section -->
                            <Expander x:Name="AutopilotResetSection" Header="Autopilot Reset">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Reimage the selected devices through Windows Autopilot: removes apps and settings, keeps enrollment, and re-provisions."
                                               TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                                    <Button Content="Autopilot Reset" Click="OnAutopilotResetClicked" HorizontalAlignment="Stretch" Background="#E8890C" Foreground="White" />
                                </StackPanel>
                            </Expander>

                            <!-- Offboard: decommission across Intune, Autopilot and Entra in one pass. -->
                            <Expander x:Name="OffboardSection" Header="Offboard Device">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Decommission across Intune, Autopilot and Entra in one pass. Steps that do not apply to a device's platform are skipped."
                                               TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                                    <ComboBox x:Name="OffboardTerminalComboBox" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                              ui:ControlHelper.Header="Intune action" SelectionChanged="OnOffboardPlanChanged" />
                                    <TextBlock x:Name="OffboardUsesWipeOptionsText" Text="Uses the wipe options set above." FontSize="12" Margin="0,0,0,6"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <CheckBox x:Name="OffboardDeleteAutopilotCheckBox" Content="Delete the Autopilot registration" FontSize="12" Margin="0,0,0,4"
                                              ToolTip="Windows only. Releases the hardware hash so the device can be re-registered elsewhere." />
                                    <ComboBox x:Name="OffboardEntraComboBox" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                              ui:ControlHelper.Header="Entra device" />
                                    <CheckBox x:Name="OffboardDeleteIntuneCheckBox" Content="Delete the Intune record" FontSize="12" Margin="0,0,0,4"
                                              Checked="OnOffboardPlanChanged" Unchecked="OnOffboardPlanChanged" />
                                    <TextBlock x:Name="OffboardCancelsWarningText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6"
                                               Foreground="#E8890C" />
                                    <Button Content="Offboard Device" Click="OnOffboardClicked" HorizontalAlignment="Stretch" Background="#E8890C" Foreground="White" />
                                    <StackPanel x:Name="OffboardResultsPanel" Margin="0,8,0,0" />
                                </StackPanel>
                            </Expander>

                            <!-- Delete Record Section -->
                            <Expander x:Name="DeleteRecordSection" Header="Delete Intune Record">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Delete the Intune device record server-side only. Nothing is sent to the device; use for stale or duplicate records."
                                               TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                                    <Button Content="Delete Record" Click="OnDeleteRecordClicked" HorizontalAlignment="Stretch" Background="#E8890C" Foreground="White" />
                                </StackPanel>
                            </Expander>

                            <!-- App Reinstall Section -->
                            <Expander x:Name="ReinstallAppSection" Header="Reinstall App">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Trigger app reinstallation by initiating a device sync." 
                                               TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="AppSearchBox" ui:ControlHelper.PlaceholderText="Search apps..." />
                                        <Button Grid.Column="1" Content="" FontFamily="Segoe Fluent Icons" Width="32" Margin="4,0,0,0" Click="OnSearchAppsClicked" />
                                    </Grid>
                                    <ComboBox x:Name="AppComboBox" ui:ControlHelper.PlaceholderText="Select an app..." HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                                    <Button Content="Trigger Reinstall" Click="OnReinstallAppClicked" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Expander>

                            <!-- OS Update Section -->
                            <Expander x:Name="OsUpdateSection" Header="OS Update">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Trigger OS update check. Updates are installed based on update policies." 
                                               TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                                    <Button Content="Check for Updates" Click="OnCheckUpdatesClicked" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Expander>

                            <!-- Cimian Push Section -->
                            <Expander x:Name="PushCimianSection" Header="Push Cimian Run">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Trigger an immediate Cimian managed software update on selected devices. Creates a .cimian.headless trigger file via Intune remediation. CimianWatcher picks it up within 10 seconds." 
                                               TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                                    <Button Content="Push Cimian Run" Click="OnPushCimianClicked" HorizontalAlignment="Stretch" 
                                            Background="{DynamicResource SystemControlForegroundAccentBrush}" Foreground="White" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <!-- Device Detail Panel -->
            <local:DeviceDetailPanel x:Name="DeviceDetail" Grid.Column="2" Margin="16,0,0,0" Visibility="Collapsed" />
        </Grid>
    </Grid>
    </DockPanel>
</Page>
