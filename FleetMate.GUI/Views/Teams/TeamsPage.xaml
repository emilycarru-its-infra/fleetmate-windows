<Page x:Class="FleetMate.GUI.Views.Teams.TeamsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240" MinWidth="180" />
            <ColumnDefinition x:Name="SidebarDividerColumn" Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel x:Name="Sidebar" Margin="12">
            <Button DockPanel.Dock="Bottom" Content="Refresh channels" Click="OnRefreshChannels" Margin="0,10,0,0" />
            <TextBlock DockPanel.Dock="Top" Text="Channels" FontWeight="SemiBold" Margin="4,0,0,10" />
            <TextBox x:Name="ChannelFilterBox" DockPanel.Dock="Top" TextChanged="OnChannelFilterChanged" Margin="0,0,0,10"
                     ui:ControlHelper.PlaceholderText="Filter teams and channels" AutomationProperties.Name="Filter teams and channels" />
            <TextBlock x:Name="ChannelFilterSummary" DockPanel.Dock="Bottom" TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,8,0,0" />
            <TreeView x:Name="ChannelTree" SelectedItemChanged="OnChannelChanged"
                      AutomationProperties.Name="Teams channels" BorderThickness="0" />
        </DockPanel>
        <GridSplitter x:Name="SidebarDivider" Grid.Column="1" HorizontalAlignment="Stretch" />
        <Grid Grid.Column="2" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox x:Name="QueryBox" Visibility="Collapsed" TextChanged="OnQueryChanged" />
            <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                <Button x:Name="SidebarToggle" Content="Channels" Click="OnToggleChannels" Margin="0,0,12,6" />
                <TextBlock Text="Period" VerticalAlignment="Center" Margin="0,0,6,6" />
                <ComboBox x:Name="PeriodBox" Width="130" SelectedIndex="0" SelectionChanged="OnFilterChanged" Margin="0,0,12,6"
                          AutomationProperties.Name="Search period">
                    <ComboBoxItem Content="Any time" />
                    <ComboBoxItem Content="Last 7 days" />
                    <ComboBoxItem Content="Last 30 days" />
                </ComboBox>
                <TextBox x:Name="PersonBox" Width="180" Margin="0,0,12,6" KeyDown="OnPersonKeyDown"
                         ui:ControlHelper.PlaceholderText="Person" AutomationProperties.Name="Thread participant" />
                <Button Content="Search" Click="OnSearch" Margin="0,0,0,6" IsDefault="False" />
            </WrapPanel>
            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                <Button x:Name="FollowButton" DockPanel.Dock="Right" Content="Follow channel" Click="OnFollowChannel" Visibility="Collapsed" Margin="8,0,0,0" />
                <TextBlock x:Name="ScopeText" Text="All channels" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <DockPanel Grid.Row="2" LastChildFill="True" Margin="0,0,0,8">
                <Button x:Name="LoadMoreButton" DockPanel.Dock="Right" Content="Load more" Click="OnLoadMore" Visibility="Collapsed" Margin="8,0,0,0" />
                <Button x:Name="RetryButton" DockPanel.Dock="Right" Content="Retry" Click="OnRetry" Visibility="Collapsed" Margin="8,0,0,0" />
                <TextBlock x:Name="StatusText" Text="Loading channels…" TextWrapping="Wrap" />
            </DockPanel>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ResultsColumn" Width="*" MinWidth="180" />
                    <ColumnDefinition x:Name="DetailDividerColumn" Width="0" />
                    <ColumnDefinition x:Name="DetailColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Border x:Name="Welcome" Padding="24" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock x:Name="WelcomeTitle" Text="Search Teams channels" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock x:Name="WelcomeDescription" Text="Choose a channel to browse conversations, or search across channels (Ctrl+F). Save useful threads into collections and copy message text without switching apps." TextWrapping="Wrap" Margin="0,0,0,16" />
                            <TextBlock x:Name="ChannelSummary" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="ResultsList" Visibility="Collapsed" SelectionChanged="OnResultChanged" ContextMenuOpening="OnResultContextMenuOpening"
                             HorizontalContentAlignment="Stretch" AutomationProperties.Name="Teams search results">
                        <ListBox.ContextMenu><ContextMenu /></ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,8">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Location}" Opacity="0.7" Margin="0,4,0,4" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Activity}" Opacity="0.7" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <GridSplitter x:Name="DetailDivider" Grid.Column="1" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                <DockPanel x:Name="ThreadPanel" Grid.Column="2" Margin="12,0,0,0" Visibility="Collapsed">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="Back to results" Click="OnCloseThread" Margin="0,0,8,4" />
                        <Button x:Name="OpenButton" Content="Open in Teams" Click="OnOpen" IsEnabled="False" Margin="0,0,8,4" />
                        <Button x:Name="CopyButton" Content="Copy link" Click="OnCopy" IsEnabled="False" Margin="0,0,8,4" />
                        <Button x:Name="CopyThreadButton" Content="Copy thread" Click="OnCopyThread" IsEnabled="False" Margin="0,0,8,4" />
                        <Button x:Name="CopyMarkdownButton" Content="Copy Markdown" Click="OnCopyMarkdown" IsEnabled="False" Margin="0,0,8,4" />
                        <Button x:Name="SaveButton" Content="Save thread" Click="OnSaveThread" IsEnabled="False" Margin="0,0,8,4" />
                        <TextBox x:Name="CollectionBox" Width="140" Margin="0,0,8,4" ui:ControlHelper.PlaceholderText="Collection (optional)" AutomationProperties.Name="Saved thread collection" />
                    </WrapPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Teams thread">
                        <StackPanel x:Name="ThreadCards" />
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
