<UserControl x:Class="FleetMate.GUI.Views.Development.Repos.RepoWorkspaceView"
             Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:local="clr-namespace:FleetMate.GUI.Views.Development.Repos"
             xmlns:shared="clr-namespace:FleetMate.GUI.Views.Shared"
             Focusable="True" FocusVisualStyle="{x:Null}">

    <UserControl.Resources>
        <!-- One change: stage toggle, status letter, file name and folder. -->
        <DataTemplate x:Key="ChangeRowTemplate">
            <DockPanel Background="Transparent" ToolTip="{Binding Tooltip}">
                <DockPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open in Editor" Click="OnChangeOpen" />
                        <MenuItem Header="Open with Default App" Click="OnChangeOpenExternal" />
                        <MenuItem Header="Reveal in Explorer" Click="OnChangeReveal" />
                        <Separator />
                        <MenuItem Header="Copy Path" Click="OnChangeCopyPath" />
                        <MenuItem Header="Copy Relative Path" Click="OnChangeCopyRelative" />
                        <Separator />
                        <MenuItem Header="{Binding StageLabel}" Click="OnChangeToggleStage" />
                        <MenuItem Header="Discard Changes…" Click="OnChangeDiscard" IsEnabled="{Binding CanDiscard}" />
                    </ContextMenu>
                </DockPanel.ContextMenu>
                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Staged, Mode=OneWay}" Click="OnStageCheckbox"
                          MinWidth="0" Margin="0,0,4,0" VerticalAlignment="Center"
                          ToolTip="{Binding StageLabel}" AutomationProperties.Name="{Binding StageLabel}" />
                <Border DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="3" Margin="0,0,8,0"
                        Background="{Binding LetterBrush}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Letter}" FontSize="10" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Side}" FontSize="10" Opacity="0.6" Margin="6,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding Folder, Mode=OneWay}" FontSize="11"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </TextBlock>
            </DockPanel>
        </DataTemplate>

        <!-- One commit: lane graph, subject with ref badges, author and date. -->
        <DataTemplate x:Key="HistoryRowTemplate">
            <DockPanel Background="Transparent" MinHeight="34">
                <DockPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add Tag…" Click="OnCommitTag" />
                        <MenuItem Header="Create Branch…" Click="OnCommitBranch" />
                        <Separator />
                        <MenuItem Header="Checkout…" Click="OnCommitCheckout" />
                        <MenuItem Header="Cherry-Pick…" Click="OnCommitCherryPick" />
                        <MenuItem Header="Revert…" Click="OnCommitRevert" />
                        <Separator />
                        <MenuItem Header="Copy Hash" Click="OnCommitCopyHash" />
                        <MenuItem Header="Copy Subject" Click="OnCommitCopySubject" />
                        <MenuItem Header="Copy as Patch" Click="OnCommitCopyPatch" />
                    </ContextMenu>
                </DockPanel.ContextMenu>
                <local:CommitGraphCell DockPanel.Dock="Left" Row="{Binding Graph}" LaneCount="{Binding LaneCount}" />
                <StackPanel VerticalAlignment="Center" Margin="4,2,0,2">
                    <DockPanel>
                        <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Refs}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="4,0" Margin="0,0,4,0" Background="{Binding Background}"
                                            BorderBrush="{Binding Border}" BorderThickness="1">
                                        <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{Binding Foreground}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Subject}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Subject}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Byline}" FontSize="10" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="FileRowTemplate">
            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" Background="Transparent" ToolTip="{Binding Path}">
                <ui:FontIcon Glyph="{Binding Chevron}" FontSize="8" Width="12" Opacity="{Binding ChevronOpacity}"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <ui:FontIcon Glyph="{Binding Icon}" FontSize="12" Margin="2,0,6,0" Foreground="{Binding IconBrush}" />
                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                <Ellipse Width="6" Height="6" Margin="6,0,0,0" Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                         Visibility="{Binding UnsavedVisibility}" ToolTip="Unsaved edits" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="GrepRowTemplate">
            <DockPanel Background="Transparent" ToolTip="{Binding Path}">
                <TextBlock DockPanel.Dock="Left" Text="{Binding LineLabel}" FontSize="11" MinWidth="34" TextAlignment="Right"
                           Margin="0,0,8,0" Opacity="0.6" />
                <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <TextBlock x:Name="NoSelection" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"
                   Text="Select a repository. Browse, edit and commit in any tracked checkout; agents work in the same checkouts through 'fleetmate repos'." />

        <DockPanel x:Name="Workspace" Visibility="Collapsed">
            <!-- Header: branch, network, refresh, help · AGENTS.md, terminal, reveal -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AgentsButton" Click="OnOpenAgents" Margin="0,0,6,0" Padding="8,4"
                            ToolTip="Agents read this file before working here. Click to open it.">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE8A5;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="AGENTS.md" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="NoAgentsLabel" Text="No AGENTS.md" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,10,0"
                               ToolTip="This repository has no AGENTS.md for agents to read" />
                    <Button Click="OnOpenTerminal" Margin="0,0,6,0" Padding="8,4"
                            ToolTip="Open an agent terminal session in this checkout">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE756;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Terminal" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RevealButton" Click="OnReveal" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE838;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Reveal" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BranchButton" Click="OnBranchMenu" Padding="8,4" Margin="0,0,6,0"
                            AutomationProperties.AutomationId="ReposBranchMenu">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE8D4;" FontSize="12" Margin="0,0,6,0" Opacity="0.7" />
                            <TextBlock x:Name="BranchLabel" FontFamily="Consolas" FontWeight="SemiBold" />
                            <Ellipse x:Name="DirtyDot" Width="6" Height="6" Margin="6,0,0,0" Fill="#FFE07A1F"
                                     ToolTip="Uncommitted changes" />
                            <TextBlock x:Name="SyncLabel" Margin="6,0,0,0" Opacity="0.7" FontSize="11" VerticalAlignment="Center" />
                            <ui:FontIcon Glyph="&#xE70D;" FontSize="9" Margin="6,0,0,0" Opacity="0.7" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnFetch" Padding="8,4" Margin="0,0,4,0" ToolTip="git fetch (f)">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE896;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Fetch" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnPull" Padding="8,4" Margin="0,0,4,0" ToolTip="git pull --ff-only (p)">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE74B;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Pull" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PushButton" Click="OnPush" Padding="8,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE74A;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Push" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnRefresh" Padding="6,4" Margin="0,0,4,0" ToolTip="Refresh (r)" AutomationProperties.Name="Refresh">
                        <ui:FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                    <Button x:Name="HelpButton" Click="OnHelp" Padding="6,4" ToolTip="Keyboard shortcuts (?)" AutomationProperties.Name="Help">
                        <ui:FontIcon Glyph="&#xE897;" FontSize="12" />
                    </Button>
                </StackPanel>
            </DockPanel>

            <Grid>
                <local:RepoInsightsView x:Name="Insights" Visibility="Collapsed" />

                <Grid x:Name="PanelGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.42*" MinWidth="300" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="0.58*" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <!-- Commit composer above the change list. -->
                        <Border x:Name="Composer" DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <ui:ProgressRing x:Name="BusyRing" DockPanel.Dock="Right" IsActive="True" Width="14" Height="14"
                                                     Visibility="Collapsed" />
                                    <TextBlock x:Name="StatusText" DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                    <TextBlock Text="Commit" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ProtectedLabel" Margin="8,0,0,0" FontSize="11" Opacity="0.7"
                                               VerticalAlignment="Center" Visibility="Collapsed"
                                               ToolTip="Commits and pushes on this branch are refused. Create a branch from the branch menu first." />
                                </DockPanel>
                                <TextBox x:Name="SubjectBox" ui:ControlHelper.PlaceholderText="Subject" TextChanged="OnSubjectChanged"
                                         AutomationProperties.Name="Commit subject" />
                                <TextBox x:Name="BodyBox" ui:ControlHelper.PlaceholderText="Body (optional)" Margin="0,6,0,0"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" MaxHeight="90"
                                         VerticalScrollBarVisibility="Auto" TextChanged="OnBodyChanged"
                                         AutomationProperties.Name="Commit body" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="AmendBox" Content="Amend" Click="OnAmendClicked" MinWidth="0" Margin="0,0,16,0"
                                              ToolTip="Amend the last commit instead of creating a new one" />
                                    <CheckBox x:Name="SkipHooksBox" Content="Skip Hooks" Click="OnSkipHooksClicked" MinWidth="0"
                                              ToolTip="Pass --no-verify to bypass pre-commit and commit-msg hooks" />
                                </StackPanel>
                                <DockPanel Margin="0,8,0,0">
                                    <Button x:Name="StageAllButton" Content="Stage All" Click="OnStageAll"
                                            ToolTip="Stage every change in the working tree. Hold Shift to unstage everything." />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="CommitButton" Content="Commit" Click="OnCommit" Margin="0,0,6,0"
                                                Style="{DynamicResource AccentButtonStyle}" ToolTip="Commit what is staged (Ctrl+Enter)" />
                                        <Button x:Name="CommitPushButton" Content="Commit &amp; Push" Click="OnCommitAndPush"
                                                ToolTip="Commit, then push the branch (C)" />
                                    </StackPanel>
                                </DockPanel>
                                <Border x:Name="OutputPanel" Margin="0,8,0,0" Visibility="Collapsed" CornerRadius="6"
                                        Background="{DynamicResource SubtleFillBrush}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Content="Copy" FontSize="10" Padding="6,1"
                                                Margin="4" Click="OnCopyOutput" ToolTip="Copy output to the clipboard" />
                                        <TextBox x:Name="OutputText" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                                 BorderThickness="0" Background="Transparent" TextWrapping="Wrap" MaxHeight="100"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <DockPanel x:Name="FilterBar" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Clear" Padding="8,2" Margin="6,0,0,0" Click="OnClearFilter" />
                            <TextBox x:Name="PanelFilterBox" ui:ControlHelper.PlaceholderText="Filter (/)" TextChanged="OnPanelFilterChanged"
                                     PreviewKeyDown="OnPanelFilterKey" />
                        </DockPanel>

                        <!-- Files header: Files or Search, with Show Files to leave a search. -->
                        <DockPanel x:Name="FilesHeader" DockPanel.Dock="Top" Visibility="Collapsed" Margin="2,0,2,6">
                            <Button x:Name="ShowFilesButton" DockPanel.Dock="Right" Content="Show Files" Padding="8,2" FontSize="11"
                                    Click="OnShowFiles" Visibility="Collapsed" />
                            <ui:ProgressRing x:Name="SearchRing" DockPanel.Dock="Right" IsActive="True" Width="12" Height="12"
                                             Margin="6,0" Visibility="Collapsed" />
                            <TextBlock x:Name="FilesTitle" Text="Files" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="FilesHint" FontSize="11" Opacity="0.6" Margin="8,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0">
                            <Grid>
                                <ListView x:Name="ChangesList" BorderThickness="0" SelectionMode="Extended"
                                          ItemTemplate="{StaticResource ChangeRowTemplate}"
                                          ItemContainerStyle="{StaticResource FleetListViewItemStyle}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          SelectionChanged="OnChangesSelectionChanged" MouseDoubleClick="OnChangeDoubleClick"
                                          AutomationProperties.AutomationId="ReposChangesList" AutomationProperties.Name="Changes" />
                                <ListView x:Name="HistoryList" BorderThickness="0" SelectionMode="Single" Visibility="Collapsed"
                                          ItemTemplate="{StaticResource HistoryRowTemplate}"
                                          ItemContainerStyle="{StaticResource FleetListViewItemStyle}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          SelectionChanged="OnHistorySelectionChanged"
                                          AutomationProperties.AutomationId="ReposHistoryList" AutomationProperties.Name="History" />
                                <ListView x:Name="FilesList" BorderThickness="0" SelectionMode="Single" Visibility="Collapsed"
                                          ItemTemplate="{StaticResource FileRowTemplate}"
                                          ItemContainerStyle="{StaticResource FleetListViewItemStyle}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          PreviewMouseLeftButtonUp="OnFileClicked" KeyDown="OnFileKey"
                                          AutomationProperties.AutomationId="ReposFilesList" AutomationProperties.Name="Files" />
                                <ListView x:Name="GrepList" BorderThickness="0" SelectionMode="Single" Visibility="Collapsed"
                                          ItemTemplate="{StaticResource GrepRowTemplate}"
                                          ItemContainerStyle="{StaticResource FleetListViewItemStyle}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                          SelectionChanged="OnGrepSelected"
                                          AutomationProperties.Name="Search results">
                                    <ListView.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SubtleFillBrush}" Padding="8,3">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListView.GroupStyle>
                                </ListView>
                                <TextBlock x:Name="ListEmpty" Visibility="Collapsed" Opacity="0.65" FontSize="12" Margin="12"
                                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </Border>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

                    <Grid Grid.Column="2" Margin="6,0,0,0">
                        <local:RepoDiffView x:Name="DiffView" />

                        <DockPanel x:Name="EditorPane" Visibility="Collapsed">
                            <Border DockPanel.Dock="Top" Background="{DynamicResource SubtleFillBrush}" CornerRadius="6,6,0,0" Padding="10,5">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <TextBlock x:Name="NoticeText" FontSize="11" Opacity="0.7" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <shared:AgentContextButton x:Name="EditorAgentButton" Padding="8,2" Margin="0,0,4,0" />
                                        <Button x:Name="RevertButton" Content="Revert" Padding="8,2" FontSize="11" Margin="0,0,4,0"
                                                Click="OnRevertEdits" ToolTip="Throw away unsaved edits (asks first)" />
                                        <Button x:Name="CloseButton" Content="Close" Padding="8,2" FontSize="11" Margin="0,0,4,0"
                                                Click="OnCloseEditor" />
                                        <Button x:Name="SaveButton" Content="Save" Padding="8,2" FontSize="11" Click="OnSave"
                                                ToolTip="Save (Ctrl+S)" />
                                    </StackPanel>
                                    <TextBlock x:Name="EditorTitle" FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Grid>
                                <Border BorderThickness="1,0,1,1" CornerRadius="0,0,6,6"
                                        BorderBrush="{DynamicResource CardBorderBrush}">
                                    <local:CodeEditor x:Name="Editor" />
                                </Border>
                                <TextBlock x:Name="EditorEmpty" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Opacity="0.7"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="Pick a file on the left. Filter with the toolbar search field; press Enter to search every file's contents." />
                            </Grid>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- Failures along the top. Non-blocking: dismiss it, or it clears itself. -->
        <Border x:Name="ErrorBanner" VerticalAlignment="Top" Visibility="Collapsed" Panel.ZIndex="10"
                Background="#FFE07A1F" CornerRadius="6" Padding="10,6" Margin="0,40,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Click="OnDismissError" ToolTip="Dismiss" Background="Transparent"
                        BorderThickness="0" Padding="4,0" Foreground="White" AutomationProperties.Name="Dismiss">
                    <ui:FontIcon Glyph="&#xE711;" FontSize="10" />
                </Button>
                <StackPanel>
                    <TextBlock x:Name="ErrorTitle" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                    <TextBox x:Name="ErrorText" Foreground="White" FontSize="12" TextWrapping="Wrap" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0" Padding="0" MaxHeight="160"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Popup x:Name="HelpPopup" PlacementTarget="{Binding ElementName=HelpButton}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True">
            <Border Style="{StaticResource CardStyle}" Padding="14" MaxWidth="640">
                <StackPanel x:Name="HelpContent" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
