<UserControl x:Class="FleetMate.GUI.Views.Development.Repos.RepositoriesSettingsView"
             Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,0,0">
        <StackPanel Margin="2" MaxWidth="860">
            <TextBlock Text="Repositories" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Every Azure DevOps and GitHub repository you can see, where each lives on this PC, and which are tracked. Tracked repositories appear in Development › Repos. The same settings drive 'fleetmate repos'."
                       Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14" />

            <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="#FFE07A1F" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="OnDismissError" Background="Transparent" BorderThickness="0"
                            Padding="4,0" Foreground="White" ToolTip="Dismiss" AutomationProperties.Name="Dismiss">
                        <ui:FontIcon Glyph="&#xE711;" FontSize="10" />
                    </Button>
                    <TextBox x:Name="ErrorText" Foreground="White" IsReadOnly="True" Background="Transparent"
                             BorderThickness="0" Padding="0" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- Locations -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Locations" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock x:Name="LocationsFooter" TextWrapping="Wrap" Margin="0,3,0,10" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                    <TextBlock Text="Clone into" FontSize="12" Margin="0,0,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Choose…" Margin="6,0,0,0" Click="OnChooseCloneRoot" />
                        <TextBox x:Name="CloneRootBox" ui:ControlHelper.PlaceholderText="~\Developer" TextChanged="OnSettingsEdited"
                                 AutomationProperties.Name="Clone root" />
                    </DockPanel>

                    <TextBlock Text="Folders to scan for existing clones" FontSize="12" Margin="0,12,0,4" />
                    <ItemsControl x:Name="ScanRootsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Padding="6,2" Click="OnRemoveScanRoot" Tag="{Binding}"
                                            ToolTip="Remove this folder" AutomationProperties.Name="Remove folder">
                                        <ui:FontIcon Glyph="&#xE738;" FontSize="11" />
                                    </Button>
                                    <ui:FontIcon DockPanel.Dock="Left" Glyph="&#xE8B7;" FontSize="12" Margin="0,0,8,0" Opacity="0.7" />
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Choose…" Margin="6,0,0,0" Click="OnChooseScanRoot" />
                        <Button x:Name="AddScanRootButton" DockPanel.Dock="Right" Content="Add" Margin="6,0,0,0" Click="OnAddScanRoot" />
                        <TextBox x:Name="NewScanRootBox" ui:ControlHelper.PlaceholderText="Folder to scan for clones"
                                 KeyDown="OnNewScanRootKey" AutomationProperties.Name="Folder to scan" />
                    </DockPanel>

                    <DockPanel Margin="0,12,0,0">
                        <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save" IsEnabled="False" Click="OnSaveSettings"
                                Style="{DynamicResource AccentButtonStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="DiscoverButton" Margin="0,0,6,0" Click="OnDiscover"
                                    ToolTip="Scan the folders above and link each checkout by its origin">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE721;" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="Find Existing Clones" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,6,0" Click="OnLinkFolder" ToolTip="Link any git checkout by its origin">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE71B;" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="Link Folder…" />
                                </StackPanel>
                            </Button>
                            <ui:ProgressRing x:Name="DiscoverRing" IsActive="True" Width="16" Height="16" Visibility="Collapsed" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="DiscoverySummary" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>
            </Border>

            <!-- Catalog -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Catalog" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
                    <DockPanel>
                        <ui:ProgressRing x:Name="RefreshRing" DockPanel.Dock="Right" IsActive="True" Width="16" Height="16"
                                         Margin="8,0,0,0" Visibility="Collapsed" />
                        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Margin="6,0,0,0" Click="OnRefreshCatalog"
                                ToolTip="Ask Azure DevOps and GitHub for every repository you can see">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE72C;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="QueryBox" ui:ControlHelper.PlaceholderText="Search repositories" TextChanged="OnQueryChanged"
                                 AutomationProperties.Name="Search repositories" />
                    </DockPanel>
                    <ItemsControl x:Name="ProviderErrors" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='⚠ {0}'}" Foreground="#FFE07A1F" FontSize="12" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="CatalogFooter" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="GroupsPanel" Margin="0,0,0,10" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
