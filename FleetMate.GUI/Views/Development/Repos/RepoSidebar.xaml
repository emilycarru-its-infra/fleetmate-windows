<UserControl x:Class="FleetMate.GUI.Views.Development.Repos.RepoSidebar"
             Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:local="clr-namespace:FleetMate.GUI.Views.Development.Repos">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type local:SidebarSectionRow}">
            <DockPanel Margin="0,6,0,0" Background="Transparent" Cursor="Hand"
                       ToolTip="{Binding ToggleHint}">
                <ui:FontIcon DockPanel.Dock="Left" Glyph="{Binding Chevron}" FontSize="9" Margin="0,0,6,0"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:SidebarGroupRow}">
            <DockPanel Margin="8,1,0,1" Background="Transparent" Cursor="Hand" ToolTip="{Binding Tooltip}">
                <ui:FontIcon DockPanel.Dock="Left" Glyph="{Binding Chevron}" FontSize="9" Margin="0,0,6,0"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <ui:FontIcon DockPanel.Dock="Left" Glyph="&#xE8B7;" FontSize="12" Margin="0,0,6,0"
                             Foreground="{DynamicResource FleetMateAccentBrush}" />
                <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:SidebarRepoRow}">
            <DockPanel Margin="{Binding Indent}" Background="Transparent" ToolTip="{Binding Tooltip}">
                <DockPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Fetch" Click="OnFetchRepo" IsEnabled="{Binding IsLocal}" />
                        <Separator />
                        <MenuItem Header="Reveal in Explorer" Click="OnRevealRepo" IsEnabled="{Binding IsLocal}" />
                        <MenuItem Header="Copy Path" Click="OnCopyPath" IsEnabled="{Binding IsLocal}" />
                        <MenuItem Header="Copy Name" Click="OnCopyName" />
                        <Separator />
                        <MenuItem Header="{Binding HideHeader}" Click="OnToggleHidden" />
                        <MenuItem Header="Stop Tracking" Click="OnStopTracking"
                                  ToolTip="Leave the clone on disk and remove it from the sidebar" />
                        <MenuItem Header="Delete Local Clone…" Click="OnDeleteClone" IsEnabled="{Binding IsLocal}" />
                    </ContextMenu>
                </DockPanel.ContextMenu>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding EditVisibility}" Margin="4,0,0,0">
                    <Button Padding="4,2" Click="OnToggleHidden" ToolTip="{Binding HideTooltip}"
                            AutomationProperties.Name="{Binding HideTooltip}" Background="Transparent" BorderThickness="0">
                        <ui:FontIcon Glyph="{Binding EyeGlyph}" FontSize="13" />
                    </Button>
                    <Button Padding="4,2" Click="OnRowMore" ToolTip="More actions" AutomationProperties.Name="More actions"
                            Background="Transparent" BorderThickness="0">
                        <ui:FontIcon Glyph="&#xE712;" FontSize="13" />
                    </Button>
                </StackPanel>
                <StackPanel Opacity="{Binding RowOpacity}">
                <DockPanel>
                    <ui:ProgressRing DockPanel.Dock="Right" IsActive="True" Width="10" Height="10"
                                     Visibility="{Binding FetchingVisibility}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Scope}" FontSize="11" Margin="6,0,0,0"
                               Visibility="{Binding ScopeVisibility}"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Text="{Binding Metadata}" Foreground="{Binding MetadataBrush}" FontSize="11"
                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The workspace's mode. It sits above the list because it is a mode of
             the whole workspace: it stays put as the selection moves between
             repositories. Keys 1–4 switch it too. -->
        <Border Grid.Row="0" Background="{DynamicResource SubtleFillBrush}" CornerRadius="8" Padding="2" Margin="0,0,0,8"
                ToolTip="Changes, History, Files or Insights for the selected repository (keys 1–4)">
            <UniformGrid Rows="1" x:Name="PanelSwitcher">
                <RadioButton x:Name="PanelChanges" Content="Changes" Tag="Changes" GroupName="RepoPanel"
                             Style="{StaticResource NavigationTabStyle}" Checked="OnPanelChecked"
                             AutomationProperties.AutomationId="ReposPanelChanges" />
                <RadioButton x:Name="PanelHistory" Content="History" Tag="History" GroupName="RepoPanel"
                             Style="{StaticResource NavigationTabStyle}" Checked="OnPanelChecked"
                             AutomationProperties.AutomationId="ReposPanelHistory" />
                <RadioButton x:Name="PanelFiles" Content="Files" Tag="Files" GroupName="RepoPanel"
                             Style="{StaticResource NavigationTabStyle}" Checked="OnPanelChecked"
                             AutomationProperties.AutomationId="ReposPanelFiles" />
                <RadioButton x:Name="PanelInsights" Content="Insights" Tag="Insights" GroupName="RepoPanel"
                             Style="{StaticResource NavigationTabStyle}" Checked="OnPanelChecked"
                             AutomationProperties.AutomationId="ReposPanelInsights" />
            </UniformGrid>
        </Border>

        <!-- Filter, sort and Fetch All at the top of the list they act on. -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button x:Name="EditButton" DockPanel.Dock="Right" Padding="8,4" Margin="6,0,0,0" Content="Edit"
                    Click="OnEditClicked" AutomationProperties.AutomationId="ReposEdit"
                    ToolTip="Show or hide repositories, stop tracking them, or delete local clones" />
            <Button x:Name="FetchAllButton" DockPanel.Dock="Right" Padding="6,4" Click="OnFetchAll"
                    ToolTip="Fetch every tracked repository from its remote" AutomationProperties.Name="Fetch All">
                <ui:FontIcon Glyph="&#xE896;" FontSize="13" />
            </Button>
            <ui:ProgressRing x:Name="BusyRing" DockPanel.Dock="Right" IsActive="True" Width="14" Height="14"
                             Margin="6,0" Visibility="Collapsed" />
            <Button x:Name="SortButton" DockPanel.Dock="Right" Padding="6,4" Margin="6,0,6,0" Click="OnSortClicked"
                    AutomationProperties.Name="Sort and group">
                <ui:FontIcon Glyph="&#xE8CB;" FontSize="13" />
            </Button>
            <TextBox x:Name="FilterBox" ui:ControlHelper.PlaceholderText="Filter"
                     TextChanged="OnFilterChanged" AutomationProperties.Name="Filter repositories" />
        </DockPanel>

        <!-- Clones that appeared in a watched folder: added only when the person says so. -->
        <Border x:Name="NewClonesBar" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource SubtleFillBrush}"
                CornerRadius="6" Padding="10,6" Margin="0,0,0,8" AutomationProperties.AutomationId="ReposNewClones">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Add" Padding="10,3" Click="OnAddNewClones" Style="{DynamicResource AccentButtonStyle}"
                            ToolTip="Track these repositories" />
                    <Button Content="Ignore" Padding="10,3" Margin="6,0,0,0" Click="OnIgnoreNewClones"
                            ToolTip="Leave them untracked and don't ask about them again" />
                </StackPanel>
                <TextBlock x:Name="NewClonesText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0" Margin="0">
            <Grid>
                <ListBox x:Name="RepoList" BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         SelectionChanged="OnRepoSelectionChanged"
                         PreviewMouseLeftButtonDown="OnListClicked"
                         AutomationProperties.AutomationId="ReposList"
                         AutomationProperties.Name="Tracked repositories">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="8,3" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" Margin="16">
                    <TextBlock Text="No tracked repositories" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,10" Opacity="0.75" FontSize="12"
                               Text="Choose the folder where you keep your code. FleetMate finds every git clone in it." />
                    <Button x:Name="ChooseFolderButton" Content="Choose Folder…" HorizontalAlignment="Center"
                            Click="OnChooseFolder" AutomationProperties.AutomationId="ReposChooseFolder" />
                    <StackPanel x:Name="ScanningState" Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,10,0,0" Visibility="Collapsed">
                        <ui:ProgressRing IsActive="True" Width="14" Height="14" Margin="0,0,6,0" />
                        <TextBlock Text="Finding clones…" FontSize="12" Opacity="0.75" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="NoMatches" Visibility="Collapsed" Text="No repositories match the filter."
                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
