<UserControl x:Class="FleetMate.GUI.Views.Development.CommitDetailView"
             Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Padding="8,3" Margin="0,0,6,0" Click="OnCopyLinkClicked" ToolTip="Copy link">
                    <ui:FontIcon Glyph="&#xE71B;" FontSize="13" />
                </Button>
                <Button Padding="8,3" Click="OnOpenInBrowserClicked" ToolTip="Open in browser">
                    <ui:FontIcon Glyph="&#xE8A7;" FontSize="13" />
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="SubjectText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="BylineText" FontSize="11" Margin="0,2,0,0"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock x:Name="StatusText" FontSize="11" Margin="0,2,0,0" Visibility="Collapsed"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsActive="True" Width="32" Height="32" />
                <TextBlock Text="Loading commit…" Margin="0,8,0,0"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="460"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

            <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel x:Name="BodySection" Margin="0,0,0,16">
                        <TextBlock Text="Message" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <Border Style="{StaticResource CardStyle}">
                            <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="12" />
                        </Border>
                    </StackPanel>

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock x:Name="TruncationNotice" DockPanel.Dock="Right" FontSize="10"
                                   Visibility="Collapsed" Foreground="#E07A1F" Text="⚠ file list truncated" />
                        <TextBlock x:Name="ChangesHeader" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </DockPanel>

                    <!-- GitHub: red/green diffs. -->
                    <ItemsControl x:Name="FilesList" ItemTemplate="{StaticResource DiffFileTemplate}" />

                    <!-- Azure DevOps: its commit API has no patch, so a change list. -->
                    <Border x:Name="ChangesCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                        <ItemsControl x:Name="ChangesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding ChangeType}" Width="70"
                                                   FontSize="11" Opacity="0.7" />
                                        <TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
