<Window x:Class="FleetMate.GUI.Views.Development.ApprovalReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="OnPreviewKeyDown">
    <StackPanel Margin="18">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="&#x270B;" FontFamily="Segoe UI Symbol" Foreground="#E07A1F" FontSize="16"
                       Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel x:Name="ApprovalPanel">
            <TextBlock x:Name="MetaText" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

            <!-- The pipeline's instructions: selectable, and scrolls when long. -->
            <TextBox x:Name="InstructionsBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     MinHeight="120" MaxHeight="320" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Instructions" />

            <TextBox x:Name="CommentBox" Margin="0,10,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="44" MaxHeight="110" VerticalScrollBarVisibility="Auto"
                     ui:ControlHelper.PlaceholderText="Comment (optional)"
                     AutomationProperties.Name="Comment" />

            <TextBlock x:Name="ErrorText" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" Foreground="#E07A1F"
                       Visibility="Collapsed" />

            <DockPanel Margin="0,14,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:ProgressRing x:Name="Working" IsActive="False" Width="16" Height="16" Margin="0,0,8,0"
                                     Visibility="Collapsed" />
                    <Button x:Name="CancelButton" Content="Cancel" Padding="12,4" Margin="0,0,6,0" IsCancel="True"
                            Click="OnCancelClicked" />
                    <Button x:Name="RejectButton" Content="Reject" Padding="12,4" Margin="0,0,6,0"
                            Background="#E07A1F" Foreground="White" Click="OnRejectClicked" />
                    <Button x:Name="ApproveButton" Content="Approve" Padding="12,4"
                            Background="#2DA44E" Foreground="White" Click="OnApproveClicked"
                            ToolTip="Approve (Ctrl+Enter)" />
                </StackPanel>
                <TextBlock x:Name="MoreText" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </DockPanel>
        </StackPanel>

        <StackPanel x:Name="NothingPanel" Visibility="Collapsed">
            <TextBlock Text="Nothing is waiting for approval on this run." Margin="0,0,0,14"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Button Content="Done" HorizontalAlignment="Right" Padding="12,4" IsDefault="True" Click="OnCancelClicked" />
        </StackPanel>
    </StackPanel>
</Window>
