<UserControl x:Class="FleetMate.GUI.Views.Development.DevelopmentView"
             Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:shared="clr-namespace:FleetMate.GUI.Views.Shared"
             xmlns:local="clr-namespace:FleetMate.GUI.Views.Development">

    <UserControl.Resources>
        <DataTemplate x:Key="PullRequestRowTemplate">
            <StackPanel Margin="2,4">
                <DockPanel>
                    <Border DockPanel.Dock="Left" CornerRadius="3" Padding="4,1" Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                        <TextBlock Text="{Binding SourceLabel}" FontSize="9" />
                    </Border>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StateLabel}" FontSize="10"
                               Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{Binding StateBrush}" />
                    <Border DockPanel.Dock="Right" CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                            VerticalAlignment="Center" Visibility="{Binding RelationVisibility}"
                            Background="#333182CE">
                        <TextBlock Text="{Binding RelationLabel}" FontSize="9" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                </DockPanel>
                <TextBlock Text="{Binding Byline}" FontSize="10" Margin="0,2,0,0" Opacity="0.75"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ActivityRowTemplate">
            <StackPanel Margin="2,5" Cursor="Hand">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Age}" FontSize="10" Opacity="0.6"
                               Margin="6,0,0,0" />
                    <TextBlock Text="{Binding AuthorName}" FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Text="{Binding PullRequestLabel}" FontSize="10" Opacity="0.7" Margin="0,1,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding PullRequestTitle}" />
                <TextBlock Text="{Binding Snippet}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                           MaxHeight="48" TextTrimming="CharacterEllipsis" FontStyle="{Binding SnippetStyle}" />
            </StackPanel>
        </DataTemplate>

        <!-- Commits: one card per repository, three commits then "Show all N". -->
        <DataTemplate x:Key="RepositoryCommitsTemplate">
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,0.5"
                    Padding="8,6">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" CornerRadius="3" Padding="4,1" Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                            <TextBlock Text="{Binding SourceLabel}" FontSize="9" />
                        </Border>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" FontSize="10" Opacity="0.6"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding VisibleCommits}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,3" Cursor="Hand" Background="Transparent" Tag="{Binding}"
                                        MouseLeftButtonUp="OnCommitClicked">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Subject}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Subject}" />
                                        <TextBlock Text="{Binding Byline}" FontSize="10" Opacity="0.65" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding ShowAllLabel}" Visibility="{Binding ShowAllVisibility}"
                            Tag="{Binding}" Click="OnShowAllClicked" FontSize="10" Padding="6,1"
                            HorizontalAlignment="Left" Margin="6,2,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PipelineRunRowTemplate">
            <DockPanel Margin="2,4">
                <ui:FontIcon DockPanel.Dock="Left" Glyph="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}"
                             FontSize="12" Margin="0,2,8,0" VerticalAlignment="Top" ToolTip="{Binding StatusLabel}" />
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" CornerRadius="3" Padding="4,1" Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                            <TextBlock Text="{Binding SourceLabel}" FontSize="9" />
                        </Border>
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Subtitle}" FontSize="10" Margin="0,2,0,0" Opacity="0.75"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Byline}" FontSize="10" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="NotificationRowTemplate">
            <DockPanel Margin="2,4">
                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,5,8,0" VerticalAlignment="Top"
                         Fill="{DynamicResource SystemControlForegroundAccentBrush}"
                         Visibility="{Binding UnreadVisibility}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                            Margin="6,0,0,0">
                    <Button Padding="5,2" Margin="0,0,2,0" ToolTip="Mark as read" Tag="{Binding}"
                            Click="OnMarkReadClicked" Visibility="{Binding MarkReadVisibility}">
                        <ui:FontIcon Glyph="&#xE8C3;" FontSize="11" />
                    </Button>
                    <Button Padding="5,2" ToolTip="Unsubscribe from this thread" Tag="{Binding}"
                            Click="OnUnsubscribeClicked">
                        <ui:FontIcon Glyph="&#xE7ED;" FontSize="11" />
                    </Button>
                </StackPanel>
                <StackPanel>
                    <DockPanel>
                        <ui:FontIcon DockPanel.Dock="Left" Glyph="{Binding TypeGlyph}" FontSize="11"
                                     Margin="0,1,6,0" ToolTip="{Binding TypeLabel}" />
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="{Binding TitleWeight}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Byline}" FontSize="10" Margin="0,2,0,0" Opacity="0.75"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" MinWidth="280" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition x:Name="ActivitySplitterColumn" Width="6" />
            <ColumnDefinition x:Name="ActivityColumn" Width="320" MinWidth="0" />
        </Grid.ColumnDefinitions>

        <!-- Left: pull requests | inbox -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <ui:ProgressRing x:Name="LoadingRing" DockPanel.Dock="Right" IsActive="True" Width="14" Height="14"
                                 VerticalAlignment="Center" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="PullRequestsSegment" Content="Pulls" GroupName="DevelopmentSegment"
                                 IsChecked="True" Checked="OnSegmentChanged"
                                 Style="{StaticResource NavigationTabStyle}" />
                    <!-- The unread count rides in the label ("Inbox 8"), not a badge. -->
                    <RadioButton x:Name="InboxSegment" Content="Inbox" GroupName="DevelopmentSegment"
                                 Checked="OnSegmentChanged" Style="{StaticResource NavigationTabStyle}" />
                    <RadioButton x:Name="CommitsSegment" Content="Commits" GroupName="DevelopmentSegment"
                                 Checked="OnSegmentChanged" Style="{StaticResource NavigationTabStyle}" />
                    <RadioButton x:Name="PipelinesSegment" Content="Pipelines" GroupName="DevelopmentSegment"
                                 Checked="OnSegmentChanged" Style="{StaticResource NavigationTabStyle}" />
                </StackPanel>
            </DockPanel>

            <!-- Pull request filters -->
            <StackPanel x:Name="PullRequestFilters" Grid.Row="1" Margin="0,0,0,8">
                <TextBox x:Name="SearchBox" ui:ControlHelper.PlaceholderText="Search title, repo, author, branch…"
                         TextChanged="OnSearchChanged" />
                <WrapPanel Margin="0,6,0,0">
                    <ToggleButton x:Name="ScopeEverything" Content="Everything" IsChecked="True" Tag="Everything"
                                  Padding="10,2" FontSize="11" Margin="0,0,4,4" Click="OnScopeClicked" />
                    <ToggleButton x:Name="ScopeMine" Content="Mine" Tag="Mine"
                                  Padding="10,2" FontSize="11" Margin="0,0,14,4" Click="OnScopeClicked" />
                    <ToggleButton x:Name="SourceAll" Content="All" IsChecked="True" Tag="All"
                                  Padding="10,2" FontSize="11" Margin="0,0,4,4" Click="OnSourceClicked" />
                    <ToggleButton x:Name="SourceDevOps" Content="DevOps" Tag="DevOps"
                                  Padding="10,2" FontSize="11" Margin="0,0,4,4" Click="OnSourceClicked" />
                    <ToggleButton x:Name="SourceGitHub" Content="GitHub" Tag="GitHub"
                                  Padding="10,2" FontSize="11" Margin="0,0,4,4" Click="OnSourceClicked" />
                </WrapPanel>
                <WrapPanel x:Name="RepoChipsPanel" Margin="0,2,0,0" />
                <TextBlock x:Name="PullRequestCount" FontSize="11" Margin="0,4,0,0" Opacity="0.7" />
            </StackPanel>

            <!-- Commits filters -->
            <StackPanel x:Name="CommitsFilters" Grid.Row="1" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBox x:Name="CommitsSearchBox" ui:ControlHelper.PlaceholderText="Search repository, message, author, sha…"
                         TextChanged="OnCommitsFilterChanged" />
                <WrapPanel Margin="0,6,0,0">
                    <ToggleButton x:Name="CommitsSourceAll" Content="All" IsChecked="True" Tag="All"
                                  Padding="10,2" FontSize="11" Margin="0,0,4,4" Click="OnCommitsSourceClicked" />
                    <ToggleButton x:Name="CommitsSourceDevOps" Content="DevOps" Tag="DevOps"
                                  Padding="10,2" FontSize="11" Margin="0,0,4,4" Click="OnCommitsSourceClicked" />
                    <ToggleButton x:Name="CommitsSourceGitHub" Content="GitHub" Tag="GitHub"
                                  Padding="10,2" FontSize="11" Margin="0,0,4,4" Click="OnCommitsSourceClicked" />
                </WrapPanel>
                <TextBlock x:Name="CommitsCount" FontSize="11" Margin="0,4,0,0" Opacity="0.7" />
            </StackPanel>

            <!-- Pipelines filters -->
            <StackPanel x:Name="PipelinesFilters" Grid.Row="1" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBox x:Name="PipelinesSearchBox" ui:ControlHelper.PlaceholderText="Search pipeline, repo, branch, requester, run…"
                         TextChanged="OnPipelinesFilterChanged" />
                <WrapPanel Margin="0,6,0,0">
                    <ToggleButton x:Name="RunsSourceAll" Content="All" IsChecked="True" Tag="All"
                                  Padding="10,2" FontSize="11" Margin="0,0,4,4" Click="OnRunsSourceClicked" />
                    <ToggleButton x:Name="RunsSourceDevOps" Content="DevOps" Tag="DevOps"
                                  Padding="10,2" FontSize="11" Margin="0,0,4,4" Click="OnRunsSourceClicked" />
                    <ToggleButton x:Name="RunsSourceGitHub" Content="GitHub" Tag="GitHub"
                                  Padding="10,2" FontSize="11" Margin="0,0,14,4" Click="OnRunsSourceClicked" />
                    <ToggleButton x:Name="RunsStatusRunning" Content="Running" Tag="Running"
                                  Padding="10,2" FontSize="11" Margin="0,0,4,4" Click="OnRunsStatusClicked" />
                    <ToggleButton x:Name="RunsStatusFailed" Content="Failed" Tag="Failed"
                                  Padding="10,2" FontSize="11" Margin="0,0,4,4" Click="OnRunsStatusClicked" />
                    <ToggleButton x:Name="RunsStatusSucceeded" Content="Succeeded" Tag="Succeeded"
                                  Padding="10,2" FontSize="11" Margin="0,0,4,4" Click="OnRunsStatusClicked" />
                </WrapPanel>
                <TextBlock x:Name="PipelinesCount" FontSize="11" Margin="0,4,0,0" Opacity="0.7" />
            </StackPanel>

            <!-- Inbox header -->
            <DockPanel x:Name="InboxHeader" Grid.Row="1" Margin="0,0,0,8" Visibility="Collapsed">
                <Button DockPanel.Dock="Right" Content="Mark all read" Padding="8,2" FontSize="11"
                        Click="OnMarkAllReadClicked" />
                <TextBlock x:Name="InboxStatus" FontSize="11" Opacity="0.7" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <ListView x:Name="PullRequestList" BorderThickness="0" SelectionMode="Single"
                              ItemTemplate="{StaticResource PullRequestRowTemplate}"
                              ItemContainerStyle="{StaticResource FleetListViewItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              SelectionChanged="OnPullRequestSelected">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SubtleFillBrush}" Padding="8,4">
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text="  " />
                                                <Run Text="{Binding ItemCount, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                    </ListView>

                    <ListView x:Name="InboxList" BorderThickness="0" SelectionMode="Single" Visibility="Collapsed"
                              ItemTemplate="{StaticResource NotificationRowTemplate}"
                              ItemContainerStyle="{StaticResource FleetListViewItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionChanged="OnNotificationSelected" />

                    <ScrollViewer x:Name="CommitsScroller" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="CommitsList" ItemTemplate="{StaticResource RepositoryCommitsTemplate}" />
                    </ScrollViewer>

                    <ListView x:Name="PipelinesList" BorderThickness="0" SelectionMode="Single" Visibility="Collapsed"
                              ItemTemplate="{StaticResource PipelineRunRowTemplate}"
                              ItemContainerStyle="{StaticResource FleetListViewItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionChanged="OnRunSelected" />

                    <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="16" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Opacity="0.7" />
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Right: inline detail -->
        <Grid Grid.Column="2" Margin="10,0,0,0">
            <TextBlock x:Name="DetailPlaceholder" Text="Select a pull request, notification, commit or run."
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />

            <StackPanel x:Name="NonPullRequestPanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                <TextBlock x:Name="NonPullRequestTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                           TextAlignment="Center" />
                <TextBlock x:Name="NonPullRequestByline" FontSize="11" Margin="0,4,0,12" Opacity="0.7"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <Button Content="Open in browser" HorizontalAlignment="Center" Padding="12,4"
                        Click="OnOpenNotificationInBrowser" />
            </StackPanel>

            <shared:PullRequestDetailView x:Name="DetailView" Visibility="Collapsed" />
            <local:CommitDetailView x:Name="CommitView" Visibility="Collapsed" />
            <local:PipelineRunView x:Name="RunView" Visibility="Collapsed" />
        </Grid>

        <GridSplitter x:Name="ActivitySplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch"
                      Background="Transparent" />

        <!-- Right: comments and reviews across every loaded pull request, newest first. -->
        <Grid x:Name="ActivityPanel" Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,4,0,8">
                <CheckBox x:Name="HideMineCheck" DockPanel.Dock="Right" Content="Hide mine" FontSize="11"
                          MinWidth="0" Checked="OnHideMineChanged" Unchecked="OnHideMineChanged" />
                <TextBlock Text="Activity" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
            </DockPanel>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <ListView x:Name="ActivityList" BorderThickness="0" SelectionMode="Single"
                              ItemTemplate="{StaticResource ActivityRowTemplate}"
                              ItemContainerStyle="{StaticResource FleetListViewItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionChanged="OnActivitySelected" />
                    <TextBlock x:Name="ActivityEmpty" Text="No recent comments." Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
