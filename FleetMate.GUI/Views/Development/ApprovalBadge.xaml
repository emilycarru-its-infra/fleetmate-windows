<!-- Small hand on a run's status icon while an approval holds it. A symbol,
     never a count, and never red. -->
<UserControl x:Class="FleetMate.GUI.Views.Development.ApprovalBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="11" Height="11" IsHitTestVisible="False" Focusable="False"
             AutomationProperties.Name="Waiting for approval">
    <Grid>
        <Ellipse Fill="{DynamicResource SystemControlBackgroundAltHighBrush}" Margin="-1" />
        <Ellipse Fill="#E07A1F" />
        <TextBlock Text="&#x270B;" FontFamily="Segoe UI Symbol" FontSize="7" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
