<Page x:Class="FleetMate.GUI.Views.Development.DevelopmentPage"
      Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:local="clr-namespace:FleetMate.GUI.Views.Development">

    <Grid Margin="16,14,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Development" Style="{StaticResource TitleTextStyle}" />
                <TextBlock Text="Every open pull request across Azure DevOps and GitHub, and your GitHub inbox"
                           Style="{StaticResource SubtitleTextStyle}" />
            </StackPanel>

            <!-- Activity and Refresh share one toolbar group, as on macOS. -->
            <ui:SimpleStackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ToggleButton x:Name="ActivityToggle" IsChecked="True" Click="OnActivityToggled"
                              ToolTip="Show or hide recent comments across every pull request">
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                        <ui:FontIcon Glyph="&#xE8BD;" FontSize="13" />
                        <TextBlock Text="Activity" />
                    </ui:SimpleStackPanel>
                </ToggleButton>
                <Button Click="OnRefreshClicked" ToolTip="Refresh pull requests, inbox, commits and pipelines">
                    <ui:SymbolIcon Symbol="Refresh" />
                </Button>
            </ui:SimpleStackPanel>
        </Grid>

        <local:DevelopmentView x:Name="View" Grid.Row="1" Margin="0,16,0,0" />
    </Grid>
</Page>
