<Page x:Class="FleetMate.GUI.Views.Development.DevelopmentPage"
      Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:local="clr-namespace:FleetMate.GUI.Views.Development"
      xmlns:widgets="clr-namespace:FleetMate.GUI.Views.Shared.Widgets">

    <Grid Margin="16,14,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- No page heading: the tab bar names the tab, and the sub-tabs,
             Inbox and Refresh sit in the window's title bar, as on Mac. -->
        <widgets:WidgetsSection x:Name="Widgets" Grid.Row="0" Tab="Development" Margin="0,0,0,0" />

        <local:DevelopmentView x:Name="View" Grid.Row="1" Margin="0,8,0,0" />
    </Grid>
</Page>
