<UserControl x:Class="FleetMate.GUI.Views.Development.PipelineRunView"
             Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="RerunButton" Content="Rerun" Padding="10,3" Margin="0,0,6,0" Click="OnRerunClicked" />
                    <Button x:Name="CancelButton" Content="Cancel run" Padding="10,3" Margin="0,0,6,0" Click="OnCancelClicked" />
                    <Button Padding="8,3" Margin="0,0,6,0" Click="OnReloadClicked" ToolTip="Reload log">
                        <ui:FontIcon Glyph="&#xE72C;" FontSize="13" />
                    </Button>
                    <Button Padding="8,3" Click="OnOpenInBrowserClicked" ToolTip="Open in browser">
                        <ui:FontIcon Glyph="&#xE8A7;" FontSize="13" />
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="WhereText" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>
            </DockPanel>

            <WrapPanel Margin="0,8,0,0">
                <Border x:Name="StatusPill" CornerRadius="10" Padding="8,2" Margin="0,0,10,0"
                        Background="{DynamicResource SubtleFillBrush}">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon x:Name="StatusIcon" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="DetailsText" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </WrapPanel>
            <TextBlock x:Name="ActionStatus" FontSize="11" Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsActive="True" Width="32" Height="32" />
                <TextBlock Text="Loading log…" Margin="0,8,0,0"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="460"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

            <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="TruncationNotice" FontSize="10" Margin="0,0,0,6" Visibility="Collapsed"
                               Foreground="#E07A1F" Text="⚠ long sections show their last 400 KB" />
                    <ItemsControl x:Name="SectionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,6"
                                          HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:FontIcon Glyph="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}"
                                                         FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <!-- A read-only TextBox so a log line can be selected and copied. -->
                                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                                             FontSize="11" TextWrapping="NoWrap" MaxHeight="520"
                                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                             BorderThickness="0" Background="{DynamicResource SubtleFillBrush}" />
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
