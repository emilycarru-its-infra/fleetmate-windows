<UserControl x:Class="FleetMate.GUI.Views.Inventory.AssetDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:FleetMate.GUI.Views.Shared"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Hero header: what the asset IS at a glance — icon, name, the two
             identifiers everyone copies, where it stands, and its lifecycle. -->
        <StackPanel Grid.Row="0" Margin="16,14,16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Margin="0,0,12,0"
                        Background="{DynamicResource SystemControlBackgroundAccentBrush}" Opacity="0.9"
                        VerticalAlignment="Top">
                    <ui:FontIcon x:Name="CategoryIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xF158;"
                                 FontSize="24" Foreground="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ModelText" FontSize="12" Margin="0,2,0,0"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>

                <!-- Details | History, then the actions — all one 28px row. The
                     segment choice sticks as you move between assets. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border CornerRadius="8" Padding="2" Margin="0,0,8,0" Height="28"
                            BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="DetailsSegment" Content="Details" GroupName="AssetDetailSegment"
                                         IsChecked="True" Checked="OnSegmentChanged" Padding="9,2"
                                         Style="{StaticResource NavigationTabStyle}" />
                            <RadioButton x:Name="HistorySegment" Content="History" GroupName="AssetDetailSegment"
                                         Checked="OnSegmentChanged" Padding="9,2"
                                         Style="{StaticResource NavigationTabStyle}" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="ReAllocateButton" Click="OnReAllocateClicked" Margin="0,0,6,0"
                            Height="28" Padding="10,0"
                            Background="{DynamicResource SystemControlBackgroundAccentBrush}" Foreground="White">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE748;" FontSize="12"
                                         Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Re-Allocate" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <shared:AgentContextButton x:Name="AgentButton" Width="28" Height="28" Padding="0" Margin="0,0,6,0"
                                               BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" />
                    <Button Click="OnOpenInSnipeClicked" ToolTip="Open in Snipe-IT" Width="28" Height="28"
                            Padding="0" Margin="0,0,6,0"
                            BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;" FontSize="12" />
                    </Button>
                    <Button Click="OnCloseClicked" ToolTip="Close" Width="28" Height="28" Padding="0"
                            BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- Identity chips: tag and serial as copyable chips, status pill. -->
                    <StackPanel x:Name="ChipsRow" Orientation="Horizontal" />
                    <StackPanel x:Name="WhoWhereRow" Orientation="Horizontal" Margin="0,8,0,0" />
                    <StackPanel x:Name="LifecycleHost" Margin="0,8,0,0" MaxWidth="360" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- The photo lives in what was dead space — as the manufacturer
                     ships it: no frame, no rounding, no border. -->
                <Image x:Name="AssetPhoto" Grid.Column="1" MaxHeight="112" MaxWidth="150"
                       Stretch="Uniform" VerticalAlignment="Top" Margin="12,0,0,0" />
            </Grid>
        </StackPanel>

        <!-- Scrollable cards, in priority order: state and people first, the
             machine itself and money second, identifiers and metadata after. -->
        <ScrollViewer x:Name="DetailsView" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="CardsHost" Margin="16,0,16,16" />
        </ScrollViewer>

        <!-- Change history, newest first: one card per event, field changes under it. -->
        <Grid x:Name="HistoryView" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="16,0,16,8">
                <TextBlock x:Name="HistoryCountText" DockPanel.Dock="Right" FontSize="11" Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <TextBox x:Name="HistoryFilterBox" TextChanged="OnHistoryFilterChanged"
                         ui:ControlHelper.PlaceholderText="Filter history" />
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="HistoryHost" Margin="16,0,16,16" />
            </ScrollViewer>
            <ui:ProgressRing x:Name="HistoryLoadingRing" Grid.Row="1" Width="24" Height="24"
                             IsActive="False" Visibility="Collapsed"
                             HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" />
        </Grid>
    </Grid>
</UserControl>
