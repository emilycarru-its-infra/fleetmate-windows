<Application x:Class="FleetMate.GUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:local="clr-namespace:FleetMate.GUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- App palette: layered surfaces like the macOS app. ModernWPF's
                     Alt* brushes resolve to pure black/white, which is why an
                     unthemed dark window reads as a black void. The custom brushes
                     must live in ThemeResources' own ThemeDictionaries — a separate
                     ResourceDictionaryEx in App.Resources is never theme-resolved. -->
                <ui:ThemeResources>
                    <ui:ThemeResources.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F5F7" />
                            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E3E7" />
                            <SolidColorBrush x:Key="SubtleFillBrush" Color="#E9E9EC" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#232326" />
                            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2C2C30" />
                            <SolidColorBrush x:Key="CardBorderBrush" Color="#3C3C41" />
                            <SolidColorBrush x:Key="SubtleFillBrush" Color="#37373C" />
                        </ResourceDictionary>
                    </ui:ThemeResources.ThemeDictionaries>
                </ui:ThemeResources>
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <!-- Custom Colors -->
            <Color x:Key="FleetMateAccentColor">#0078D4</Color>
            <SolidColorBrush x:Key="FleetMateAccentBrush" Color="{StaticResource FleetMateAccentColor}" />

            <!-- Shared surfaces -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <!-- Compact, centered navigation used by the main window. -->
            <Style x:Key="NavigationTabStyle" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="11,5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource SubtleFillBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource SubtleFillBrush}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ChromeIconButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style x:Key="FleetListViewItemStyle" TargetType="ListViewItem">
                <!-- This style REPLACES the implicit themed ListViewItem style, so
                     without an explicit Foreground every row falls back to WPF's
                     default black — invisible in dark mode. -->
                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="5,2" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="BorderThickness" Value="0" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
                        <Setter Property="Foreground" Value="White" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- The stock WPF DataGrid paints a white body, white headers, and
                 black text regardless of the ModernWPF theme, so every surface
                 it owns is restated in theme brushes here. -->
            <Style x:Key="FleetDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="FleetDataGridCellStyle" TargetType="DataGridCell">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" Padding="8,0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FleetDataGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <Style x:Key="FleetDataGridStyle" TargetType="DataGrid">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="RowHeight" Value="27" />
                <Setter Property="ColumnHeaderHeight" Value="29" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <!-- No grid lines, no alternating stripes: rows read like the
                     macOS list, not a spreadsheet. -->
                <Setter Property="GridLinesVisibility" Value="None" />
                <Setter Property="AlternatingRowBackground" Value="Transparent" />
                <Setter Property="RowBackground" Value="Transparent" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource FleetDataGridColumnHeaderStyle}" />
                <Setter Property="CellStyle" Value="{StaticResource FleetDataGridCellStyle}" />
                <Setter Property="RowStyle" Value="{StaticResource FleetDataGridRowStyle}" />
            </Style>

            <!-- Typography -->
            <Style x:Key="TitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0" />
            </Style>

            <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
