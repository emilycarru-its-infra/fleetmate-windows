<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <AssemblyName>fleetmate-gui</AssemblyName>
    <AssemblyTitle>FleetMate</AssemblyTitle>
    <AssemblyDescription>FleetMate Fleet Management</AssemblyDescription>
    <AssemblyCompany>Example Organisation</AssemblyCompany>
    <AssemblyProduct>FleetMate</AssemblyProduct>
    <!-- AssemblyVersion and FileVersion follow Version, so a release build's
         -p:Version stamps the exe the same way it stamps the CLI. -->
    <Version>1.0.0</Version>
    <StartupObject>FleetMate.GUI.Program</StartupObject>
    <ApplicationIcon>Assets\FleetMate.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <WindowsSdkPackageVersion>10.0.19041.38</WindowsSdkPackageVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CsWinRTEnabled>false</CsWinRTEnabled>
    <CsWinRTAotOptimizerEnabled>false</CsWinRTAotOptimizerEnabled>
  </PropertyGroup>

  <!-- Edition: FleetMate by default. -p:Edition=TicketsMate builds TicketsMate,
       the Tickets tab alone, as TicketsMate.exe with its own icon. The exe's
       FleetMateEdition metadata is what the app reads at run time
       (FleetMate.Core/Config/AppEdition.cs). -->
  <PropertyGroup>
    <Edition Condition="'$(Edition)' == ''">FleetMate</Edition>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Edition)' == 'TicketsMate'">
    <AssemblyName>TicketsMate</AssemblyName>
    <AssemblyTitle>TicketsMate</AssemblyTitle>
    <AssemblyDescription>TicketsMate service desk</AssemblyDescription>
    <AssemblyProduct>TicketsMate</AssemblyProduct>
    <ApplicationIcon>Assets\TicketsMate.ico</ApplicationIcon>
    <!-- FleetMate's own bin and obj sit beside TicketsMate's; keep their
         generated sources out of this build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup Condition="'$(Edition)' == 'TicketsMate'">
    <AssemblyMetadata Include="FleetMateEdition" Value="TicketsMate" />
  </ItemGroup>
  <Target Name="CheckEdition" BeforeTargets="Build">
    <Error Condition="'$(Edition)' != 'FleetMate' And '$(Edition)' != 'TicketsMate'"
           Text="Edition must be FleetMate or TicketsMate, not '$(Edition)'." />
  </Target>

  <!-- The terminal page and xterm.js (MIT, see LICENSE.xterm.txt) ship inside
       the exe and are served to WebView2 from a private virtual host. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Terminal\*.html;Assets\Terminal\*.js;Assets\Terminal\*.css"
                      LogicalName="FleetMate.GUI.Terminal.%(Filename)%(Extension)" />
    <None Include="Assets\Terminal\LICENSE.xterm.txt" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\FleetMate.ico" />
    <Resource Include="Assets\FleetMate.png" />
    <Resource Include="Assets\TicketsMate.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc3.3" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.122" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FleetMate.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FleetMate.Core\FleetMate.Core.csproj" />
    <!-- The Reporting tab is the ReportMate dashboard itself, built from the
         ReportMate app's own source (external/, a submodule kept on its main
         branch by .github/workflows/reportmate-sync.yml). -->
    <ProjectReference Include="..\external\reportmate-app-csharp\src\ReportMate.UI.csproj" />
  </ItemGroup>

</Project>
