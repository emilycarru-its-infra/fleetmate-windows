<?xml version="1.0" encoding="UTF-8"?>

<!-- WiX v6 installer for TicketsMate, the Tickets-only edition of FleetMate.
     The same shape as FleetMate.Installer, less the operator CLI: one
     self-contained TicketsMate.exe in Program Files, a Start Menu shortcut,
     and the registry values Intune uses for detection. Its own UpgradeCode
     and install folder let it sit beside FleetMate on the same machine. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <?ifndef ProductVersion?>
    <?define ProductVersion = "0.0.0"?>
  <?endif?>
  <?ifndef CalendarVersion?>
    <?define CalendarVersion = "$(var.ProductVersion)"?>
  <?endif?>

  <Package Name="TicketsMate"
           Version="$(var.ProductVersion)"
           Manufacturer="Example Organisation"
           UpgradeCode="{0836EE35-6B9E-4E04-A50A-FB919AAD237F}"
           Language="1033"
           InstallerVersion="500"
           Compressed="yes"
           Scope="perMachine">

    <Property Id="MSIUSEREALADMINDETECTION" Value="1" />

    <!-- The real calendar version, for cimiimport, as in FleetMate.Installer. -->
    <Property Id="CIMIAN_PKG_FULL_VERSION" Value="$(var.CalendarVersion)" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  AllowDowngrades="no"
                  MigrateFeatures="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                  Schedule="afterInstallInitialize" />

    <Media Id="1" Cabinet="ticketsmate.cab" EmbedCab="yes" />

    <!-- The app icon, for the Start Menu shortcut and Installed apps. -->
    <Icon Id="TicketsMate.ico" SourceFile="$(var.ICON_FILE)" />
    <Property Id="ARPPRODUCTICON" Value="TicketsMate.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="TicketsMate" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Scope="perMachine" resolves ProgramMenuFolder to the all-users
         Programs folder. The shortcut is installed with the exe and removed
         with it on uninstall, like every file the MSI owns. -->
    <Component Id="TicketsMateExecutable" Directory="INSTALLDIR" Guid="{CDDB0235-3E53-4DF0-90EF-D7E91B252E7A}">
      <File Id="TicketsMateExe" Source="$(var.BIN_DIR)\TicketsMate.exe" KeyPath="yes" Vital="yes">
        <Shortcut Id="TicketsMateStartMenuShortcut"
                  Directory="ProgramMenuFolder"
                  Name="TicketsMate"
                  Description="TicketsMate service desk"
                  WorkingDirectory="INSTALLDIR"
                  Icon="TicketsMate.ico"
                  Advertise="yes" />
      </File>
    </Component>

    <Component Id="RegistryEntries" Directory="INSTALLDIR" Guid="{069BC378-E66B-441A-9F13-9B656EDF00E7}">
      <RegistryValue Root="HKLM" Key="SOFTWARE\TicketsMate" Name="InstallPath" Value="[INSTALLDIR]" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\TicketsMate" Name="Version" Value="$(var.CalendarVersion)" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\TicketsMate" Name="InstallDate" Value="[Date]" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\TicketsMate" Name="Architecture" Value="[ProcessorArchitecture]" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\TicketsMate" Name="LastRunVersion" Value="$(var.CalendarVersion)" Type="string" />
    </Component>

    <Component Id="TicketsMateProtocol" Directory="INSTALLDIR" Guid="{DFB8393C-CA3F-469B-8743-2B51155D868A}">
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\ticketsmate" Value="URL:TicketsMate" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\ticketsmate" Name="URL Protocol" Value="" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\ticketsmate\shell\open\command" Value="&quot;[#TicketsMateExe]&quot; &quot;%1&quot;" Type="string" />
    </Component>

    <!-- The inbox helper: the same exe with the inbox-agent switch, started at every
         user's sign-in. No window or tray icon; it keeps the ticket Inbox
         current and exits at once for anyone without TeamDynamix set up. -->
    <Component Id="TicketsMateInboxAgent" Directory="INSTALLDIR" Guid="{5EF6CBCB-2D33-4777-BC13-B895AAAF5E82}">
      <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="TicketsMate Inbox"
                     Value="&quot;[#TicketsMateExe]&quot; --inbox-agent" Type="string" KeyPath="yes" />
    </Component>

    <Feature Id="DefaultFeature" Level="1">
      <ComponentRef Id="TicketsMateProtocol" />
      <ComponentRef Id="TicketsMateExecutable" />
      <ComponentRef Id="RegistryEntries" />
      <ComponentRef Id="TicketsMateInboxAgent" />
    </Feature>

  </Package>

</Wix>
