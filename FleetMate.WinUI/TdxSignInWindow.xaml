<Window
    x:Class="FleetMate.WinUI.TdxSignInWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Loaded="OnLoaded">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <StackPanel Padding="20,14" Spacing="4">
            <TextBlock Text="TeamDynamix sign-in" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="Status" Text="Opening your organization sign-in…" Opacity="0.65" />
        </StackPanel>
        <WebView2 x:Name="Browser" Grid.Row="1" NavigationCompleted="OnNavigationCompleted" />
    </Grid>
</Window>
