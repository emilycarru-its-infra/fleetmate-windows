<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FleetMate.WinUI.Pages.Manage.ManagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:FleetMate.Core.Manage"
    xmlns:local="using:FleetMate.WinUI.Pages.Manage"
    xmlns:models="using:FleetMate.Core.Models.Manage"
    NavigationCacheMode="Required">

    <!--
        The Manage tab, laid out as FleetMate for Mac's: the roster sidebar,
        the room's machines beside the command runner and its results, and an
        inspector for one machine. Below 1100 pixels the runner moves under the
        list; below 1240 the inspector floats over the content.
    -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" />
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="Refresh_Invoked" />
        <KeyboardAccelerator Key="R" Modifiers="Control,Shift" Invoked="ReloadRoster_Invoked" />
        <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="Scan_Invoked" />
        <KeyboardAccelerator Key="A" Modifiers="Control,Shift" Invoked="SelectOnline_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <Style x:Key="SidebarHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1,7,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SidebarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Padding" Value="6" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style x:Key="SidebarListStyle" TargetType="ListView">
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="CanDragItems" Value="True" />
            <Setter Property="CanReorderItems" Value="True" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="HeaderCellStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="4,4,4,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="CellStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="DimCellStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="RowListStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="8,0,8,0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="RoomTemplate" x:DataType="core:SidebarRoom">
            <Grid Padding="0,5" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle
                    Grid.ColumnSpan="2"
                    Height="2"
                    Margin="0,-5,0,0"
                    VerticalAlignment="Top"
                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                    Visibility="{x:Bind local:ManagePage.Show(IsDropTarget), Mode=OneWay}" />
                <FontIcon FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{x:Bind Glyph}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind Title}" TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Subtitle}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GroupTemplate" x:DataType="models:CustomGroup">
            <Grid Padding="0,5" ColumnSpacing="10">
                <Grid.ContextFlyout>
                    <MenuFlyout Opening="GroupMenu_Opening">
                        <MenuFlyoutItem Click="AddDevicesToGroup_Click" Text="Add devices…">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="RenameGroup_Click" Text="Rename…">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="DeleteGroup_Click" Text="Delete group…">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE902;" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind Name}" TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind core:ManageText.Machines(Devices.Count)}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SearchTemplate" x:DataType="local:ComputerRow">
            <StackPanel Padding="0,5">
                <TextBlock Text="{x:Bind Title}" TextWrapping="WrapWholeWords" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Detail}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </DataTemplate>

        <MenuFlyout x:Key="RowMenu" Opening="RowMenu_Opening">
            <MenuFlyoutItem Click="RowSsh_Click" Text="Open SSH">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE756;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="RowRdp_Click" Text="Open Remote Desktop">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7F4;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="RowBoth_Click" Text="Open SSH and Remote Desktop" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="RowRescan_Click" Text="Rescan">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="RowProbe_Click" Text="Fetch details" />
            <MenuFlyoutItem Click="InstallPackage_Click" Text="Install Package…" />
            <MenuFlyoutItem Click="RowInfo_Click" Text="Show details">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutSubItem Text="Copy">
                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutSubItem.Icon>
                <MenuFlyoutItem Click="CopyHostname_Click" Text="Hostname" />
                <MenuFlyoutItem Click="CopyIp_Click" Text="IP address" />
                <MenuFlyoutItem Click="CopySerial_Click" Text="Serial number" />
                <MenuFlyoutItem Click="CopyAsset_Click" Text="Asset tag" />
                <MenuFlyoutItem Click="CopyOs_Click" Text="OS version" />
                <MenuFlyoutItem Click="CopyAllInfo_Click" Text="All info" />
            </MenuFlyoutSubItem>
            <MenuFlyoutSubItem Text="Copy selected">
                <MenuFlyoutItem Click="CopySelectedHostnames_Click" Text="Hostnames" />
                <MenuFlyoutItem Click="CopySelectedAssets_Click" Text="Asset tags" />
                <MenuFlyoutItem Click="CopySelectedInventory_Click" Text="Inventory lines" />
            </MenuFlyoutSubItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="AddSelectedToGroup_Click" Text="Add to custom group…">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE902;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <DataTemplate x:Key="CompactRowTemplate" x:DataType="core:MachineRowViewModel">
            <Grid MinHeight="44" ContextFlyout="{StaticResource RowMenu}" Opacity="{x:Bind local:ManagePage.RowOpacity(HasAddress), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    MinWidth="0"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind local:ManagePage.CheckName(FriendlyName)}"
                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                <Ellipse
                    Grid.Column="1"
                    Width="9"
                    Height="9"
                    Fill="{x:Bind local:ManagePage.StatusBrush(StatusKey), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind StatusLabel, Mode=OneWay}" />
                <StackPanel Grid.Column="2" Margin="4,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind FriendlyName}" TextWrapping="WrapWholeWords" />
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Glyph="&#xE192;"
                            ToolTipService.ToolTip="sshd rejected the shared admin key on this machine"
                            Visibility="{x:Bind local:ManagePage.Show(SshAuthFailed), Mode=OneWay}" />
                        <ProgressRing Width="12" Height="12" IsActive="{x:Bind IsProbing, Mode=OneWay}" Visibility="{x:Bind local:ManagePage.Show(IsProbing), Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind local:ManagePage.SecondName(FriendlyName, Hostname)}"
                        Visibility="{x:Bind local:ManagePage.SecondNameVisibility(FriendlyName, Hostname)}" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CellStyle}" Text="{x:Bind AddressLabel, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource DimCellStyle}" Text="{x:Bind SourceLabel, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Grid.Column="4" Style="{StaticResource CellStyle}" Text="{x:Bind UserLabel, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="5"
                    Style="{StaticResource DimCellStyle}"
                    Text="{x:Bind RemoteAccessLabel, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind RemoteAccessHelp, Mode=OneWay}" />
                <StackPanel Grid.Column="6" Margin="4,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                    <Button Padding="8,3,8,4" Click="RowSshButton_Click" Content="SSH" IsEnabled="{x:Bind HasAddress, Mode=OneWay}" ToolTipService.ToolTip="Open an SSH session in Windows Terminal" />
                    <Button Padding="8,3,8,4" Click="RowRdpButton_Click" Content="RDP" IsEnabled="{x:Bind HasAddress, Mode=OneWay}" ToolTipService.ToolTip="Open Remote Desktop" />
                    <Button Padding="6" AutomationProperties.Name="{x:Bind local:ManagePage.DetailsName(FriendlyName)}" Click="RowInfoButton_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Show everything known about this machine">
                        <FontIcon FontSize="14" Glyph="&#xE946;" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ExtendedRowTemplate" x:DataType="core:MachineRowViewModel">
            <Grid MinHeight="44" ContextFlyout="{StaticResource RowMenu}" Opacity="{x:Bind local:ManagePage.RowOpacity(HasAddress), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    MinWidth="0"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind local:ManagePage.CheckName(FriendlyName)}"
                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                <Ellipse
                    Grid.Column="1"
                    Width="9"
                    Height="9"
                    Fill="{x:Bind local:ManagePage.StatusBrush(StatusKey), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind StatusLabel, Mode=OneWay}" />
                <StackPanel Grid.Column="2" Margin="4,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind FriendlyName}" TextWrapping="WrapWholeWords" />
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Glyph="&#xE192;"
                            ToolTipService.ToolTip="sshd rejected the shared admin key on this machine"
                            Visibility="{x:Bind local:ManagePage.Show(SshAuthFailed), Mode=OneWay}" />
                        <ProgressRing Width="12" Height="12" IsActive="{x:Bind IsProbing, Mode=OneWay}" Visibility="{x:Bind local:ManagePage.Show(IsProbing), Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind local:ManagePage.SecondName(FriendlyName, Hostname)}"
                        Visibility="{x:Bind local:ManagePage.SecondNameVisibility(FriendlyName, Hostname)}" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CellStyle}" Text="{x:Bind AddressLabel, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource DimCellStyle}" Text="{x:Bind SourceLabel, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Grid.Column="4" Style="{StaticResource CellStyle}" Text="{x:Bind UserLabel, Mode=OneWay}" />
                <TextBlock Grid.Column="5" Style="{StaticResource DimCellStyle}" Text="{x:Bind OsLabel, Mode=OneWay}" />
                <TextBlock Grid.Column="6" Style="{StaticResource DimCellStyle}" Text="{x:Bind UptimeLabel, Mode=OneWay}" />
                <TextBlock Grid.Column="7" Style="{StaticResource DimCellStyle}" Text="{x:Bind JoinLabel, Mode=OneWay}" />
                <TextBlock Grid.Column="8" Style="{StaticResource DimCellStyle}" Text="{x:Bind CimianLabel, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="9"
                    Style="{StaticResource DimCellStyle}"
                    Text="{x:Bind RemoteAccessLabel, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind RemoteAccessHelp, Mode=OneWay}" />
                <StackPanel Grid.Column="10" Margin="4,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                    <Button Padding="8,3,8,4" Click="RowSshButton_Click" Content="SSH" IsEnabled="{x:Bind HasAddress, Mode=OneWay}" ToolTipService.ToolTip="Open an SSH session in Windows Terminal" />
                    <Button Padding="8,3,8,4" Click="RowRdpButton_Click" Content="RDP" IsEnabled="{x:Bind HasAddress, Mode=OneWay}" ToolTipService.ToolTip="Open Remote Desktop" />
                    <Button Padding="6" AutomationProperties.Name="{x:Bind local:ManagePage.DetailsName(FriendlyName)}" Click="RowInfoButton_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Show everything known about this machine">
                        <FontIcon FontSize="14" Glyph="&#xE946;" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <MenuFlyout x:Key="ResultMenu" Opening="ResultMenu_Opening">
            <MenuFlyoutItem Click="ResultSsh_Click" Text="Open SSH" />
            <MenuFlyoutItem Click="ResultRdp_Click" Text="Open Remote Desktop" />
            <MenuFlyoutItem Click="ResultBoth_Click" Text="Open SSH and Remote Desktop" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="ResultCopyHostname_Click" Text="Copy hostname" />
            <MenuFlyoutItem Click="ResultCopyIp_Click" Text="Copy IP address" />
            <MenuFlyoutItem Click="ResultCopyHostnameIp_Click" Text="Copy hostname and IP" />
            <MenuFlyoutItem Click="ResultCopyOutput_Click" Text="Copy output" />
            <MenuFlyoutItem Click="ResultCopyError_Click" Text="Copy error" />
            <MenuFlyoutItem Click="ResultCopyFull_Click" Text="Copy full result" />
        </MenuFlyout>

        <DataTemplate x:Key="ResultTemplate" x:DataType="core:CommandResultViewModel">
            <Expander
                Margin="0,2"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                ContextFlyout="{StaticResource ResultMenu}"
                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                <Expander.Header>
                    <Grid Padding="0,6" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            Width="9"
                            Height="9"
                            Fill="{x:Bind local:ManagePage.StatusBrush(StatusKey), Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind StatusTooltip, Mode=OneWay}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" TextWrapping="WrapWholeWords" />
                            <TextBlock
                                FontFamily="Consolas"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Preview, Mode=OneWay}"
                                TextWrapping="Wrap"
                                MaxLines="2"
                                Visibility="{x:Bind local:ManagePage.HasText(Preview), Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Ip}" />
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="72">
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind StatusLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind StatusTooltip, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind DurationLabel, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="6">
                    <TextBox
                        MaxHeight="260"
                        AutomationProperties.Name="Output"
                        FontFamily="Consolas"
                        FontSize="12"
                        IsReadOnly="True"
                        Text="{x:Bind Output, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:ManagePage.Show(HasOutput), Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="stderr"
                        Visibility="{x:Bind local:ManagePage.Show(HasError), Mode=OneWay}" />
                    <TextBox
                        MaxHeight="160"
                        AutomationProperties.Name="Error output"
                        FontFamily="Consolas"
                        FontSize="12"
                        IsReadOnly="True"
                        Text="{x:Bind ErrorOutput, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:ManagePage.Show(HasError), Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="(no output)"
                        Visibility="{x:Bind local:ManagePage.Hide(HasOutput), Mode=OneWay}" />
                </StackPanel>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="CategoryTemplate" x:DataType="models:CommandCategory">
            <TextBlock Text="{x:Bind Name}" />
        </DataTemplate>
        <DataTemplate x:Key="CommandTemplate" x:DataType="models:ManagedCommand">
            <TextBlock Text="{x:Bind Label}" />
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="Root" SizeChanged="Root_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="264" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <!-- MARK: Sidebar -->
        <Border
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="SectionsScroll" Padding="8,8,8,0">
                    <StackPanel Spacing="2">
                        <!-- Curriculum (labs) -->
                        <Grid Margin="8,6,0,2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SidebarHeaderStyle}" Text="CURRICULUM" />
                            <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                <TextBlock x:Name="LabsCount" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                            <Button
                                Grid.Column="3"
                                AutomationProperties.Name="Pick several labs"
                                Click="LabPicker_Click"
                                Style="{StaticResource SidebarIconButtonStyle}"
                                ToolTipService.ToolTip="Pick several labs to work on together">
                                <FontIcon FontSize="12" Glyph="&#xE762;" />
                            </Button>
                            <Button
                                x:Name="LabsToggle"
                                Grid.Column="4"
                                Click="ToggleSection_Click"
                                Style="{StaticResource SidebarIconButtonStyle}"
                                Tag="Labs">
                                <FontIcon FontSize="10" Glyph="&#xE70D;" />
                            </Button>
                        </Grid>
                        <ListView
                            x:Name="LabsList"
                            AutomationProperties.Name="Curriculum labs"
                            DragItemsCompleted="SectionList_DragItemsCompleted"
                            ItemTemplate="{StaticResource RoomTemplate}"
                            SelectionChanged="RoomList_SelectionChanged"
                            Style="{StaticResource SidebarListStyle}"
                            Tag="Labs">
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="ResetOrder_Click" Tag="Labs" Text="Reset order" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        </ListView>

                        <!-- Kiosks -->
                        <Grid Margin="8,10,0,2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SidebarHeaderStyle}" Text="KIOSKS" />
                            <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                <TextBlock x:Name="KiosksCount" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                            <Button
                                x:Name="KiosksToggle"
                                Grid.Column="3"
                                Click="ToggleSection_Click"
                                Style="{StaticResource SidebarIconButtonStyle}"
                                Tag="Kiosks">
                                <FontIcon FontSize="10" Glyph="&#xE70D;" />
                            </Button>
                        </Grid>
                        <ListView
                            x:Name="KiosksList"
                            AutomationProperties.Name="Kiosks"
                            DragItemsCompleted="SectionList_DragItemsCompleted"
                            ItemTemplate="{StaticResource RoomTemplate}"
                            SelectionChanged="RoomList_SelectionChanged"
                            Style="{StaticResource SidebarListStyle}"
                            Tag="Kiosks">
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="ResetOrder_Click" Tag="Kiosks" Text="Reset order" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        </ListView>

                        <!-- Staff -->
                        <Grid Margin="8,10,0,2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SidebarHeaderStyle}" Text="STAFF" />
                            <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                <TextBlock x:Name="StaffCount" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                            <Button
                                x:Name="StaffToggle"
                                Grid.Column="3"
                                Click="ToggleSection_Click"
                                Style="{StaticResource SidebarIconButtonStyle}"
                                Tag="Staff">
                                <FontIcon FontSize="10" Glyph="&#xE70D;" />
                            </Button>
                        </Grid>
                        <ListView
                            x:Name="StaffList"
                            AutomationProperties.Name="Staff"
                            DragItemsCompleted="SectionList_DragItemsCompleted"
                            ItemTemplate="{StaticResource RoomTemplate}"
                            SelectionChanged="RoomList_SelectionChanged"
                            Style="{StaticResource SidebarListStyle}"
                            Tag="Staff">
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="ResetOrder_Click" Tag="Staff" Text="Reset order" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        </ListView>

                        <!-- Faculty -->
                        <Grid Margin="8,10,0,2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SidebarHeaderStyle}" Text="FACULTY" />
                            <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                <TextBlock x:Name="FacultyCount" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                            <Button
                                x:Name="FacultyToggle"
                                Grid.Column="3"
                                Click="ToggleSection_Click"
                                Style="{StaticResource SidebarIconButtonStyle}"
                                Tag="Faculty">
                                <FontIcon FontSize="10" Glyph="&#xE70D;" />
                            </Button>
                        </Grid>
                        <ListView
                            x:Name="FacultyList"
                            AutomationProperties.Name="Faculty"
                            DragItemsCompleted="SectionList_DragItemsCompleted"
                            ItemTemplate="{StaticResource RoomTemplate}"
                            SelectionChanged="RoomList_SelectionChanged"
                            Style="{StaticResource SidebarListStyle}"
                            Tag="Faculty">
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="ResetOrder_Click" Tag="Faculty" Text="Reset order" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        </ListView>

                        <!-- Custom groups -->
                        <Grid Margin="8,10,0,2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SidebarHeaderStyle}" Text="CUSTOM GROUPS" />
                            <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                <TextBlock x:Name="GroupsCount" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                            <Button
                                Grid.Column="3"
                                AutomationProperties.Name="New custom group"
                                Click="CreateGroup_Click"
                                Style="{StaticResource SidebarIconButtonStyle}"
                                ToolTipService.ToolTip="New custom group">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                            </Button>
                        </Grid>
                        <ListView
                            x:Name="GroupsList"
                            AutomationProperties.Name="Custom groups"
                            CanDragItems="False"
                            CanReorderItems="False"
                            AllowDrop="False"
                            ItemTemplate="{StaticResource GroupTemplate}"
                            ItemsSource="{x:Bind ViewModel.CustomGroups}"
                            SelectionChanged="GroupsList_SelectionChanged"
                            Style="{StaticResource SidebarListStyle}" />
                        <TextBlock
                            x:Name="NoGroupsText"
                            Margin="12,2,12,8"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="No groups yet" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Search results replace the sections while the toolbar search has text. -->
                <Grid x:Name="SearchPanel" Padding="8,8,8,0" RowSpacing="6" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="8,0,0,0" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SearchCount" VerticalAlignment="Center" Style="{StaticResource SidebarHeaderStyle}" />
                        <Button Grid.Column="1" Click="SearchSelectAll_Click" Content="All" />
                        <Button
                            Grid.Column="2"
                            Click="UseSearch_Click"
                            Content="Use"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Work on the selected matches, or on every match when none is selected" />
                    </Grid>
                    <ListView
                        x:Name="SearchList"
                        Grid.Row="1"
                        AutomationProperties.Name="Matching machines"
                        ItemTemplate="{StaticResource SearchTemplate}"
                        SelectionMode="Extended" />
                </Grid>

                <Grid Grid.Row="1" Padding="16,6,8,8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="RosterFooter"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Reload the roster"
                        Click="ReloadRoster_Click"
                        Style="{StaticResource SidebarIconButtonStyle}"
                        ToolTipService.ToolTip="Reload the roster (Ctrl+Shift+R)">
                        <FontIcon FontSize="12" Glyph="&#xE72C;" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- MARK: Empty state -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Column="1"
            MaxWidth="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind local:ManagePage.Hide(ViewModel.HasSelection), Mode=OneWay}">
            <FontIcon FontSize="44" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE90F;" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind local:ManagePage.EmptyTitle(ViewModel.RosterLoaded), Mode=OneWay}" />
            <TextBlock
                x:Name="EmptyHint"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Center"
                Click="ReloadRoster_Click"
                Content="Reload"
                Visibility="{x:Bind local:ManagePage.Hide(ViewModel.RosterLoaded), Mode=OneWay}" />
        </StackPanel>

        <!-- MARK: Selection -->
        <Grid
            x:Name="Selection"
            Grid.Column="1"
            Padding="16,8,16,12"
            RowSpacing="6"
            Visibility="{x:Bind local:ManagePage.Show(ViewModel.HasSelection), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.SelectionTitle, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                <StackPanel Margin="0,2,0,0" Orientation="Horizontal" Spacing="10">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SelectionSubtitle, Mode=OneWay}" />
                    <Border Style="{StaticResource BadgeStyle}" ToolTipService.ToolTip="Where addresses came from on the last scan">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind local:ManagePage.ScanBrush(ViewModel.ScanMode), Mode=OneWay}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.ScanModeLabel, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Visibility="{x:Bind local:ManagePage.Show(ViewModel.IsScanning), Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.ScanStatus, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="fetching details…"
                        Visibility="{x:Bind local:ManagePage.Show(ViewModel.IsProbing), Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <CommandBar
                Grid.Row="1"
                Margin="-4,0,0,0"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Room actions"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True">
                <AppBarButton Click="Scan_Click" Label="Scan" ToolTipService.ToolTip="Scan the room again (Ctrl+Shift+S)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE721;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Click="StopScan_Click" Label="Stop" Visibility="{x:Bind local:ManagePage.Show(ViewModel.IsScanning), Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE71A;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Click="FetchDetails_Click" Label="Fetch details" ToolTipService.ToolTip="Ask every online machine who is signed in, its OS, uptime and remote-access state">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE946;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Click="AddDevice_Click" Label="Add device…">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarToggleButton
                    x:Name="ExtendedToggle"
                    Click="Extended_Click"
                    Label="Extended"
                    ToolTipService.ToolTip="Show OS, uptime, join state and client identifier columns">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8A9;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarButton Label="Actions">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE712;" /></AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Click="OpenSshTabs_Click" Text="Open SSH tabs…">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE756;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="InstallPackage_Click" Text="Install Package…">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="QuickRestart_Click" Text="Restart selected…">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="QuickLogOut_Click" Text="Log out user on selected…" />
                            <MenuFlyoutItem Click="QuickSleep_Click" Text="Sleep selected…" />
                            <MenuFlyoutItem Click="QuickLock_Click" Text="Lock screen on selected…">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="CopySelectedHostnames_Click" Text="Copy selected hostnames" />
                            <MenuFlyoutItem Click="CopySelectedAssets_Click" Text="Copy selected asset tags" />
                            <MenuFlyoutItem Click="CopySelectedInventory_Click" Text="Copy selected inventory lines" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="AddSelectedToGroup_Click" Text="Add selected to custom group…">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE902;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>

            <Grid Grid.Row="2" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Select:" />
                <HyperlinkButton Grid.Column="1" Padding="6,2" Click="SelectAll_Click" Content="All" />
                <HyperlinkButton Grid.Column="2" Padding="6,2" Click="SelectOnline_Click" Content="Online" ToolTipService.ToolTip="Select every machine that answered (Ctrl+Shift+A)" />
                <HyperlinkButton Grid.Column="3" Padding="6,2" Click="SelectNone_Click" Content="None" />
                <TextBlock
                    x:Name="SelectionCount"
                    Grid.Column="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>

            <Grid x:Name="Body" Grid.Row="3" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ListColumn" Width="1.1*" />
                    <ColumnDefinition x:Name="PaneColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ListRow" Height="*" />
                    <RowDefinition x:Name="PaneRow" Height="0" />
                </Grid.RowDefinitions>

                <!-- Machine list -->
                <Border x:Name="ListCard" Padding="0" Style="{StaticResource CardStyle}">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <Grid x:Name="TableGrid" MinWidth="640">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid
                                x:Name="TableHeader"
                                Padding="12,4,12,4"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1" />
                            <ListView
                                x:Name="MachinesList"
                                Grid.Row="1"
                                AutomationProperties.Name="Machines"
                                DoubleTapped="MachinesList_DoubleTapped"
                                ItemContainerStyle="{StaticResource RowListStyle}"
                                ItemTemplate="{StaticResource CompactRowTemplate}"
                                ItemsSource="{x:Bind VisibleRows}"
                                SelectionChanged="MachinesList_SelectionChanged"
                                SelectionMode="Extended" />
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Command runner and results -->
                <Grid x:Name="CommandPane" Grid.Column="1" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="12" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="CategoryCombo"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Command category"
                                    ItemTemplate="{StaticResource CategoryTemplate}"
                                    ItemsSource="{x:Bind ViewModel.Categories}"
                                    PlaceholderText="Category"
                                    SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" />
                                <ComboBox
                                    x:Name="CommandCombo"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Library command"
                                    ItemTemplate="{StaticResource CommandTemplate}"
                                    PlaceholderText="Command"
                                    SelectionChanged="CommandCombo_SelectionChanged" />
                                <Button Grid.Column="2" AutomationProperties.Name="Add a command to the library" Click="AddCommand_Click" ToolTipService.ToolTip="Add a command to the library">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                </Button>
                                <Button Grid.Column="3" AutomationProperties.Name="Edit the library command" Click="EditCommand_Click" ToolTipService.ToolTip="Edit the selected library command">
                                    <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                </Button>
                            </Grid>
                            <TextBox
                                x:Name="CustomCommandBox"
                                AutomationProperties.Name="Custom command"
                                FontFamily="Consolas"
                                KeyDown="CustomCommand_KeyDown"
                                PlaceholderText="Custom PowerShell command (overrides the picker)"
                                Text="{x:Bind ViewModel.CustomCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                FontFamily="Consolas"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ResolvedCommandString, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind local:ManagePage.HasText(ViewModel.ResolvedCommandString), Mode=OneWay}" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource BadgeStyle}" ToolTipService.ToolTip="{x:Bind local:ManagePage.TrustTip(ViewModel.EffectiveTrust), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind local:ManagePage.TrustBrush(ViewModel.EffectiveTrust), Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind core:ManageText.TrustLabel(ViewModel.EffectiveTrust, ViewModel.EffectiveTrustIsInferred), Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                                <Button Grid.Column="2" Click="History_Click" Content="History" />
                                <Button Grid.Column="3" Click="Kill_Click" Visibility="{x:Bind local:ManagePage.Show(ViewModel.IsRunning), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE71A;" />
                                        <TextBlock Text="Kill" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="4" Click="Run_Click" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Run on the checked online machines (Ctrl+Enter)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE768;" />
                                        <TextBlock Text="Run" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Padding="12,10,12,4" Style="{StaticResource CardStyle}">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="ResultsTitle" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Results" />
                                <TextBlock x:Name="ResultsCounts" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}" Visibility="{x:Bind local:ManagePage.Show(ViewModel.IsRunning), Mode=OneWay}" />
                                <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.RunStatus, Mode=OneWay}" />
                            </StackPanel>
                            <Grid Grid.Row="1" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SelectorBar x:Name="ResultFilterBar" Margin="-12,0,0,0" AutomationProperties.Name="Show results" SelectionChanged="ResultFilter_SelectionChanged">
                                    <SelectorBarItem IsSelected="True" Tag="All" Text="All" />
                                    <SelectorBarItem Tag="Success" Text="Success" />
                                    <SelectorBarItem Tag="Failed" Text="Failed" />
                                    <SelectorBarItem Tag="Offline" Text="Offline" />
                                </SelectorBar>
                                <DropDownButton x:Name="ResultActions" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Result actions" IsEnabled="False">
                                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutItem Click="CopyVisibleResults_Click" Text="Copy visible results" />
                                            <MenuFlyoutItem Click="SelectFailed_Click" Text="Select failed machines" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Click="ClearResults_Click" Text="Clear results" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </Grid>
                            <ListView
                                x:Name="ResultsList"
                                Grid.Row="2"
                                AutomationProperties.Name="Results"
                                ItemTemplate="{StaticResource ResultTemplate}"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                            <TextBlock
                                x:Name="NoResultsText"
                                Grid.Row="2"
                                Margin="0,12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Run a command to see each machine's result here."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- MARK: Machine inspector -->
        <Border
            x:Name="DetailPanel"
            Grid.Column="2"
            Width="340"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Visibility="Collapsed">
            <Grid Padding="16,12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="DetailStatus" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Top" AutomationProperties.Name="Close details" Click="CloseDetail_Click" Style="{StaticResource SidebarIconButtonStyle}">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="12">
                        <StackPanel x:Name="DetailSections" Spacing="12" />
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Margin="0" Text="Remote access check" />
                            <TextBlock x:Name="DetailHelp" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="DetailError" Foreground="{ThemeResource SystemFillColorCautionBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="2" ColumnSpacing="6" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button x:Name="DetailSsh" HorizontalAlignment="Stretch" Click="DetailSsh_Click" Content="SSH" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="DetailRdp" Grid.Column="1" HorizontalAlignment="Stretch" Click="DetailRdp_Click" Content="RDP" />
                    <Button Grid.Column="2" HorizontalAlignment="Stretch" Click="DetailCopy_Click" Content="Copy all" />
                    <Button Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Click="DetailProbe_Click" Content="Fetch details" />
                    <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Click="DetailRescan_Click" Content="Rescan" />
                </Grid>
            </Grid>
        </Border>

        <!-- The QA capture draws a dialog here; a live dialog is a ContentDialog. -->
        <Grid x:Name="PreviewHost" Grid.ColumnSpan="3" Visibility="Collapsed" />
    </Grid>
</Page>
