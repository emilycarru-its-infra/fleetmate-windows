<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FleetMate.WinUI.Pages.Inventory.AssetDetailPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="CloseAccelerator_Invoked" />
    </UserControl.KeyboardAccelerators>

    <!-- One scroll for the header and either segment, so a short window still reaches every card. -->
    <ScrollViewer x:Name="Root" SizeChanged="Root_SizeChanged" VerticalScrollBarVisibility="Auto">
    <StackPanel>

        <!-- The hero header: what the asset is at a glance, then where it stands. -->
        <StackPanel Padding="16,16,16,8" Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="48"
                    Height="48"
                    VerticalAlignment="Top"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <FontIcon
                        x:Name="CategoryIcon"
                        FontSize="24"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Glyph="&#xF158;" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="NameText"
                        AutomationProperties.HeadingLevel="Level2"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="ModelText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- The actions, each a 32px square but Re-Allocate. -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top" Orientation="Horizontal" Spacing="4">
                    <Button
                        x:Name="ReAllocateButton"
                        AutomationProperties.AutomationId="InventoryReAllocateButton"
                        Click="ReAllocateButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Check this asset out to someone else">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE748;" />
                            <TextBlock Text="Re-Allocate" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="AgentButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.AutomationId="AgentContextButton"
                        AutomationProperties.Name="Copy for an agent"
                        Click="AgentButton_Click"
                        ToolTipService.ToolTip="Copy this asset's details for an agent">
                        <FontIcon FontSize="14" Glyph="&#xE99A;" />
                    </Button>
                    <Button
                        x:Name="OpenButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.AutomationId="InventoryOpenInSnipeButton"
                        AutomationProperties.Name="Open in Snipe-IT"
                        Click="OpenButton_Click"
                        ToolTipService.ToolTip="Open in Snipe-IT">
                        <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                    </Button>
                    <Button
                        x:Name="CloseButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.AutomationId="InventoryCloseDetailButton"
                        AutomationProperties.Name="Close"
                        Click="CloseButton_Click"
                        ToolTipService.ToolTip="Close (Esc)">
                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <!-- Tag and serial as copyable chips, then the status. -->
                    <StackPanel x:Name="ChipsRow" Orientation="Horizontal" Spacing="8" />
                    <StackPanel x:Name="WhoWhereRow" Orientation="Horizontal" Spacing="16" />
                    <StackPanel x:Name="LifecycleHost" MaxWidth="360" HorizontalAlignment="Left" Spacing="6" />
                </StackPanel>
                <!-- The photo as the manufacturer ships it: no frame. -->
                <Image
                    x:Name="AssetPhoto"
                    Grid.Column="1"
                    MaxWidth="150"
                    MaxHeight="112"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    Stretch="Uniform" />
            </Grid>
        </StackPanel>

        <!-- Details | History; the choice carries across assets. -->
        <Grid Padding="12,0,16,4">
            <SelectorBar
                x:Name="SegmentBar"
                AutomationProperties.AutomationId="InventoryDetailSegments"
                AutomationProperties.Name="Asset views"
                SelectionChanged="SegmentBar_SelectionChanged">
                <SelectorBarItem x:Name="DetailsItem" AutomationProperties.AutomationId="InventoryDetailsSegment" IsSelected="True" Text="Details" />
                <SelectorBarItem x:Name="HistoryItem" AutomationProperties.AutomationId="InventoryHistorySegment" Text="History" />
            </SelectorBar>
        </Grid>

        <InfoBar
            x:Name="ErrorBar"
            Margin="16,0,16,8"
            IsOpen="False"
            Severity="Warning" />

        <StackPanel x:Name="DetailsView">
            <StackPanel x:Name="CardsHost" Padding="16,4,16,16" Spacing="12" />
        </StackPanel>

        <!-- Change history, newest first: a card per event, its field changes under it. -->
        <StackPanel x:Name="HistoryView" Visibility="Collapsed">
            <Grid Padding="16,4,16,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="HistoryFilterBox"
                    AutomationProperties.AutomationId="InventoryHistoryFilter"
                    AutomationProperties.Name="Filter history"
                    PlaceholderText="Filter history"
                    TextChanged="HistoryFilterBox_TextChanged" />
                <TextBlock
                    x:Name="HistoryCountText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
            <ProgressRing
                x:Name="HistoryLoadingRing"
                Width="24"
                Height="24"
                Margin="0,16,0,0"
                AutomationProperties.Name="Loading history"
                IsActive="False"
                Visibility="Collapsed" />
            <StackPanel x:Name="HistoryHost" Padding="16,0,16,16" Spacing="8" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
