<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FleetMate.WinUI.Pages.Development.Pipelines.PipelineRunPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FleetMate.WinUI.Pages.Development.Pipelines">

    <!-- One run: status, branch, commit, requester and timing, Rerun or Cancel, approvals, then the log as collapsible sections. -->
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock
                x:Name="TitleText"
                AutomationProperties.HeadingLevel="Level2"
                IsTextSelectionEnabled="True"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="WhereText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextSelectionEnabled="True"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- The status pill, then commit · requester · start · duration. -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Padding="8,3,10,3"
                VerticalAlignment="Center"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <local:RunStatusIcon x:Name="StatusIcon" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>
            <TextBlock
                x:Name="DetailsText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextSelectionEnabled="True"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
        </Grid>

        <CommandBar
            Grid.Row="2"
            HorizontalAlignment="Left"
            AutomationProperties.Name="Run actions"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="True">
            <AppBarButton
                x:Name="RerunButton"
                AutomationProperties.AutomationId="RunRerunButton"
                Click="Rerun_Click"
                Label="Rerun"
                ToolTipService.ToolTip="Queue this run again">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE72C;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                x:Name="CancelButton"
                AutomationProperties.AutomationId="RunCancelButton"
                Click="Cancel_Click"
                Label="Cancel Run"
                ToolTipService.ToolTip="Stop this run where it is">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE71A;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                AutomationProperties.AutomationId="RunReloadLogButton"
                Click="Reload_Click"
                Label="Reload Log"
                ToolTipService.ToolTip="Fetch the latest log">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE895;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                AutomationProperties.AutomationId="RunCopyForAgentButton"
                Click="CopyForAgent_Click"
                Label="Copy for Agent"
                ToolTipService.ToolTip="Copy this run as context for an agent">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE99A;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                AutomationProperties.AutomationId="RunOpenInBrowserButton"
                Click="OpenInBrowser_Click"
                Label="Open in Browser"
                ToolTipService.ToolTip="Open the run in the browser">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8A7;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock
                x:Name="ActionStatus"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <!-- A pending approval holds this run: say so, and offer the review. -->
            <InfoBar
                x:Name="ApprovalBar"
                AutomationProperties.AutomationId="RunApprovalBar"
                IsClosable="False"
                Severity="Warning">
                <InfoBar.ActionButton>
                    <Button
                        AutomationProperties.AutomationId="RunReviewApprovalButton"
                        Click="Review_Click"
                        Content="Review…"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Read the instructions, then approve or reject" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <Grid Grid.Row="4">
            <StackPanel
                x:Name="LoadingPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <ProgressRing Width="32" Height="32" IsActive="True" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Loading log…" />
            </StackPanel>

            <TextBlock
                x:Name="ErrorText"
                MaxWidth="460"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <ScrollViewer
                x:Name="ContentScroller"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel Padding="0,0,12,12" Spacing="6">
                    <StackPanel x:Name="TruncationNotice" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                        <FontIcon FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE7BA;" />
                        <TextBlock x:Name="TruncationText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ItemsRepeater x:Name="SectionsList">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:LogSectionItem">
                                <Expander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="{x:Bind Name}"
                                    IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <local:RunStatusIcon VerticalAlignment="Center" Status="{x:Bind Status}" />
                                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <!-- Read-only so a log line can be selected and copied. -->
                                    <TextBox
                                        MaxHeight="520"
                                        AcceptsReturn="True"
                                        AutomationProperties.Name="{x:Bind LogName}"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="12"
                                        IsReadOnly="True"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                        ScrollViewer.HorizontalScrollMode="Auto"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        Text="{x:Bind Text}"
                                        TextWrapping="NoWrap" />
                                </Expander>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
