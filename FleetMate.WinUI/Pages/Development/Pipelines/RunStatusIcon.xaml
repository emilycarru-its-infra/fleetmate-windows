<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FleetMate.WinUI.Pages.Development.Pipelines.RunStatusIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <!--
        A run's or log section's status glyph. Success is green, failed and
        partial the caution colour (never red, as on Mac), running the
        attention colour, the rest grey; system fill brushes, so High Contrast
        gets system colours. While an approval holds the run, a small hand
        badge sits on the glyph and the glyph takes the caution colour.
    -->
    <Grid x:Name="Root" Width="16" Height="16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="StatusStates">
                <VisualState x:Name="Other" />
                <VisualState x:Name="Succeeded">
                    <VisualState.Setters>
                        <Setter Target="Glyph.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Failed">
                    <VisualState.Setters>
                        <Setter Target="Glyph.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Running">
                    <VisualState.Setters>
                        <Setter Target="Glyph.Foreground" Value="{ThemeResource SystemFillColorAttentionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Approval">
                    <VisualState.Setters>
                        <Setter Target="Glyph.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="Badge.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <FontIcon
            x:Name="Glyph"
            FontSize="14"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- A symbol, never a count, and never red. -->
        <Grid
            x:Name="Badge"
            Width="11"
            Height="11"
            Margin="0,0,-5,-5"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Visibility="Collapsed">
            <Ellipse Margin="-1" Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Ellipse Fill="{ThemeResource SystemFillColorCautionBrush}" />
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe UI Symbol"
                FontSize="7"
                Foreground="{ThemeResource TextFillColorInverseBrush}"
                Text="&#x270B;" />
        </Grid>
    </Grid>
</UserControl>
