<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FleetMate.WinUI.Pages.Development.Shared.DiffFilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:FleetMate.Core.Shared"
    xmlns:local="using:FleetMate.WinUI.Pages.Development.Shared"
    IsTabStop="False">

    <UserControl.Resources>
        <!-- A file's band: path, then added/deleted and the +/- counts. -->
        <DataTemplate x:Key="FileHeaderTemplate" x:DataType="core:DiffRow">
            <Border
                Margin="0,12,0,0"
                Padding="10,6"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        Text="{x:Bind File.DisplayPath}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind File.DisplayPath}" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind core:DiffText.FileStatus(File)}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind core:DiffText.FileStats(File)}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EmptyNoticeTemplate" x:DataType="core:DiffRow">
            <TextBlock
                Padding="10,8"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind core:DiffText.EmptyNotice}"
                TextWrapping="Wrap" />
        </DataTemplate>

        <DataTemplate x:Key="HunkHeaderTemplate" x:DataType="core:DiffRow">
            <Border Padding="8,2" Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                <TextBlock
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Hunk.Header}"
                    TextTrimming="CharacterEllipsis" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LineTemplate" x:DataType="core:DiffRow">
            <local:DiffLineCell Line="{x:Bind Line}" Side="Inline" />
        </DataTemplate>

        <DataTemplate x:Key="SplitTemplate" x:DataType="core:DiffRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:DiffLineCell Line="{x:Bind Left}" Side="Left" />
                <Rectangle Grid.Column="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <local:DiffLineCell Grid.Column="2" Line="{x:Bind Right}" Side="Right" />
            </Grid>
        </DataTemplate>

        <local:DiffRowTemplateSelector
            x:Key="RowSelector"
            EmptyNotice="{StaticResource EmptyNoticeTemplate}"
            FileHeader="{StaticResource FileHeaderTemplate}"
            HunkHeader="{StaticResource HunkHeaderTemplate}"
            Line="{StaticResource LineTemplate}"
            Split="{StaticResource SplitTemplate}" />
    </UserControl.Resources>

    <StackPanel>
        <!-- The host's heading, the truncation notice and the layout picker. -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="HeaderText"
                    Style="{StaticResource CardHeaderTextStyle}"
                    Margin="0"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <StackPanel x:Name="TruncationNotice" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                    <FontIcon FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE7BA;" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="File list truncated"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
            <StackPanel
                x:Name="LayoutPicker"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="Diff layout"
                Orientation="Horizontal"
                Spacing="2"
                ToolTipService.ToolTip="Show changes side by side or inline">
                <ToggleButton
                    x:Name="SplitButton"
                    AutomationProperties.AutomationId="DiffLayoutSplit"
                    Click="SplitButton_Click"
                    Content="Side by Side" />
                <ToggleButton
                    x:Name="InlineButton"
                    AutomationProperties.AutomationId="DiffLayoutInline"
                    Click="InlineButton_Click"
                    Content="Inline" />
            </StackPanel>
        </Grid>

        <ItemsRepeater
            x:Name="Rows"
            Margin="0,0,0,4"
            ItemTemplate="{StaticResource RowSelector}">
            <ItemsRepeater.Layout>
                <StackLayout Orientation="Vertical" />
            </ItemsRepeater.Layout>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
