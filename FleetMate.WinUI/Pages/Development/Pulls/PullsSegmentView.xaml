<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FleetMate.WinUI.Pages.Development.Pulls.PullsSegmentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dev="using:FleetMate.WinUI.Pages.Development"
    xmlns:local="using:FleetMate.WinUI.Pages.Development.Pulls">

    <UserControl.Resources>
        <CollectionViewSource x:Name="GroupedPulls" IsSourceGrouped="True" />

        <Style x:Key="ChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style x:Key="PillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <DataTemplate x:Key="PullRequestRowTemplate" x:DataType="local:PullRequestRow">
            <Grid Padding="0,6" RowSpacing="2" AutomationProperties.Name="{x:Bind AccessibleName}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PillStyle}">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind SourceLabel}" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind Title}" />
                    <Border Grid.Column="2" Style="{StaticResource PillStyle}" Visibility="{x:Bind RelationVisibility}">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind RelationLabel}" />
                    </Border>
                    <TextBlock
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Foreground="{x:Bind StateBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind StateLabel}" />
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Subtitle}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="400" MinWidth="280" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- Left: filters, then the list. -->
        <Grid RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="ScopeEverything" Click="Scope_Click" Content="Everything" IsChecked="True" Style="{StaticResource ChipStyle}" Tag="Everything" />
                <ToggleButton x:Name="ScopeMine" Margin="0,0,10,0" Click="Scope_Click" Content="Mine" Style="{StaticResource ChipStyle}" Tag="Mine" />
                <ToggleButton x:Name="SourceAll" Click="Source_Click" Content="All" IsChecked="True" Style="{StaticResource ChipStyle}" Tag="All" />
                <ToggleButton x:Name="SourceDevOps" Click="Source_Click" Content="DevOps" Style="{StaticResource ChipStyle}" Tag="DevOps" />
                <ToggleButton x:Name="SourceGitHub" Click="Source_Click" Content="GitHub" Style="{StaticResource ChipStyle}" Tag="GitHub" />
            </StackPanel>

            <!-- The chips keep their one-line size; the repository menu gives way in a narrow pane. -->
            <Grid Grid.Row="1" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <dev:RepositoryFilterButton x:Name="RepoFilter" MinWidth="80" MaxWidth="300" SelectionChanged="RepoFilter_SelectionChanged" />
                <DropDownButton
                    x:Name="SortButton"
                    Grid.Column="1"
                    AutomationProperties.Name="Sort and group pull requests">
                    <FontIcon FontSize="14" Glyph="&#xE8CB;" />
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="SortMenu" Opening="SortMenu_Opening" Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem IsEnabled="False" Text="Sort By" />
                            <RadioMenuFlyoutItem x:Name="SortNewest" Click="Sort_Click" GroupName="PullsSort" Tag="Newest" Text="Recently Modified" />
                            <RadioMenuFlyoutItem x:Name="SortOldest" Click="Sort_Click" GroupName="PullsSort" Tag="Oldest" Text="Least Recently Modified" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="GroupToggle" Click="Group_Click" Text="Group by Repository" />
                            <MenuFlyoutSeparator x:Name="GroupSeparator" />
                            <MenuFlyoutItem x:Name="ExpandAllItem" Click="ExpandAll_Click" Text="Expand All Groups" />
                            <MenuFlyoutItem x:Name="CollapseAllItem" Click="CollapseAll_Click" Text="Collapse All Groups" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>

            <TextBlock
                x:Name="CountText"
                Grid.Row="2"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="2"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />

            <Border Grid.Row="3" Padding="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <ListView
                        x:Name="List"
                        AutomationProperties.AutomationId="DevelopmentPullsList"
                        AutomationProperties.Name="Pull requests"
                        ContextRequested="List_ContextRequested"
                        ItemTemplate="{StaticResource PullRequestRowTemplate}"
                        SelectionChanged="List_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.GroupStyle>
                            <GroupStyle HidesIfEmpty="False">
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="local:PullRequestGroup">
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            AutomationProperties.ItemStatus="{x:Bind Status}"
                                            AutomationProperties.Name="{x:Bind Key}"
                                            Click="GroupHeader_Click"
                                            ContextRequested="GroupHeader_ContextRequested"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Tag="{x:Bind Key}"
                                            ToolTipService.ToolTip="{x:Bind Tip}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon VerticalAlignment="Center" FontSize="10" Glyph="{x:Bind Chevron}" />
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Header}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                    </ListView>
                    <TextBlock
                        x:Name="EmptyText"
                        Margin="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>

        <!-- Right: one thing at a time. -->
        <Grid Grid.Column="1">
            <TextBlock
                x:Name="Placeholder"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Select a pull request or a notification."
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <ContentControl
                x:Name="WaitHost"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                IsTabStop="False"
                Visibility="Collapsed" />

            <!-- An inbox thread with no in-app viewer (issue, release, checks): what it is, and the browser. -->
            <StackPanel
                x:Name="NotificationPanel"
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="6"
                Visibility="Collapsed">
                <TextBlock x:Name="NotificationTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock
                    x:Name="NotificationByline"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button Margin="0,8,0,0" HorizontalAlignment="Center" Click="OpenNotification_Click" Content="Open in Browser" />
            </StackPanel>

            <local:PullRequestDetailView x:Name="Detail" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
