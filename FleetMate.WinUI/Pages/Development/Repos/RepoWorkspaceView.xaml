<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FleetMate.WinUI.Pages.Development.Repos.RepoWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:DefaultBindMode="OneTime"
    xmlns:local="using:FleetMate.WinUI.Pages.Development.Repos"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    PreviewKeyDown="Workspace_PreviewKeyDown">

    <!-- Rows are immutable records, rebuilt whenever the model changes, so every binding here is OneTime on purpose. -->
    <UserControl.Resources>
        <Style x:Key="CompactItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,2,8,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- One change: stage toggle, status letter, file name and folder. -->
        <DataTemplate x:Key="ChangeRowTemplate" x:DataType="local:ChangeRow">
            <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    MinWidth="0"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind StageHint}"
                    Click="StageCheckBox_Click"
                    IsChecked="{x:Bind StagedState}"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="{x:Bind StageLabel}" />
                <Border
                    Grid.Column="1"
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center"
                    Background="{x:Bind LetterBrush}"
                    CornerRadius="3">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="{x:Bind Letter}" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Folder}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Side}" />
            </Grid>
        </DataTemplate>

        <!-- One commit: lane graph, ref badges and subject, then hash, author and date. -->
        <DataTemplate x:Key="HistoryRowTemplate" x:DataType="local:HistoryRow">
            <Grid MinHeight="38" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:CommitGraphCell VerticalAlignment="Stretch" LaneCount="{x:Bind LaneCount}" Row="{x:Bind Graph}" />
                <StackPanel Grid.Column="1" Padding="0,3" VerticalAlignment="Center">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl
                            VerticalAlignment="Center"
                            IsTabStop="False"
                            ItemsSource="{x:Bind Refs}"
                            Visibility="{x:Bind RefsVisibility}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:RefBadge">
                                    <Border
                                        Padding="4,0,4,1"
                                        Background="{x:Bind Background}"
                                        BorderBrush="{x:Bind Border}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBlock FontSize="11" Foreground="{x:Bind Foreground}" Text="{x:Bind Name}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Column="1" Text="{x:Bind Subject}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Subject}" />
                    </Grid>
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Byline}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FileRowTemplate" x:DataType="local:FileRow">
            <Grid Margin="{x:Bind Indent}" ColumnSpacing="6" ToolTipService.ToolTip="{x:Bind Path}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{x:Bind Chevron}" />
                <FontIcon Grid.Column="1" FontSize="14" Foreground="{x:Bind IconBrush}" Glyph="{x:Bind Icon}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                <Ellipse
                    Grid.Column="3"
                    Width="7"
                    Height="7"
                    Fill="{ThemeResource TextFillColorSecondaryBrush}"
                    ToolTipService.ToolTip="Unsaved edits"
                    Visibility="{x:Bind UnsavedVisibility}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GrepRowTemplate" x:DataType="local:GrepRow">
            <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Path}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind LineLabel}"
                    TextAlignment="Right" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="12"
                    Text="{x:Bind Text}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <CollectionViewSource x:Name="GrepSource" IsSourceGrouped="True" />
    </UserControl.Resources>

    <Grid>
        <TextBlock
            x:Name="NoSelection"
            MaxWidth="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Select a repository. Browse, edit and commit in any tracked checkout; agents work in the same checkouts through 'fleetmate repos'."
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <Grid x:Name="Workspace" RowSpacing="8" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: the branch menu, then git's network commands, Refresh, Help, AGENTS.md and Reveal. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DropDownButton
                    x:Name="BranchButton"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ReposBranchMenu"
                    ToolTipService.ToolTip="Switch branch, or create one at HEAD">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8D4;" />
                        <TextBlock
                            x:Name="BranchLabel"
                            MaxWidth="260"
                            FontFamily="Cascadia Mono, Consolas"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <Ellipse
                            x:Name="DirtyDot"
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource SystemFillColorCautionBrush}"
                            ToolTipService.ToolTip="Uncommitted changes" />
                        <TextBlock
                            x:Name="SyncLabel"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="BranchMenu" Opening="BranchMenu_Opening" Placement="BottomEdgeAlignedLeft" />
                    </DropDownButton.Flyout>
                </DropDownButton>

                <CommandBar
                    x:Name="Commands"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="True"
                    OverflowButtonVisibility="Auto">
                    <AppBarButton
                        AutomationProperties.AutomationId="ReposFetch"
                        Click="FetchButton_Click"
                        Label="Fetch"
                        ToolTipService.ToolTip="git fetch (f)">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        AutomationProperties.AutomationId="ReposPull"
                        Click="PullButton_Click"
                        Label="Pull"
                        ToolTipService.ToolTip="git pull --ff-only (p)">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74B;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="PushButton"
                        AutomationProperties.AutomationId="ReposPush"
                        Click="PushButton_Click"
                        Label="Push">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74A;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton
                        AutomationProperties.AutomationId="ReposRefreshCheckout"
                        Click="RefreshButton_Click"
                        Label="Refresh"
                        ToolTipService.ToolTip="Read the checkout again (r)">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE72C;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="HelpButton"
                        AutomationProperties.AutomationId="ReposHelp"
                        Label="Shortcuts"
                        ToolTipService.ToolTip="Keyboard shortcuts (?)">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE765;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <Flyout x:Name="HelpFlyout" Placement="BottomEdgeAlignedRight">
                                <StackPanel x:Name="HelpContent" MaxWidth="640" Spacing="10" />
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton
                        x:Name="AgentsButton"
                        AutomationProperties.AutomationId="ReposAgentsFile"
                        Click="AgentsButton_Click"
                        Label="AGENTS.md"
                        ToolTipService.ToolTip="Agents read this file before working here. Open it in Files.">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8A5;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="RevealButton"
                        AutomationProperties.AutomationId="ReposReveal"
                        Click="RevealButton_Click"
                        Label="Reveal">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE838;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
            </Grid>

            <!-- Failures, non-blocking: dismiss it, or it closes itself. -->
            <InfoBar
                x:Name="ErrorBar"
                Grid.Row="1"
                AutomationProperties.AutomationId="ReposError"
                IsOpen="False"
                Severity="Warning" />

            <!-- Scrolls only in the stacked layout, where a short window cannot fit the list and the diff. -->
            <ScrollViewer
                x:Name="PanelScroller"
                Grid.Row="2"
                HorizontalScrollMode="Disabled"
                IsTabStop="False"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
            <Grid x:Name="PanelGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.42*" MinWidth="300" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="0.58*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="ListPane" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Commit composer above the change list. -->
                    <Border x:Name="Composer" Padding="12" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Commit" />
                                <StackPanel
                                    x:Name="ProtectedLabel"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    ToolTipService.ToolTip="Commits and pushes on this branch are refused. Create a branch from the branch menu first."
                                    Visibility="Collapsed">
                                    <FontIcon FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE72E;" />
                                    <TextBlock
                                        x:Name="ProtectedText"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        x:Name="StatusText"
                                        MaxWidth="260"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis" />
                                    <ProgressRing
                                        x:Name="BusyRing"
                                        Width="16"
                                        Height="16"
                                        AutomationProperties.Name="Working"
                                        IsActive="False" />
                                </StackPanel>
                            </Grid>
                            <TextBox
                                x:Name="SubjectBox"
                                AutomationProperties.AutomationId="ReposCommitSubject"
                                AutomationProperties.Name="Commit subject"
                                PlaceholderText="Subject"
                                TextChanged="SubjectBox_TextChanged" />
                            <TextBox
                                x:Name="BodyBox"
                                MinHeight="56"
                                MaxHeight="96"
                                AcceptsReturn="True"
                                AutomationProperties.AutomationId="ReposCommitBody"
                                AutomationProperties.Name="Commit body"
                                PlaceholderText="Body (optional)"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                TextChanged="BodyBox_TextChanged"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <CheckBox
                                    x:Name="AmendBox"
                                    MinWidth="0"
                                    AutomationProperties.AutomationId="ReposAmend"
                                    Click="AmendBox_Click"
                                    Content="Amend"
                                    ToolTipService.ToolTip="Amend the last commit instead of creating a new one" />
                                <CheckBox
                                    x:Name="SkipHooksBox"
                                    MinWidth="0"
                                    AutomationProperties.AutomationId="ReposSkipHooks"
                                    Click="SkipHooksBox_Click"
                                    Content="Skip Hooks"
                                    ToolTipService.ToolTip="Pass --no-verify to bypass pre-commit and commit-msg hooks" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="StageAllButton"
                                    AutomationProperties.AutomationId="ReposStageAll"
                                    Click="StageAllButton_Click"
                                    Content="Stage All"
                                    ToolTipService.ToolTip="Stage every change in the working tree. Hold Shift to unstage everything." />
                                <Button
                                    x:Name="CommitButton"
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="ReposCommit"
                                    Click="CommitButton_Click"
                                    Content="Commit"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="Commit what is staged (Ctrl+Enter)" />
                                <Button
                                    x:Name="CommitPushButton"
                                    Grid.Column="3"
                                    AutomationProperties.AutomationId="ReposCommitAndPush"
                                    Click="CommitPushButton_Click"
                                    Content="Commit &amp; Push"
                                    ToolTipService.ToolTip="Commit, then push the branch (C)" />
                            </Grid>
                            <Border
                                x:Name="OutputPanel"
                                Padding="8,4"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Visibility="Collapsed">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                                        <TextBlock
                                            x:Name="OutputText"
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="11"
                                            IsTextSelectionEnabled="True"
                                            TextWrapping="Wrap" />
                                    </ScrollViewer>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Top"
                                        AutomationProperties.AutomationId="ReposCopyOutput"
                                        Click="CopyOutputButton_Click"
                                        Content="Copy"
                                        ToolTipService.ToolTip="Copy git's output to the clipboard" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- The / filter over the change list or history. -->
                    <Grid x:Name="FilterBar" Grid.Row="1" ColumnSpacing="6" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="PanelFilterBox"
                            AutomationProperties.AutomationId="ReposPanelFilter"
                            AutomationProperties.Name="Filter the list"
                            KeyDown="PanelFilterBox_KeyDown"
                            PlaceholderText="Filter (/)"
                            TextChanged="PanelFilterBox_TextChanged" />
                        <Button
                            Grid.Column="1"
                            AutomationProperties.AutomationId="ReposClearFilter"
                            Click="ClearFilterButton_Click"
                            Content="Clear" />
                    </Grid>

                    <!-- Files header: Files or Search, with Show Files to leave a search. -->
                    <Grid x:Name="FilesHeader" Grid.Row="2" ColumnSpacing="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="FilesTitle"
                            MaxWidth="240"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Files"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="FilesHint"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                        <ProgressRing
                            x:Name="SearchRing"
                            Grid.Column="2"
                            Width="16"
                            Height="16"
                            AutomationProperties.Name="Searching"
                            IsActive="False" />
                        <Button
                            x:Name="ShowFilesButton"
                            Grid.Column="3"
                            AutomationProperties.AutomationId="ReposShowFiles"
                            Click="ShowFilesButton_Click"
                            Content="Show Files"
                            Visibility="Collapsed" />
                    </Grid>

                    <Border Grid.Row="3" Padding="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <ListView
                                x:Name="ChangesList"
                                Padding="0,4"
                                AutomationProperties.AutomationId="ReposChangesList"
                                AutomationProperties.Name="Changes"
                                DoubleTapped="ChangesList_DoubleTapped"
                                ItemContainerStyle="{StaticResource CompactItemStyle}"
                                ItemTemplate="{StaticResource ChangeRowTemplate}"
                                SelectionChanged="ChangesList_SelectionChanged"
                                SelectionMode="Extended" />
                            <ListView
                                x:Name="HistoryList"
                                Padding="0,4"
                                AutomationProperties.AutomationId="ReposHistoryList"
                                AutomationProperties.Name="History"
                                ItemContainerStyle="{StaticResource CompactItemStyle}"
                                ItemTemplate="{StaticResource HistoryRowTemplate}"
                                SelectionChanged="HistoryList_SelectionChanged"
                                SelectionMode="Single"
                                Visibility="Collapsed" />
                            <ListView
                                x:Name="FilesList"
                                Padding="0,4"
                                AutomationProperties.AutomationId="ReposFilesList"
                                AutomationProperties.Name="Files"
                                IsItemClickEnabled="True"
                                ItemClick="FilesList_ItemClick"
                                ItemContainerStyle="{StaticResource CompactItemStyle}"
                                ItemTemplate="{StaticResource FileRowTemplate}"
                                SelectionMode="Single"
                                Visibility="Collapsed" />
                            <ListView
                                x:Name="GrepList"
                                Padding="0,4"
                                AutomationProperties.AutomationId="ReposSearchResults"
                                AutomationProperties.Name="Search results"
                                ItemContainerStyle="{StaticResource CompactItemStyle}"
                                ItemTemplate="{StaticResource GrepRowTemplate}"
                                SelectionChanged="GrepList_SelectionChanged"
                                SelectionMode="Single"
                                Visibility="Collapsed">
                                <ListView.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate x:DataType="local:GrepGroup">
                                                <TextBlock
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Header}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListView.GroupStyle>
                            </ListView>
                            <TextBlock
                                x:Name="ListEmpty"
                                Margin="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>

                <toolkit:GridSplitter
                    x:Name="PanelSplitter"
                    Grid.Column="1"
                    Width="12"
                    AutomationProperties.Name="Resize the list and the diff"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Columns" />

                <Grid x:Name="DetailPane" Grid.Column="2">
                    <local:RepoDiffView x:Name="DiffView" />

                    <Grid x:Name="EditorPane" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            Padding="12,6"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="8,8,0,0">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="EditorTitle"
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Mono, Consolas"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="NoticeText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button
                                    x:Name="RevertButton"
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="ReposEditorRevert"
                                    Click="RevertButton_Click"
                                    Content="Revert"
                                    ToolTipService.ToolTip="Throw away unsaved edits (asks first)" />
                                <Button
                                    x:Name="CloseButton"
                                    Grid.Column="3"
                                    AutomationProperties.AutomationId="ReposEditorClose"
                                    Click="CloseButton_Click"
                                    Content="Close" />
                                <Button
                                    x:Name="SaveButton"
                                    Grid.Column="4"
                                    AutomationProperties.AutomationId="ReposEditorSave"
                                    Click="SaveButton_Click"
                                    Content="Save"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="Save (Ctrl+S)" />
                            </Grid>
                        </Border>
                        <Border
                            Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="0,0,8,8">
                            <Grid>
                                <local:CodeEditor x:Name="Editor" />
                                <TextBlock
                                    x:Name="EditorEmpty"
                                    MaxWidth="360"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Pick a file on the left. Filter with the toolbar search field; press Enter to search every file's contents."
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
