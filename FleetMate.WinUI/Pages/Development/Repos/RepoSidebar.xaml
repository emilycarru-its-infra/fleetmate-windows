<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FleetMate.WinUI.Pages.Development.Repos.RepoSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:DefaultBindMode="OneTime"
    xmlns:local="using:FleetMate.WinUI.Pages.Development.Repos">

    <!-- Rows are immutable records, rebuilt whenever the model changes, so every binding here is OneTime on purpose. -->
    <UserControl.Resources>
        <DataTemplate x:Key="SectionTemplate" x:DataType="local:SidebarSectionRow">
            <Grid Padding="0,6,0,2" ColumnSpacing="6" ToolTipService.ToolTip="{x:Bind ToString()}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{x:Bind Chevron}" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Title}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="2"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind CountText}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GroupTemplate" x:DataType="local:SidebarGroupRow">
            <Grid Padding="8,2,0,2" ColumnSpacing="6" ToolTipService.ToolTip="{x:Bind Tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{x:Bind Chevron}" />
                <FontIcon Grid.Column="1" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8B7;" />
                <TextBlock Grid.Column="2" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RepositoryTemplate" x:DataType="local:SidebarRepoRow">
            <Grid Margin="{x:Bind Indent}" Padding="4,4,0,4" ColumnSpacing="4" ToolTipService.ToolTip="{x:Bind Tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Opacity="{x:Bind RowOpacity}" Spacing="1">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Scope}"
                            Visibility="{x:Bind ScopeVisibility}" />
                        <ProgressRing
                            Grid.Column="2"
                            Width="12"
                            Height="12"
                            AutomationProperties.Name="Fetching"
                            IsActive="{x:Bind IsFetching}"
                            Visibility="{x:Bind local:RepoSidebar.Show(IsFetching)}" />
                    </Grid>
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{x:Bind MetadataBrush}"
                        Text="{x:Bind Metadata}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{x:Bind EditVisibility}">
                    <Button
                        Padding="6,4"
                        AutomationProperties.Name="{x:Bind HideLabel}"
                        Click="HideButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="{x:Bind HideLabel}">
                        <FontIcon FontSize="14" Glyph="{x:Bind EyeGlyph}" />
                    </Button>
                    <Button
                        Padding="6,4"
                        AutomationProperties.Name="More actions"
                        Click="MoreButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="More actions">
                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <local:SidebarRowTemplateSelector
            x:Key="RowSelector"
            Group="{StaticResource GroupTemplate}"
            Repository="{StaticResource RepositoryTemplate}"
            Section="{StaticResource SectionTemplate}" />
    </UserControl.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The workspace's mode. It sits above the list because it is a mode of
            the whole workspace: it stays put as the selection moves between
            repositories. Keys 1-3 switch it too.
        -->
        <SelectorBar
            x:Name="PanelBar"
            AutomationProperties.AutomationId="ReposPanels"
            AutomationProperties.Name="Repository view"
            SelectionChanged="PanelBar_SelectionChanged"
            ToolTipService.ToolTip="Changes, History or Files for the selected repository (keys 1-3)">
            <SelectorBarItem x:Name="PanelChanges" AutomationProperties.AutomationId="ReposPanelChanges" Tag="Changes" Text="Changes" />
            <SelectorBarItem x:Name="PanelHistory" AutomationProperties.AutomationId="ReposPanelHistory" Tag="History" Text="History" />
            <SelectorBarItem x:Name="PanelFiles" AutomationProperties.AutomationId="ReposPanelFiles" Tag="Files" Text="Files" />
        </SelectorBar>

        <!-- Filter, sort and Fetch All at the top of the list they act on. -->
        <Grid Grid.Row="1" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="FilterBox"
                AutomationProperties.AutomationId="ReposFilter"
                AutomationProperties.Name="Filter repositories"
                PlaceholderText="Filter"
                TextChanged="FilterBox_TextChanged" />
            <DropDownButton
                x:Name="SortButton"
                Grid.Column="1"
                Padding="8,5"
                AutomationProperties.AutomationId="ReposSort"
                AutomationProperties.Name="Sort and group">
                <FontIcon FontSize="14" Glyph="&#xE8CB;" />
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="SortMenu" Opening="SortMenu_Opening" Placement="BottomEdgeAlignedRight" />
                </DropDownButton.Flyout>
            </DropDownButton>
            <ProgressRing
                x:Name="BusyRing"
                Grid.Column="2"
                Width="16"
                Height="16"
                AutomationProperties.Name="Refreshing repositories"
                IsActive="False" />
            <Button
                x:Name="FetchAllButton"
                Grid.Column="3"
                Padding="8,5"
                AutomationProperties.AutomationId="ReposFetchAll"
                AutomationProperties.Name="Fetch All"
                Click="FetchAllButton_Click"
                ToolTipService.ToolTip="Fetch every tracked repository from its remote">
                <FontIcon FontSize="14" Glyph="&#xE896;" />
            </Button>
            <Button
                x:Name="EditButton"
                Grid.Column="4"
                AutomationProperties.AutomationId="ReposEdit"
                Click="EditButton_Click"
                Content="Edit"
                ToolTipService.ToolTip="Show or hide repositories, stop tracking them, or delete local clones" />
        </Grid>

        <!-- Clones that appeared in a watched folder: added only when the person says so. -->
        <InfoBar
            x:Name="NewClonesBar"
            Grid.Row="2"
            AutomationProperties.AutomationId="ReposNewClones"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button
                    x:Name="ReviewNewClonesButton"
                    AutomationProperties.AutomationId="ReposReviewNewClones"
                    Click="ReviewNewClonesButton_Click"
                    Content="Review…"
                    ToolTipService.ToolTip="Choose which of them to add" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Border Grid.Row="3" Padding="0" Style="{StaticResource CardStyle}">
            <Grid>
                <ListView
                    x:Name="RepoList"
                    Padding="0,4"
                    AutomationProperties.AutomationId="ReposList"
                    AutomationProperties.Name="Tracked repositories"
                    IsItemClickEnabled="True"
                    ItemClick="RepoList_ItemClick"
                    ItemTemplateSelector="{StaticResource RowSelector}"
                    SelectionChanged="RepoList_SelectionChanged"
                    SelectionMode="Single" />

                <StackPanel
                    x:Name="EmptyState"
                    Margin="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Where do you keep your code?" />
                    <TextBlock
                        MaxWidth="320"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Choose the folder that holds your git clones. FleetMate tracks every one it finds inside, and picks up new ones as they appear."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="ChooseFolderButton"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="ReposChooseFolder"
                        Click="ChooseFolderButton_Click"
                        Content="Choose Folder…"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Choose one or more folders to scan for git clones (Ctrl+Shift+O)">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Control,Shift" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button
                        x:Name="UseSuggestedButton"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="ReposUseSuggested"
                        Click="UseSuggestedButton_Click"
                        Visibility="Collapsed">
                        <TextBlock x:Name="UseSuggestedText" TextWrapping="Wrap" TextAlignment="Center" />
                    </Button>
                    <StackPanel
                        x:Name="ScanningState"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="Collapsed">
                        <ProgressRing Width="16" Height="16" IsActive="True" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Finding clones…" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    x:Name="NoMatches"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No repositories match the filter."
                    Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
