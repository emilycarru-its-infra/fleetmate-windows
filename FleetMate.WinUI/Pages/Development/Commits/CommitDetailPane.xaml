<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FleetMate.WinUI.Pages.Development.Commits.CommitDetailPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:FleetMate.Core.Models.Projects"
    xmlns:shared="using:FleetMate.WinUI.Pages.Development.Shared">

    <!-- One commit: subject and byline, its message, then diffs (GitHub) or the change list (Azure DevOps, which has no patch). -->
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock
                x:Name="SubjectText"
                AutomationProperties.HeadingLevel="Level2"
                IsTextSelectionEnabled="True"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="BylineText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextSelectionEnabled="True"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
        </StackPanel>

        <CommandBar
            Grid.Row="1"
            HorizontalAlignment="Left"
            AutomationProperties.Name="Commit actions"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="True">
            <AppBarButton
                AutomationProperties.AutomationId="CommitCopyShaButton"
                Click="CopySha_Click"
                Label="Copy SHA"
                ToolTipService.ToolTip="Copy the full SHA">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                AutomationProperties.AutomationId="CommitCopyLinkButton"
                Click="CopyLink_Click"
                Label="Copy Link"
                ToolTipService.ToolTip="Copy the commit's web link">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE71B;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                AutomationProperties.AutomationId="CommitCopyForAgentButton"
                Click="CopyForAgent_Click"
                Label="Copy for Agent"
                ToolTipService.ToolTip="Copy this commit as context for an agent">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE99A;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                AutomationProperties.AutomationId="CommitOpenInBrowserButton"
                Click="OpenInBrowser_Click"
                Label="Open in Browser"
                ToolTipService.ToolTip="Open the commit in the browser">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8A7;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <Grid Grid.Row="2">
            <StackPanel
                x:Name="LoadingPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <ProgressRing Width="32" Height="32" IsActive="True" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Loading commit…" />
            </StackPanel>

            <StackPanel
                x:Name="ErrorPanel"
                MaxWidth="460"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="ErrorText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="CommitRetryButton"
                    Click="Retry_Click"
                    Content="Retry" />
            </StackPanel>

            <ContentControl
                x:Name="WaitHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Visibility="Collapsed" />

            <ScrollViewer
                x:Name="ContentScroller"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel Padding="0,0,12,12" Spacing="16">
                    <StackPanel x:Name="BodySection" Spacing="4">
                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Margin="0" Text="Message" />
                        <Border Style="{StaticResource CardStyle}" Padding="12">
                            <TextBlock
                                x:Name="BodyText"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <!-- GitHub: diffs. -->
                    <shared:DiffFilesView x:Name="Diff" />

                    <!-- Azure DevOps: its commit API has no patch, so a change list. -->
                    <StackPanel x:Name="ChangesSection" Spacing="4" Visibility="Collapsed">
                        <TextBlock x:Name="ChangesHeader" Style="{StaticResource CardHeaderTextStyle}" Margin="0" />
                        <Border Style="{StaticResource CardStyle}" Padding="12">
                            <ItemsRepeater x:Name="ChangesList">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="core:CommitChange">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ChangeType}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontFamily="Cascadia Mono, Consolas"
                                                FontSize="12"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind Path}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Path}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
