<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FleetMate.WinUI.Pages.Identity.IdentityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:FleetMate.Core.Identity"
    xmlns:devices="using:FleetMate.Core.Models.Devices"
    xmlns:identity="using:FleetMate.Core.Models.Identity"
    xmlns:local="using:FleetMate.WinUI.Pages.Identity"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="IdentityCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,12,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <SelectorBar
                x:Name="Views"
                Margin="-12,0,0,0"
                AutomationProperties.Name="Identity views"
                SelectionChanged="Views_SelectionChanged">
                <SelectorBarItem x:Name="GroupsItem" IsSelected="True" Tag="groups" Text="Device groups" AutomationProperties.AutomationId="IdentityGroupsTab" />
                <SelectorBarItem x:Name="UsersItem" Tag="users" Text="Users" AutomationProperties.AutomationId="IdentityUsersTab" />
            </SelectorBar>
            <Button
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="IdentityGroupsRefresh"
                AutomationProperties.Name="Refresh device groups"
                Command="{x:Bind ViewModel.LoadGroupsCommand}"
                ToolTipService.ToolTip="Refresh"
                Visibility="{x:Bind GroupsPanel.Visibility, Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <InfoBar
            Grid.Row="1"
            VerticalAlignment="Top"
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind ViewModel.NotConfiguredMessage}"
            Severity="Informational"
            Visibility="{x:Bind NotConfiguredVisibility}" />

        <!-- Device groups -->
        <Grid x:Name="GroupsPanel" Grid.Row="1" RowSpacing="8" Visibility="{x:Bind ConfiguredVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                HorizontalAlignment="Right"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.GroupsCount, Mode=OneWay}" />
            <Border Grid.Row="1" Style="{StaticResource IdentityCardStyle}">
                <Grid>
                    <ScrollViewer Padding="8,4">
                        <ItemsRepeater AutomationProperties.AutomationId="IdentityGroupsList" AutomationProperties.Name="Device groups" ItemsSource="{x:Bind ViewModel.Groups}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="2" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:GroupRow">
                                    <StackPanel>
                                        <Button
                                            Padding="8,6"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            AutomationProperties.Name="{x:Bind Name}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind ToggleCommand}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{x:Bind Chevron, Mode=OneWay}" />
                                                <FontIcon Grid.Column="1" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="{x:Bind Glyph}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                <ItemsRepeater Grid.Column="3" VerticalAlignment="Center" ItemsSource="{x:Bind Badges}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Orientation="Horizontal" Spacing="4" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Border Padding="6,1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}">
                                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                                <TextBlock Grid.Column="4" MinWidth="72" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind CountText, Mode=OneWay}" TextAlignment="Right" />
                                            </Grid>
                                        </Button>
                                        <StackPanel Margin="44,4,8,10" Spacing="6" Visibility="{x:Bind IsExpanded, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Group ID" />
                                                <TextBlock VerticalAlignment="Center" FontFamily="Consolas" IsTextSelectionEnabled="True" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Id}" />
                                                <Button Padding="4" AutomationProperties.Name="Copy group ID" Background="Transparent" BorderThickness="0" Command="{x:Bind CopyIdCommand}" ToolTipService.ToolTip="Copy group ID">
                                                    <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind IsLoading, Mode=OneWay}">
                                                <ProgressRing Width="14" Height="14" IsActive="{x:Bind IsLoading, Mode=OneWay}" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Loading members…" />
                                            </StackPanel>
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="No device members" Visibility="{x:Bind NoMembers, Mode=OneWay}" />
                                            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind LoadError, Mode=OneWay}" />
                                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind MembersHeader, Mode=OneWay}" />
                                            <ItemsRepeater ItemsSource="{x:Bind Members}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="local:DeviceRow">
                                                        <Border Padding="8,4" Background="{x:Bind local:IdentityPage.MemberBackground(IsMatch)}" CornerRadius="{StaticResource ControlCornerRadius}">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="20" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <FontIcon FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{x:Bind Glyph}" />
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Name}" />
                                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind OsText}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <ProgressRing HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.GroupsLoading, Mode=OneWay}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.GroupsEmpty, Mode=OneWay}">
                        <FontIcon FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE716;" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.GroupsEmptyTitle, Mode=OneWay}" />
                        <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind ViewModel.GroupsEmptyText, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock
                        Margin="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.GroupsError, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <!-- Users -->
        <Grid
            x:Name="UsersPanel"
            Grid.Row="1"
            ColumnSpacing="12"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource IdentityCardStyle}">
                <Grid>
                    <ListView
                        AutomationProperties.AutomationId="IdentityUsersList"
                        AutomationProperties.Name="Users"
                        ItemsSource="{x:Bind ViewModel.Users}"
                        x:Name="UsersList"
                        SelectionChanged="UsersList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:UserRow">
                                <Grid Padding="0,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <PersonPicture Width="32" Height="32" Initials="{x:Bind Initials}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind UserPrincipalName}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ProgressRing HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.UsersLoading, Mode=OneWay}" />
                    <StackPanel
                        Margin="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind local:IdentityPage.Show(ViewModel.UsersMessage), Mode=OneWay}">
                        <FontIcon FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE721;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.UsersMessage, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource IdentityCardStyle}">
                <Grid>
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind local:IdentityPage.Hide(ViewModel.HasSelectedUser), Mode=OneWay}">
                        <FontIcon FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE77B;" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="No user selected" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Select a user to see their full Entra profile." />
                    </StackPanel>
                    <Grid Padding="20" RowSpacing="12" Visibility="{x:Bind ViewModel.HasSelectedUser, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture Width="56" Height="56" Initials="{x:Bind ViewModel.SelectedUser.Initials, Mode=OneWay, FallbackValue=''}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.SelectedUser.DisplayName, Mode=OneWay, FallbackValue=''}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.SelectedUser.UserPrincipalName, Mode=OneWay, FallbackValue=''}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border
                                        Padding="8,1"
                                        Background="{x:Bind local:IdentityPage.StateBrush(ViewModel.SelectedUser.State), Mode=OneWay}"
                                        CornerRadius="{StaticResource ControlCornerRadius}">
                                        <TextBlock
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.SelectedUser.StateText, Mode=OneWay, FallbackValue=''}" />
                                    </Border>
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.SelectedUser.Subtitle, Mode=OneWay, FallbackValue=''}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="IdentityToggleAccount"
                                Click="ToggleAccount_Click"
                                Content="{x:Bind ViewModel.SelectedUser.ToggleLabel, Mode=OneWay, FallbackValue=''}" />
                        </Grid>

                        <InfoBar
                            Grid.Row="1"
                            IsClosable="False"
                            IsOpen="{x:Bind local:IdentityPage.HasText(ViewModel.ActionError), Mode=OneWay}"
                            Message="{x:Bind ViewModel.ActionError, Mode=OneWay}"
                            Severity="Error" />

                        <SelectorBar
                            x:Name="Inspector"
                            Grid.Row="2"
                            Margin="-12,0,0,0"
                            AutomationProperties.Name="User details"
                            SelectionChanged="Inspector_SelectionChanged">
                            <SelectorBarItem IsSelected="True" Tag="properties" Text="Properties" />
                            <SelectorBarItem Tag="devices" Text="Devices" />
                            <SelectorBarItem Tag="groups" Text="Groups" />
                        </SelectorBar>

                        <ScrollViewer x:Name="PropertiesView" Grid.Row="3">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedUser.Sections, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="16" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="core:UserPropertySection">
                                        <StackPanel Spacing="4">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                            <ItemsRepeater ItemsSource="{x:Bind Rows}">
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="core:UserPropertyRow">
                                                        <Grid Padding="0,2" ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="180" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Label}" />
                                                            <TextBlock Grid.Column="1" IsTextSelectionEnabled="True" Text="{x:Bind DisplayValue}" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>

                        <Grid x:Name="DevicesView" Grid.Row="3" Visibility="Collapsed">
                            <ListView AutomationProperties.Name="User's devices" ItemsSource="{x:Bind ViewModel.UserDevices}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="devices:IntuneDevice">
                                        <StackPanel Padding="0,6">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DeviceName}" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind local:IdentityPage.DeviceDetail(OperatingSystem, OsVersion, SerialNumber)}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.DevicesMessage, Mode=OneWay}" />
                        </Grid>

                        <Grid x:Name="GroupsView" Grid.Row="3" RowSpacing="8" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    AutomationProperties.AutomationId="IdentityAddGroupBox"
                                    AutomationProperties.Name="Group to add"
                                    PlaceholderText="Group name or id"
                                    Text="{x:Bind ViewModel.GroupToAdd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" AutomationProperties.AutomationId="IdentityAddGroup" Command="{x:Bind ViewModel.AddToGroupCommand}" Content="Add to group" />
                            </Grid>
                            <ListView Grid.Row="1" AutomationProperties.Name="User's groups" ItemsSource="{x:Bind ViewModel.UserGroups}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="identity:EntraGroup">
                                        <Grid Padding="0,6" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind DisplayName}" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Description}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Remove from group"
                                                Click="RemoveGroup_Click"
                                                Content="Remove"
                                                Tag="{x:Bind}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.GroupsMessage, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
