<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FleetMate.WinUI.Pages.Identity.IdentityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:FleetMate.Core.Identity"
    xmlns:devices="using:FleetMate.Core.Models.Devices"
    xmlns:identity="using:FleetMate.Core.Models.Identity"
    xmlns:local="using:FleetMate.WinUI.Pages.Identity"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="IdentityCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,12,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <SelectorBar
                x:Name="Views"
                Margin="-12,0,0,0"
                AutomationProperties.Name="Identity views"
                SelectionChanged="Views_SelectionChanged">
                <SelectorBarItem x:Name="GroupsItem" IsSelected="True" Tag="groups" Text="Device groups" AutomationProperties.AutomationId="IdentityGroupsTab" />
                <SelectorBarItem x:Name="UsersItem" Tag="users" Text="Users" AutomationProperties.AutomationId="IdentityUsersTab" />
            </SelectorBar>
            <Button
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="IdentityGroupsRefresh"
                AutomationProperties.Name="Refresh device groups"
                Command="{x:Bind ViewModel.LoadGroupsCommand}"
                ToolTipService.ToolTip="Refresh"
                Visibility="{x:Bind GroupsPanel.Visibility, Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <InfoBar
            Grid.Row="1"
            VerticalAlignment="Top"
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind ViewModel.NotConfiguredMessage}"
            Severity="Informational"
            Visibility="{x:Bind NotConfiguredVisibility}" />

        <!-- Device groups -->
        <Grid x:Name="GroupsPanel" Grid.Row="1" Visibility="{x:Bind ConfiguredVisibility}">
            <Border Style="{StaticResource IdentityCardStyle}">
                <Grid>
                    <TreeView
                        x:Name="GroupsTree"
                        AutomationProperties.AutomationId="IdentityGroupsTree"
                        AutomationProperties.Name="Device groups"
                        Expanding="GroupsTree_Expanding"
                        SelectionMode="Single" />
                    <ProgressRing HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.GroupsLoading, Mode=OneWay}" />
                    <TextBlock
                        Margin="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.GroupsError, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <!-- Users -->
        <Grid
            x:Name="UsersPanel"
            Grid.Row="1"
            ColumnSpacing="12"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource IdentityCardStyle}">
                <Grid>
                    <ListView
                        AutomationProperties.AutomationId="IdentityUsersList"
                        AutomationProperties.Name="Users"
                        ItemsSource="{x:Bind ViewModel.Users}"
                        x:Name="UsersList"
                        SelectionChanged="UsersList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:UserRow">
                                <Grid Padding="0,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <PersonPicture Width="32" Height="32" Initials="{x:Bind Initials}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind UserPrincipalName}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ProgressRing HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.UsersLoading, Mode=OneWay}" />
                    <TextBlock
                        Margin="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.UsersMessage, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource IdentityCardStyle}">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Select a user to see their Entra profile."
                        Visibility="{x:Bind local:IdentityPage.Hide(ViewModel.HasSelectedUser), Mode=OneWay}" />
                    <Grid Padding="20" RowSpacing="12" Visibility="{x:Bind ViewModel.HasSelectedUser, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture Width="56" Height="56" Initials="{x:Bind ViewModel.SelectedUser.Initials, Mode=OneWay, FallbackValue=''}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.SelectedUser.DisplayName, Mode=OneWay, FallbackValue=''}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.SelectedUser.UserPrincipalName, Mode=OneWay, FallbackValue=''}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border
                                        Padding="8,1"
                                        Background="{x:Bind local:IdentityPage.StateBrush(ViewModel.SelectedUser.State), Mode=OneWay}"
                                        CornerRadius="{StaticResource ControlCornerRadius}">
                                        <TextBlock
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.SelectedUser.StateText, Mode=OneWay, FallbackValue=''}" />
                                    </Border>
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.SelectedUser.Subtitle, Mode=OneWay, FallbackValue=''}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="IdentityToggleAccount"
                                Click="ToggleAccount_Click"
                                Content="{x:Bind ViewModel.SelectedUser.ToggleLabel, Mode=OneWay, FallbackValue=''}" />
                        </Grid>

                        <InfoBar
                            Grid.Row="1"
                            IsClosable="False"
                            IsOpen="{x:Bind local:IdentityPage.HasText(ViewModel.ActionError), Mode=OneWay}"
                            Message="{x:Bind ViewModel.ActionError, Mode=OneWay}"
                            Severity="Error" />

                        <SelectorBar
                            x:Name="Inspector"
                            Grid.Row="2"
                            Margin="-12,0,0,0"
                            AutomationProperties.Name="User details"
                            SelectionChanged="Inspector_SelectionChanged">
                            <SelectorBarItem IsSelected="True" Tag="properties" Text="Properties" />
                            <SelectorBarItem Tag="devices" Text="Devices" />
                            <SelectorBarItem Tag="groups" Text="Groups" />
                        </SelectorBar>

                        <ScrollViewer x:Name="PropertiesView" Grid.Row="3">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedUser.Sections, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="16" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="core:UserPropertySection">
                                        <StackPanel Spacing="4">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                            <ItemsRepeater ItemsSource="{x:Bind Rows}">
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="core:UserPropertyRow">
                                                        <Grid Padding="0,2" ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="180" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Label}" />
                                                            <TextBlock Grid.Column="1" IsTextSelectionEnabled="True" Text="{x:Bind DisplayValue}" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>

                        <Grid x:Name="DevicesView" Grid.Row="3" Visibility="Collapsed">
                            <ListView AutomationProperties.Name="User's devices" ItemsSource="{x:Bind ViewModel.UserDevices}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="devices:IntuneDevice">
                                        <StackPanel Padding="0,6">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DeviceName}" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind local:IdentityPage.DeviceDetail(OperatingSystem, OsVersion, SerialNumber)}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.DevicesMessage, Mode=OneWay}" />
                        </Grid>

                        <Grid x:Name="GroupsView" Grid.Row="3" RowSpacing="8" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    AutomationProperties.AutomationId="IdentityAddGroupBox"
                                    AutomationProperties.Name="Group to add"
                                    PlaceholderText="Group name or id"
                                    Text="{x:Bind ViewModel.GroupToAdd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" AutomationProperties.AutomationId="IdentityAddGroup" Command="{x:Bind ViewModel.AddToGroupCommand}" Content="Add to group" />
                            </Grid>
                            <ListView Grid.Row="1" AutomationProperties.Name="User's groups" ItemsSource="{x:Bind ViewModel.UserGroups}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="identity:EntraGroup">
                                        <Grid Padding="0,6" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind DisplayName}" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Description}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Remove from group"
                                                Click="RemoveGroup_Click"
                                                Content="Remove"
                                                Tag="{x:Bind}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.GroupsMessage, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
