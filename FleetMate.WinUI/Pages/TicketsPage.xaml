<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FleetMate.WinUI.Pages.TicketsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:FleetMate.Core.Models.Tickets"
    xmlns:tickets="using:FleetMate.WinUI.Pages.Tickets"
    NavigationCacheMode="Required"
    SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <Style x:Key="ChartCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinWidth" Value="168" />
        </Style>
        <Style x:Key="ColumnHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style x:Key="ToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <!-- One row of the ticket table. Widths follow TicketListLayout, so the header and rows agree. -->
        <DataTemplate x:Key="TicketRowTemplate" x:DataType="tickets:TicketListItem">
            <Grid
                Padding="0,6"
                AutomationProperties.Name="{x:Bind SpokenName}"
                Background="Transparent"
                ColumnSpacing="8"
                ContextRequested="Row_ContextRequested"
                Tag="{x:Bind}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="{x:Bind Layout.PriorityWidth, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.RequestorWidth, Mode=OneWay}" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="{x:Bind Layout.ModifiedWidth, Mode=OneWay}" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="{x:Bind Indent}" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                    <Button
                        Width="24"
                        Height="24"
                        Padding="0"
                        AutomationProperties.Name="{x:Bind DisclosureName}"
                        Click="Fold_Click"
                        IsEnabled="{x:Bind IsDisclosureEnabled}"
                        IsTabStop="{x:Bind IsDisclosureEnabled}"
                        Opacity="{x:Bind DisclosureOpacity}"
                        Style="{StaticResource SubtleButtonStyle}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="{x:Bind DisclosureName}">
                        <FontIcon FontSize="10" Glyph="{x:Bind DisclosureGlyph}" />
                    </Button>
                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind IdLabel}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE7BA;" ToolTipService.ToolTip="SLA violated" Visibility="{x:Bind SlaVisibility}" />
                    <TextBlock MaxLines="1" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind Title}" />
                    <Border
                        Padding="6,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8"
                        ToolTipService.ToolTip="{x:Bind ChildCountText}"
                        Visibility="{x:Bind ChildBadgeVisibility}">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ChildCountLabel}" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" Fill="{x:Bind StatusBrush}" />
                    <TextBlock MaxLines="1" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Status}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
                <TextBlock Grid.Column="3" VerticalAlignment="Center" MaxLines="1" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Priority}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Grid.Column="4" VerticalAlignment="Center" MaxLines="1" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Requestor}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Grid.Column="5" VerticalAlignment="Center" Foreground="{x:Bind ResponsibleForeground}" MaxLines="1" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Responsible}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{x:Bind AgeForeground}" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Age}" />
                <TextBlock Grid.Column="7" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Modified}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>

        <!-- One board card. -->
        <DataTemplate x:Key="BoardCardTemplate" x:DataType="tickets:TicketListItem">
            <Border
                Margin="{x:Bind CardIndent}"
                Padding="12,10"
                AutomationProperties.Name="{x:Bind SpokenName}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ContextRequested="Row_ContextRequested"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Tag="{x:Bind}">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Width="22"
                            Height="22"
                            Padding="0"
                            AutomationProperties.Name="{x:Bind DisclosureName}"
                            Click="Fold_Click"
                            IsEnabled="{x:Bind IsDisclosureEnabled}"
                            IsTabStop="{x:Bind IsDisclosureEnabled}"
                            Opacity="{x:Bind DisclosureOpacity}"
                            Style="{StaticResource SubtleButtonStyle}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="{x:Bind DisclosureName}">
                            <FontIcon FontSize="9" Glyph="{x:Bind DisclosureGlyph}" />
                        </Button>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind IdLabel}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE7BA;" ToolTipService.ToolTip="SLA violated" Visibility="{x:Bind SlaVisibility}" />
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind PriorityBrush}" />
                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Priority}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock MaxLines="3" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind RequestorAndGroup}" TextTrimming="CharacterEllipsis" />
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE77B;" />
                        <TextBlock Grid.Column="1" Foreground="{x:Bind ResponsibleForeground}" MaxLines="1" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Responsible}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Foreground="{x:Bind AgeForeground}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Age}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One board column: a drop target that scrolls its own cards. -->
        <DataTemplate x:Key="BoardColumnTemplate" x:DataType="tickets:TicketBoardColumnItem">
            <Grid
                Width="288"
                Padding="8"
                AllowDrop="True"
                AutomationProperties.Name="{x:Bind SpokenName}"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                DragLeave="BoardColumn_DragLeave"
                DragOver="BoardColumn_DragOver"
                Drop="BoardColumn_Drop"
                RowSpacing="8"
                Tag="{x:Bind Key}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="4,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind Dot}" />
                    <TextBlock Grid.Column="1" MaxLines="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Key}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Key}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind CountLabel}" />
                </Grid>
                <ListView
                    Grid.Row="1"
                    AutomationProperties.Name="{x:Bind Key}"
                    CanDragItems="True"
                    DragItemsStarting="BoardCards_DragItemsStarting"
                    IsItemClickEnabled="True"
                    ItemClick="BoardCard_ItemClick"
                    ItemTemplate="{StaticResource BoardCardTemplate}"
                    ItemsSource="{x:Bind Cards}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </DataTemplate>

        <!-- A block of columns: one per responsible group, or one headerless block. -->
        <DataTemplate x:Key="BoardBlockTemplate" x:DataType="tickets:TicketBoardBlockItem">
            <Grid
                Padding="{x:Bind Padding}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="{x:Bind BorderThickness}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="4,0" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind HeaderVisibility}">
                    <FontIcon FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE716;" />
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind HeaderText}" />
                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind CountLabel}" />
                </StackPanel>
                <ItemsRepeater Grid.Row="1" ItemTemplate="{StaticResource BoardColumnTemplate}" ItemsSource="{x:Bind Columns}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="12" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FeedItemTemplate" x:DataType="tickets:TicketFeedItem">
            <StackPanel Spacing="8">
                <Grid Margin="{x:Bind Indent}" AutomationProperties.Name="{x:Bind SpokenName}" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <PersonPicture Width="28" Height="28" VerticalAlignment="Top" Initials="{x:Bind Initials}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Author}" />
                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind When}" />
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" Visibility="{x:Bind PrivateVisibility}">
                                <FontIcon FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE72E;" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Private" />
                            </StackPanel>
                        </StackPanel>
                        <Border
                            Padding="12,8"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Visibility="{x:Bind BodyVisibility}">
                            <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Body}" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Notified}" TextWrapping="Wrap" Visibility="{x:Bind NotifiedVisibility}" />
                    </StackPanel>
                </Grid>
                <ItemsRepeater ItemsSource="{x:Bind Replies}" Visibility="{x:Bind RepliesVisibility}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="tickets:TicketFeedItem">
                            <Grid Margin="{x:Bind Indent}" AutomationProperties.Name="{x:Bind SpokenName}" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <PersonPicture Width="24" Height="24" VerticalAlignment="Top" Initials="{x:Bind Initials}" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Author}" />
                                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind When}" />
                                    </StackPanel>
                                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Body}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="R" Invoked="RefreshAccelerator_Invoked" Modifiers="Control" />
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="PageRoot" Padding="16,12,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            One toolbar row, in the Mac's order: Filters and its Clear, Assigned
            to Me, then the board's own column and sort controls; the count,
            Details and Refresh on the right. List | Board is in the title bar.
        -->
        <Grid x:Name="Toolbar" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="FiltersButton" AutomationProperties.AutomationId="TicketsFiltersButton"
                    Height="32"
                    AutomationProperties.Name="{x:Bind ViewModel.FiltersButtonName, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.FiltersButtonToolTip, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE71C;" />
                        <TextBlock x:Name="FiltersLabel" Text="Filters" />
                        <InfoBadge
                            VerticalAlignment="Center"
                            Value="{x:Bind ViewModel.ActiveFilterCount, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasFilterBadge, Mode=OneWay}" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="FiltersFlyout" Opening="FiltersFlyout_Opening" Placement="BottomEdgeAlignedLeft">
                            <Grid Width="520" Height="380" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Filters" />
                                    <Button
                                        HorizontalAlignment="Right"
                                        Command="{x:Bind ViewModel.ClearAllFiltersCommand}"
                                        Content="Clear All"
                                        Visibility="{x:Bind ViewModel.ShowsClearAll, Mode=OneWay}" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="168" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ListView
                                        x:Name="FilterSectionsList" AutomationProperties.AutomationId="TicketsFilterSectionsList"
                                        AutomationProperties.Name="Filter categories"
                                        SelectionChanged="FilterSections_SelectionChanged"
                                        SelectionMode="Single" />
                                    <Border Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid x:Name="FilterValuesPanel" Grid.Column="2" RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBox
                                            x:Name="FilterValueSearchBox" AutomationProperties.AutomationId="TicketsFilterValueSearchBox"
                                            AutomationProperties.Name="Search values"
                                            PlaceholderText="Search"
                                            TextChanged="FilterValueSearch_TextChanged" />
                                        <TextBlock
                                            x:Name="FilterNoValuesText"
                                            Grid.Row="1"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="No matching values"
                                            Visibility="Collapsed" />
                                        <ScrollViewer Grid.Row="2" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="FilterValuesList" Padding="0,0,12,0" />
                                        </ScrollViewer>
                                    </Grid>
                                    <StackPanel x:Name="FilterTimePeriodPanel" Grid.Column="2" Spacing="12" Visibility="Collapsed">
                                        <ComboBox
                                            x:Name="DateRangeBox" AutomationProperties.AutomationId="TicketsDateRangeBox"
                                            HorizontalAlignment="Stretch"
                                            DisplayMemberPath="Label"
                                            Header="Created"
                                            SelectionChanged="DateRange_SelectionChanged" />
                                        <CheckBox
                                            x:Name="ShowClosedBox" AutomationProperties.AutomationId="TicketsShowClosedBox"
                                            Content="Show Closed"
                                            IsChecked="{x:Bind ViewModel.ShowClosed, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    AutomationProperties.AutomationId="TicketsClearFilters" AutomationProperties.Name="Clear Filters"
                    Command="{x:Bind ViewModel.ClearAllFiltersCommand}"
                    Style="{StaticResource ToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="Clear Filters"
                    Visibility="{x:Bind ViewModel.ShowsClearAll, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE894;" />
                </Button>
                <ToggleButton
                    x:Name="AssignedToMeToggle" AutomationProperties.AutomationId="TicketsAssignedToMeToggle"
                    Height="32"
                    AutomationProperties.Name="Assigned to Me"
                    IsChecked="{x:Bind ViewModel.AssignedToMe, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.AssignedToMeEnabled, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.AssignedToMeToolTip, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE77B;" />
                        <TextBlock x:Name="AssignedToMeLabel" Text="Assigned to Me" />
                    </StackPanel>
                </ToggleButton>
                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.ShowsBoardControls, Mode=OneWay}">
                    <AppBarSeparator />
                    <ComboBox
                        x:Name="BoardGroupBox" AutomationProperties.AutomationId="TicketsBoardGroupBox"
                        MinWidth="140"
                        AutomationProperties.Name="Group board columns by"
                        ItemsSource="{x:Bind ViewModel.BoardGroupByOptions}"
                        SelectedItem="{x:Bind ViewModel.BoardGroupBy, Mode=TwoWay}"
                        ToolTipService.ToolTip="Group board columns by" />
                    <ComboBox
                        x:Name="SortBox" AutomationProperties.AutomationId="TicketsSortBox"
                        MinWidth="132"
                        AutomationProperties.Name="Sort by"
                        ItemsSource="{x:Bind ViewModel.SortFields}"
                        SelectedItem="{x:Bind ViewModel.SortField, Mode=TwoWay}"
                        ToolTipService.ToolTip="Sort by" />
                    <Button
                        AutomationProperties.AutomationId="TicketsSortDirection" AutomationProperties.Name="Sort direction"
                        AutomationProperties.ItemStatus="{x:Bind ViewModel.SortDirectionName, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleSortDirectionCommand}"
                        Style="{StaticResource ToolbarIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SortDirectionToolTip, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.SortDirectionGlyph, Mode=OneWay}" />
                    </Button>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="{x:Bind ViewModel.CountLabel, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.CountLabel, Mode=OneWay}" />
                <ToggleButton
                    x:Name="DetailsToggle" AutomationProperties.AutomationId="TicketsDetailsToggle"
                    Height="32"
                    AutomationProperties.Name="Details"
                    Click="DetailsToggle_Click"
                    ToolTipService.ToolTip="Show or hide the ticket details">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE89F;" />
                        <TextBlock x:Name="DetailsLabel" Text="Details" />
                    </StackPanel>
                </ToggleButton>
                <Button
                    Height="32"
                    AutomationProperties.AutomationId="TicketsRefresh" AutomationProperties.Name="Refresh"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    IsEnabled="{x:Bind ViewModel.RefreshEnabled, Mode=OneWay}"
                    ToolTipService.ToolTip="Refresh (Ctrl+R)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock x:Name="RefreshLabel" Text="Refresh" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--
            The widgets: six figures and five breakdowns, each a filter. Every
            breakdown counts the list with its own category's filter left out.
            Too narrow for one row, they wrap into two rows of three (FitWidgets).
        -->
        <ScrollViewer
            x:Name="WidgetsScroller"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <Grid x:Name="WidgetsGrid" Padding="0,0,0,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.3*" MinWidth="220" />
                    <ColumnDefinition Width="*" MinWidth="168" />
                    <ColumnDefinition Width="*" MinWidth="168" />
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="*" MinWidth="180" />
                </Grid.ColumnDefinitions>
                <Border Padding="6" Style="{StaticResource CardStyle}">
                    <ItemsRepeater x:Name="TilesRepeater" ItemsSource="{x:Bind ViewModel.Tiles, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MaximumRowsOrColumns="3"
                                MinColumnSpacing="4"
                                MinItemWidth="104"
                                MinRowSpacing="4"
                                Orientation="Horizontal" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="core:TicketWidgetTile">
                                <ToggleButton
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="8,4"
                                    AutomationProperties.Name="{x:Bind Description}"
                                    Click="Tile_Click"
                                    IsChecked="{x:Bind IsOn}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind Description}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="13" Glyph="{x:Bind Glyph}" />
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind Value}" />
                                        </StackPanel>
                                        <TextBlock MaxLines="1" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource ChartCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="By Status" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="96" Height="96" VerticalAlignment="Top">
                                <Canvas x:Name="DonutCanvas" Width="96" Height="96" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="DonutTotal" HorizontalAlignment="Center" FontSize="18" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="tickets" />
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="StatusLegend" Grid.Column="1" VerticalAlignment="Center" Spacing="1" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ChartCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="By Priority" />
                        <StackPanel x:Name="PriorityBars" Spacing="1" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource ChartCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="By Age" />
                        <StackPanel x:Name="AgeBars" Spacing="1" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource ChartCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="By Responsible" />
                        <StackPanel x:Name="ResponsibleBars" Spacing="1" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="5" Style="{StaticResource ChartCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="By Group" />
                        <StackPanel x:Name="GroupBars" Spacing="1" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- The list or the board, and the open ticket beside it. -->
        <Grid x:Name="ContentGrid" Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="*" />
                <ColumnDefinition x:Name="DetailColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ListCard" Padding="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Column headers sort, as on Mac; a second click flips the direction. -->
                    <Grid
                        x:Name="ListHeader"
                        Padding="16,6,16,6"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="{x:Bind Layout.PriorityWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.RequestorWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="{x:Bind Layout.ModifiedWidth, Mode=OneWay}" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <ListView
                        x:Name="TicketList" AutomationProperties.AutomationId="TicketsTicketList"
                        Grid.Row="1"
                        Padding="0,4"
                        AutomationProperties.Name="Tickets"
                        ItemTemplate="{StaticResource TicketRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.Rows}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        SelectionChanged="TicketList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="Margin" Value="4,0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>

            <ScrollViewer
                x:Name="BoardScroller"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                Visibility="Collapsed">
                <ItemsRepeater
                    x:Name="BoardRepeater"
                    Margin="0,0,0,12"
                    ItemTemplate="{StaticResource BoardBlockTemplate}"
                    ItemsSource="{x:Bind ViewModel.Blocks, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="16" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Over an empty list only: the launch sign-in's progress, or the first read. -->
            <StackPanel
                x:Name="LoadingPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.ShowsLoading, Mode=OneWay}">
                <ProgressRing x:Name="LoadingRing" Width="40" Height="40" IsActive="{x:Bind ViewModel.ShowsLoading, Mode=OneWay}" />
                <ProgressBar x:Name="LaunchProgressBar" Width="280" Maximum="1" Visibility="Collapsed" />
                <TextBlock
                    HorizontalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.LoadingText, Mode=OneWay}" />
            </StackPanel>

            <!-- Why nothing is listed: not signed in, a failed load, or filters that leave nothing. -->
            <Border x:Name="EmptyPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon x:Name="EmptyIcon" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="EmptyDescription" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Margin="0,8,0,0" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="EmptySignIn" AutomationProperties.AutomationId="TicketsEmptySignIn" Click="EmptySignIn_Click" Content="Sign In" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="EmptyRetry" AutomationProperties.AutomationId="TicketsEmptyRetry" Click="EmptyRetry_Click" Content="Try Again" />
                        <Button x:Name="EmptyShowAll" AutomationProperties.AutomationId="TicketsEmptyShowAll" Click="EmptyShowAll_Click" Content="Show All Tickets" />
                        <Button x:Name="EmptyClearFilters" AutomationProperties.AutomationId="TicketsEmptyClearFilters" Command="{x:Bind ViewModel.ClearAllFiltersCommand}" Content="Clear Filters" />
                        <Button x:Name="EmptyShowClosed" AutomationProperties.AutomationId="TicketsEmptyShowClosed" Click="EmptyShowClosed_Click" Content="Show Closed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The open ticket. -->
            <Border x:Name="DetailCard" Grid.Column="1" Padding="0" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="12,10,12,6" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            AutomationProperties.AutomationId="TicketsCloseTheTicket" AutomationProperties.Name="Close the ticket"
                            Click="CloseDetail_Click"
                            Style="{StaticResource TitleBarIconButtonStyle}"
                            ToolTipService.ToolTip="Close the ticket (Esc)">
                            <FontIcon FontSize="12" Glyph="&#xE76C;" />
                        </Button>
                        <Button
                            Grid.Column="1"
                            Padding="6,2"
                            AutomationProperties.AutomationId="TicketsCopyTheTicketNumber" AutomationProperties.Name="Copy the ticket number"
                            Click="CopyNumber_Click"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Copy the ticket number">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Detail.IdLabel, Mode=OneWay}" />
                        </Button>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                            <Button AutomationProperties.AutomationId="TicketsCopyLink" AutomationProperties.Name="Copy link" Click="CopyLink_Click" Style="{StaticResource TitleBarIconButtonStyle}" ToolTipService.ToolTip="Copy link">
                                <FontIcon FontSize="14" Glyph="&#xE71B;" />
                            </Button>
                            <Button AutomationProperties.AutomationId="TicketsOpenInBrowser" AutomationProperties.Name="Open in browser" Click="OpenInBrowser_Click" Style="{StaticResource TitleBarIconButtonStyle}" ToolTipService.ToolTip="Open in browser">
                                <FontIcon FontSize="14" Glyph="&#xE774;" />
                            </Button>
                            <Button AutomationProperties.AutomationId="TicketsRefreshTheTicket" AutomationProperties.Name="Refresh the ticket" Click="RefreshDetail_Click" Style="{StaticResource TitleBarIconButtonStyle}" ToolTipService.ToolTip="Refresh the ticket">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,4,16,20" Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Detail.Eyebrow, Mode=OneWay}" />
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level2"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="{x:Bind Detail.Title, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <InfoBar x:Name="ActionInfo" IsClosable="True" />

                            <!-- Fields, as on the Mac: two equal columns. -->
                            <Grid ColumnSpacing="24" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Status" />
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="8" Height="8" Fill="{x:Bind Detail.StatusBrush, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource FieldValueStyle}" Margin="0" Text="{x:Bind Detail.Status, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Requestor" />
                                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource FieldValueStyle}" Text="{x:Bind Detail.Requestor, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Priority" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{x:Bind Detail.Priority, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Email" />
                                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource FieldValueStyle}" Text="{x:Bind Detail.RequestorEmail, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Classification" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{x:Bind Detail.Classification, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Group" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{x:Bind Detail.Group, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Form" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{x:Bind Detail.Form, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Responsible" />
                                    <TextBlock Foreground="{x:Bind Detail.ResponsibleForeground, Mode=OneWay}" Style="{StaticResource FieldValueStyle}" Text="{x:Bind Detail.Responsible, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="4">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Service" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{x:Bind Detail.Service, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="1">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Created" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{x:Bind Detail.Created, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="5">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Type" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{x:Bind Detail.Type, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="5" Grid.Column="1">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Modified" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{x:Bind Detail.Modified, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="6">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="SLA" />
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE7BA;" Visibility="{x:Bind Detail.SlaVisibility, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource FieldValueStyle}" Margin="0" Text="{x:Bind Detail.Sla, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="6" Grid.Column="1" Visibility="{x:Bind Detail.ParentVisibility, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Parent" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{x:Bind Detail.Parent, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Detail.Parent, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>

                            <Border
                                Padding="14,12"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource CardHeaderTextStyle}" Margin="0" Text="Description" />
                                        <Button
                                            HorizontalAlignment="Right"
                                            AutomationProperties.AutomationId="TicketsCopyTheDescription" AutomationProperties.Name="Copy the description"
                                            Click="CopyDescription_Click"
                                            Style="{StaticResource TitleBarIconButtonStyle}"
                                            ToolTipService.ToolTip="Copy the description">
                                            <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                        </Button>
                                    </Grid>
                                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Detail.Description, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind Detail.DescriptionVisibility, Mode=OneWay}" />
                                    <TextBlock FontStyle="Italic" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="No description" Visibility="{x:Bind Detail.NoDescriptionVisibility, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Detail.FeedHeader, Mode=OneWay}" />
                                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind Detail.IsLoadingFeed, Mode=OneWay}" />
                                    </StackPanel>
                                    <SelectorBar x:Name="FeedFilterBar" AutomationProperties.AutomationId="TicketsFeedFilterBar" Grid.Column="1" AutomationProperties.Name="Show" SelectionChanged="FeedFilter_SelectionChanged">
                                        <SelectorBarItem IsSelected="True" Tag="Comments" Text="Comments" />
                                        <SelectorBarItem Tag="Activity" Text="Activity" />
                                        <SelectorBarItem Tag="All" Text="All" />
                                    </SelectorBar>
                                </Grid>
                                <ItemsRepeater ItemTemplate="{StaticResource FeedItemTemplate}" ItemsSource="{x:Bind Detail.Feed, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="12" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
