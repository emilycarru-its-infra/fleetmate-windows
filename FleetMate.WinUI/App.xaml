<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FleetMate.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Chart series colours: the eight-slot categorical order, stepped
                separately for light and dark surfaces. A status keeps its slot,
                so the donut, the list pill and the board column always agree.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Series1Brush" Color="#2A78D6" />
                    <SolidColorBrush x:Key="Series2Brush" Color="#EB6834" />
                    <SolidColorBrush x:Key="Series3Brush" Color="#1BAF7A" />
                    <SolidColorBrush x:Key="Series4Brush" Color="#EDA100" />
                    <SolidColorBrush x:Key="Series5Brush" Color="#E87BA4" />
                    <SolidColorBrush x:Key="Series6Brush" Color="#008300" />
                    <SolidColorBrush x:Key="Series7Brush" Color="#6250D6" />
                    <SolidColorBrush x:Key="Series8Brush" Color="#E34948" />
                    <SolidColorBrush x:Key="BarTrackBrush" Color="#0F000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Series1Brush" Color="#3987E5" />
                    <SolidColorBrush x:Key="Series2Brush" Color="#D95926" />
                    <SolidColorBrush x:Key="Series3Brush" Color="#199E70" />
                    <SolidColorBrush x:Key="Series4Brush" Color="#C98500" />
                    <SolidColorBrush x:Key="Series5Brush" Color="#D55181" />
                    <SolidColorBrush x:Key="Series6Brush" Color="#008300" />
                    <SolidColorBrush x:Key="Series7Brush" Color="#9085E9" />
                    <SolidColorBrush x:Key="Series8Brush" Color="#E66767" />
                    <SolidColorBrush x:Key="BarTrackBrush" Color="#18FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="Series1Brush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="Series2Brush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="Series3Brush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="Series4Brush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="Series5Brush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="Series6Brush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="Series7Brush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="Series8Brush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="BarTrackBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="CardHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="FieldValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>

            <Style x:Key="TitleBarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
