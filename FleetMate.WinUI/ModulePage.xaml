<Page
    x:Class="FleetMate.WinUI.ModulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="40" MaxWidth="1180" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="PageSummary" Text="Loading brokered service data…" Opacity="0.65" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Refresh" Click="OnRefreshClicked" />
        </Grid>
        <InfoBar x:Name="ErrorBar" Grid.Row="2" Severity="Error" IsOpen="False" Title="Couldn’t load this service" />
        <ProgressRing x:Name="Busy" Grid.Row="2" IsActive="True" HorizontalAlignment="Left" />
        <ListView x:Name="Rows" Grid.Row="4" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="16" Margin="0,0,0,8" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Subtitle}" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Detail}" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
