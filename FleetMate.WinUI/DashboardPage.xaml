<Page
    x:Class="FleetMate.WinUI.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid Padding="40" MaxWidth="1180" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Fleet overview across all connected systems" Opacity="0.65" />
            </StackPanel>
            <Border Grid.Row="2" Padding="32" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel x:Name="ServiceStatus" HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE968;" FontSize="32" />
                    <TextBlock x:Name="StatusTitle" Text="Connecting to your services…" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="StatusDetail" Text="FleetMate uses your Windows broker session; local secrets are never loaded by the desktop app." Opacity="0.65" />
                </StackPanel>
            </Border>
            <Grid Grid.Row="4" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8"><TextBlock Text="My pull requests" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="Loading…" Opacity="0.65" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8"><TextBlock Text="Recent activity" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="Loading…" Opacity="0.65" /></StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
