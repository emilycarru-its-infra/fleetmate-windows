<Page
    x:Class="FleetMate.WinUI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="40" MaxWidth="960" HorizontalAlignment="Center">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Configure FleetMate" Opacity="0.65" />
        </StackPanel>
        <TabView Grid.Row="2" IsAddTabButtonVisible="False">
            <TabViewItem Header="General" IsClosable="False">
                <StackPanel Padding="4,20" Spacing="12">
                    <TextBlock Text="Desktop configuration is stored in HKCU\SOFTWARE\FleetMate." TextWrapping="Wrap" />
                    <InfoBar IsOpen="True" Severity="Informational" Title="Brokered identity only"
                             Message="The desktop app ignores API keys, passwords, passphrases, and config-file tokens." />
                </StackPanel>
            </TabViewItem>
            <TabViewItem Header="Authentication" IsClosable="False">
                <StackPanel Padding="4,20" Spacing="16">
                    <TextBlock Text="Service endpoints" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBox x:Name="TenantId" Header="Microsoft Graph tenant ID" />
                        <TextBox x:Name="ClientId" Grid.Column="1" Header="Microsoft Graph client ID" />
                        <TextBox x:Name="DevOpsOrganization" Grid.Row="1" Header="Azure DevOps organization" />
                        <TextBox x:Name="DevOpsProject" Grid.Row="1" Grid.Column="1" Header="Azure DevOps project" />
                        <TextBox x:Name="SnipeUrl" Grid.Row="2" Header="Snipe-IT base URL" />
                        <TextBox x:Name="TdxUrl" Grid.Row="2" Grid.Column="1" Header="TeamDynamix base URL" />
                        <TextBox x:Name="ReportMateUrl" Grid.Row="3" Header="ReportMate base URL" />
                        <TextBox x:Name="TdxAppId" Grid.Row="3" Grid.Column="1" Header="TeamDynamix ticketing app ID" />
                        <TextBox x:Name="ElevationResourceGroup" Grid.Row="4" Header="Elevation resource group" />
                        <TextBox x:Name="ElevationImage" Grid.Row="4" Grid.Column="1" Header="Elevation container image" />
                        <TextBox x:Name="ElevationTranscript" Grid.Row="5" Header="Elevation transcript account" />
                        <TextBox x:Name="ElevationIdentityPrefix" Grid.Row="5" Grid.Column="1" Header="Managed identity prefix" />
                    </Grid>
                    <Button Content="Save and apply" HorizontalAlignment="Right" Click="OnSaveClicked" />
                    <Button Content="Sign in to TeamDynamix" HorizontalAlignment="Left" Click="OnTdxSignInClicked" />
                    <TextBlock x:Name="TdxSignInStatus" Text="Uses the persistent Windows browser profile; no password or API token is stored by FleetMate." Opacity="0.65" TextWrapping="Wrap" />
                    <InfoBar x:Name="SaveResult" IsOpen="False" />
                </StackPanel>
            </TabViewItem>
            <TabViewItem Header="Appearance" IsClosable="False">
                <StackPanel Padding="4,20" Spacing="12">
                    <TextBlock Text="Theme" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox x:Name="ThemePicker" Header="Application theme" SelectionChanged="OnThemeChanged">
                        <ComboBoxItem Content="Use system setting" Tag="System" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </StackPanel>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
