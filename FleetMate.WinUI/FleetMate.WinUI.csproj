<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The WinUI 3 FleetMate shell, growing beside FleetMate.GUI (WPF) until it
    matches it. Unpackaged and self-contained, like the WPF app, so the MSI
    installers keep their shape. Program.cs owns Main: the single-instance
    hand-off runs before any XAML starts.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FleetMate.WinUI</RootNamespace>
    <AssemblyName>FleetMate.WinUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FleetMate.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Unpackaged, but the PRI index and compiled XAML (.xbf) still have to
         reach the publish folder; without this, publish leaves them out and
         the window fails to load its XAML. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- Edition: FleetMate by default; -p:Edition=TicketsMate builds the Tickets-only
       app as TicketsMate.exe. Same switch as FleetMate.GUI, read at run time by
       FleetMate.Core/Config/AppEdition.cs. -->
  <PropertyGroup>
    <Edition Condition="'$(Edition)' == ''">FleetMate</Edition>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Edition)' == 'TicketsMate'">
    <AssemblyName>TicketsMate</AssemblyName>
    <AssemblyTitle>TicketsMate</AssemblyTitle>
    <AssemblyProduct>TicketsMate</AssemblyProduct>
    <ApplicationIcon>Assets\TicketsMate.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(Edition)' == 'TicketsMate'">
    <AssemblyMetadata Include="FleetMateEdition" Value="TicketsMate" />
  </ItemGroup>
  <Target Name="CheckEdition" BeforeTargets="Build">
    <Error Condition="'$(Edition)' != 'FleetMate' And '$(Edition)' != 'TicketsMate'" Text="Edition must be FleetMate or TicketsMate, not '$(Edition)'." />
  </Target>

  <!-- Signs our own exe and DLLs after every build when a code-signing
       certificate is installed, so the dev build runs where unsigned
       executables are blocked. No certificate: it skips and the build
       succeeds. Opt out with -p:SignDevBuild=false. -->
  <Target Name="SignDevBuild" AfterTargets="Build" Condition="'$(SignDevBuild)' != 'false' And '$(OS)' == 'Windows_NT'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Sign-DevBuild.ps1&quot; -Directory &quot;$(TargetDir.TrimEnd('\'))&quot; -Files $(TargetName).exe,$(TargetName).dll,FleetMate.Core.dll" />
  </Target>

  <ItemGroup>
    <None Remove="Sign-DevBuild.ps1" />
    <Content Include="Assets\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" Version="0.8.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FleetMate.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FleetMate.Core\FleetMate.Core.csproj" />
  </ItemGroup>
</Project>
