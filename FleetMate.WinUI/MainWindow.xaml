<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FleetMate.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FleetMate">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!--
            The window's toolbar, laid out as FleetMate for Mac's: history on
            the left, the search field in the middle, the tab's own controls
            and then Recent Activity and Authentication on the right. The tabs
            follow in the bar beneath, in the Mac app's order.
        -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="FleetMate"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.LeftHeader>
                <StackPanel Margin="4,0,0,0" Orientation="Horizontal">
                    <Button
                        x:Name="BackButton"
                        AutomationProperties.Name="Back"
                        Click="BackButton_Click"
                        IsEnabled="False"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        ToolTipService.ToolTip="Back (Alt+Left)">
                        <FontIcon FontSize="14" Glyph="&#xE72B;" />
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Left" Modifiers="Menu" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button
                        x:Name="ForwardButton"
                        AutomationProperties.Name="Forward"
                        Click="ForwardButton_Click"
                        IsEnabled="False"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        ToolTipService.ToolTip="Forward (Alt+Right)">
                        <FontIcon FontSize="14" Glyph="&#xE72A;" />
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Right" Modifiers="Menu" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
            </TitleBar.LeftHeader>

            <AutoSuggestBox
                x:Name="SearchBox"
                MinWidth="320"
                MaxWidth="480"
                VerticalAlignment="Center"
                AutomationProperties.Name="Search"
                PlaceholderText="Search  (Ctrl+F)"
                QueryIcon="Find"
                QuerySubmitted="SearchBox_QuerySubmitted"
                SuggestionChosen="SearchBox_SuggestionChosen"
                TextChanged="SearchBox_TextChanged"
                UpdateTextOnSelect="False" />

            <TitleBar.RightHeader>
                <StackPanel
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <!-- The Tickets tab's own controls; hidden on every other tab. -->
                    <StackPanel
                        x:Name="TicketsTools"
                        Orientation="Horizontal"
                        Spacing="4"
                        Visibility="Collapsed">
                        <SelectorBar
                            x:Name="ViewModeBar"
                            AutomationProperties.Name="View mode"
                            SelectionChanged="ViewModeBar_SelectionChanged">
                            <SelectorBarItem IsSelected="True" Tag="list" Text="List">
                                <SelectorBarItem.Icon>
                                    <FontIcon Glyph="&#xE8FD;" />
                                </SelectorBarItem.Icon>
                            </SelectorBarItem>
                            <SelectorBarItem Tag="board" Text="Board">
                                <SelectorBarItem.Icon>
                                    <FontIcon Glyph="&#xF0E2;" />
                                </SelectorBarItem.Icon>
                            </SelectorBarItem>
                        </SelectorBar>
                        <AppBarSeparator />
                    </StackPanel>
                    <!-- Demo mode: fictional data, no services. Shown so a screenshot says so. -->
                    <Border
                        x:Name="DemoBadge"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Visibility="Collapsed">
                        <TextBlock
                            AutomationProperties.Name="Demo data"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Demo data" />
                    </Border>
                    <!-- The tab's graphs, shown or hidden per tab, as on FleetMate for Mac. -->
                    <ToggleButton
                        x:Name="GraphsButton"
                        Padding="10,6"
                        AutomationProperties.AutomationId="ToolbarGraphsButton"
                        AutomationProperties.Name="Graphs"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="GraphsButton_Click"
                        ToolTipService.ToolTip="Show or hide this tab's graphs"
                        Visibility="Collapsed">
                        <FontIcon FontSize="16" Glyph="&#xE9D2;" />
                    </ToggleButton>
                    <Button
                        x:Name="RecentActivityButton"
                        AutomationProperties.Name="Recent Activity"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        ToolTipService.ToolTip="Recent Activity">
                        <Grid>
                            <FontIcon FontSize="16" Glyph="&#xE81C;" />
                            <InfoBadge
                                x:Name="AppErrorBadge"
                                Margin="0,-6,-6,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Style="{ThemeResource AttentionDotInfoBadgeStyle}"
                                Visibility="Collapsed" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout x:Name="RecentActivityFlyout" Opening="RecentActivityFlyout_Opening">
                                <StackPanel MinWidth="300" MaxWidth="420" Spacing="8">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Recent Activity" />
                                    <InfoBar
                                        x:Name="AppErrorInfo"
                                        IsClosable="True"
                                        Severity="Error"
                                        Title="Something went wrong"
                                        CloseButtonClick="AppErrorInfo_CloseButtonClick" />
                                    <TextBlock
                                        x:Name="NoActivityText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Nothing recent."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="AuthButton"
                        AutomationProperties.Name="Authentication"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        ToolTipService.ToolTip="Authentication">
                        <FontIcon x:Name="AuthGlyph" FontSize="16" Glyph="&#xEA18;" />
                        <Button.Flyout>
                            <Flyout Opening="AuthFlyout_Opening">
                                <StackPanel MinWidth="320" MaxWidth="480" Spacing="8">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Authentication" />
                                    <ItemsControl x:Name="AuthList" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- Over Tickets, and over the whole of TicketsMate, when TeamDynamix needs signing in. -->
        <InfoBar
            x:Name="SignInBanner"
            Grid.Row="1"
            Margin="12,4,12,0"
            IsClosable="False"
            Severity="Warning"
            Title="Sign in to TeamDynamix">
            <InfoBar.ActionButton>
                <Button x:Name="SignInButton" Click="SignInButton_Click" Content="Sign In" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- A fleetmate: link that could not be opened. -->
        <InfoBar
            x:Name="LinkBanner"
            Grid.Row="2"
            Margin="12,4,12,0"
            IsClosable="True"
            Severity="Informational" />

        <NavigationView
            x:Name="NavView"
            Grid.Row="3"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Top"
            SelectionChanged="NavView_SelectionChanged">
            <Frame x:Name="NavFrame" Navigated="NavFrame_Navigated" />
        </NavigationView>
    </Grid>
</Window>
