<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FleetMate.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FleetMate">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Title bar and toolbar in one row, as the Store app does. -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="FleetMate"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.LeftHeader>
                <StackPanel Orientation="Horizontal" Spacing="0" Margin="4,0,0,0">
                    <Button
                        x:Name="BackButton"
                        AutomationProperties.Name="Back"
                        Click="BackButton_Click"
                        IsEnabled="False"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        ToolTipService.ToolTip="Back (Alt+Left)">
                        <FontIcon FontSize="14" Glyph="&#xE72B;" />
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Left" Modifiers="Menu" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button
                        x:Name="ForwardButton"
                        AutomationProperties.Name="Forward"
                        Click="ForwardButton_Click"
                        IsEnabled="False"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        ToolTipService.ToolTip="Forward (Alt+Right)">
                        <FontIcon FontSize="14" Glyph="&#xE72A;" />
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Right" Modifiers="Menu" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
            </TitleBar.LeftHeader>

            <AutoSuggestBox
                x:Name="SearchBox"
                MinWidth="320"
                MaxWidth="480"
                VerticalAlignment="Center"
                AutomationProperties.Name="Search"
                PlaceholderText="Search tickets  (Ctrl+F)"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />

            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Center">
                    <SelectorBar
                        x:Name="ViewModeBar"
                        AutomationProperties.Name="View mode"
                        SelectionChanged="ViewModeBar_SelectionChanged">
                        <SelectorBarItem IsSelected="True" Tag="list" Text="List">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE8FD;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem Tag="board" Text="Board">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xF0E2;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>
                    <AppBarSeparator />
                    <Button AutomationProperties.Name="Filter" Style="{StaticResource TitleBarIconButtonStyle}" ToolTipService.ToolTip="Filter">
                        <FontIcon FontSize="16" Glyph="&#xE71C;" />
                    </Button>
                    <Button AutomationProperties.Name="Refresh" Style="{StaticResource TitleBarIconButtonStyle}" ToolTipService.ToolTip="Refresh (F5)">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                    </Button>
                    <Button AutomationProperties.Name="New ticket" Style="{StaticResource TitleBarIconButtonStyle}" ToolTipService.ToolTip="New ticket (Ctrl+N)">
                        <FontIcon FontSize="16" Glyph="&#xE710;" />
                    </Button>
                    <PersonPicture Width="28" Height="28" Margin="6,0,0,0" Initials="FM" AutomationProperties.Name="Account" />
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Devices" Tag="Devices">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F8;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Identity" Tag="Identity">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Inventory" Tag="Inventory">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7B8;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="TicketsItem" Content="Tickets" Tag="Tickets">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8C3;" /></NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="TicketsBadge" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Projects" Tag="Projects">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Knowledge" Tag="Knowledge">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE82D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Reporting" Tag="Reporting">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Manage" Tag="Manage">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Development" Tag="Development">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE943;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Terminal" Tag="Terminal">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE756;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="NavFrame" Navigated="NavFrame_Navigated" />
        </NavigationView>
    </Grid>
</Window>
